<script>
  // ギャラリーライトボックス
  const data = document.getElementById("pd-gallery-data");
  const images: string[] = data ? JSON.parse(data.textContent || "[]") : [];
  const lb = document.getElementById("pd-lightbox") as HTMLElement | null;
  const lbImg = lb?.querySelector(".lb-img") as HTMLImageElement | null;
  const lbCounter = lb?.querySelector(".lb-counter") as HTMLElement | null;
  let idx = 0;

  function render() {
    if (!lbImg || !lbCounter) return;
    lbImg.src = images[idx] ?? "";
    lbCounter.textContent = `${idx + 1} / ${images.length}`;
  }
  function open(i: number) {
    if (!lb || !images.length) return;
    idx = i;
    render();
    lb.hidden = false;
    document.body.style.overflow = "hidden";
  }
  function close() {
    if (!lb) return;
    lb.hidden = true;
    document.body.style.overflow = "";
  }
  const prev = () => {
    idx = (idx - 1 + images.length) % images.length;
    render();
  };
  const next = () => {
    idx = (idx + 1) % images.length;
    render();
  };

  document.querySelectorAll<HTMLElement>(".js-pd-gallery").forEach((el) => {
    el.addEventListener("click", () => open(Number(el.dataset.index || 0)));
  });
  lb?.querySelector(".lb-close")?.addEventListener("click", close);
  lb?.querySelector(".lb-prev")?.addEventListener("click", prev);
  lb?.querySelector(".lb-next")?.addEventListener("click", next);
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lb?.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") prev();
    if (e.key === "ArrowRight") next();
  });
</script>
