---
/* 物件詳細ページ（Kiyokawa / Takasago 共通）— B7
   kiyokawaData / takasagoData の実コンテンツを Home のデザイン文法で表示:
   ヒーロー → 概要+評価バッジ → 説明(折りたたみ) → アメニティ → (フロアプラン)
   → アクセス → チェックイン/条件/ハウスルール → Beds24 → ギャラリー+ライトボックス → FAQ */
import type { Locale } from "../i18n/config";
import { localizedPath } from "../i18n/config";
import { lucide, starRating } from "../lib/lucide";
import { PROPERTIES, GALLERIES, type Property } from "../data/properties";
import { uiStrings } from "../i18n/uiStrings";
import { nearbyData } from "../data/nearbyData";
import { PROPERTY_GEO } from "../lib/seo";
import { getPropertyFacts } from "../lib/propertyFacts";
import { makeFill } from "../lib/factText";
import PressSection from "./PressSection.astro";

// 地図ラベル（各言語）
const MAP_LABEL: Record<Locale, string> = { ja: "地図", en: "Map", ko: "지도", zh: "地圖", th: "แผนที่" };

// kiyokawaData / takasagoData は構造が同一（KiyokawaTranslations 相当）
interface Props {
  lang: Locale;
  propertyKey: Property["key"];
  data: any; // Record<Lang, KiyokawaTranslations> の1言語分
  heroImage: string;
  floorPlanImage?: string;
}
const { lang, propertyKey, data: d, heroImage, floorPlanImage } = Astro.props;
const p = PROPERTIES[propertyKey];
// 評価・件数の単一ソースは property_facts（/admin/properties）。
// 以前は言語別データに直書きしており、管理画面を更新してもここだけ古い値が残っていた。
const { facts } = await getPropertyFacts();
const pf = facts[propertyKey];
const gallery = GALLERIES[propertyKey];
const ui = uiStrings[lang];
// GEO: 周辺スポット距離表（表形式はAI引用の抽出率が最も高い）
const nearby = nearbyData[lang];

const thumb = (src: string) => src.replace(/\.webp$/, "-480.webp");

// 直販導線（/book/ へ棟指定で遷移）。プレビュー時のみ表示し、本番は従来のOTAボタン。
const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";
const bookHref = `${localizedPath(lang, "/book")}?prop=${propertyKey}`;
const DIRECT = {
  en: { note: "Booking direct on our site is the best rate.", cta: "Check availability & book", priceFrom: "From {v} / night", decide: ["Check availability and the all-in total right here.", "Cleaning fee and lodging tax are included in the price shown. Nothing to pay on arrival.", "Free cancellation until {d} days before check-in.", "Secure card payment handled by Stripe. We never store your card details.", "Questions before booking? We reply within 24 hours."] },
  ja: { note: "公式サイトからの直接予約がお得です。", cta: "空室を見て予約する", priceFrom: "{v}〜 / 泊", decide: ["空室と総額を、この場でご確認いただけます。", "表示総額に清掃料・宿泊税を含みます。現地でのお支払いはありません。", "無料キャンセルは、チェックイン日の{d}日前まで。", "安全なカード決済。処理は Stripe が行い、カード情報を当社は保存しません。", "ご予約前のご質問には、24時間以内に返信します。"] },
  ko: { note: "공식 사이트에서 직접 예약하시는 것이 가장 저렴합니다.", cta: "예약 가능일 보고 예약하기", priceFrom: "{v}〜 / 1박", decide: ["빈방과 총액을 이 자리에서 확인하실 수 있습니다.", "표시 금액에 청소비·숙박세가 포함됩니다. 현장에서 지불하실 금액은 없습니다.", "무료 취소는 체크인 {d}일 전까지 가능합니다.", "안전한 카드 결제. 결제는 Stripe가 처리하며 카드 정보는 보관하지 않습니다.", "예약 전 문의에는 24시간 이내에 답변드립니다."] },
  zh: { note: "透過官網直接預訂最為優惠。", cta: "查詢空房並預訂", priceFrom: "{v} 起 / 晚", decide: ["可在此直接確認空房與總金額。", "顯示金額已含清潔費與住宿稅，現場無需再付款。", "入住日 {d} 天前可免費取消。", "安全的信用卡付款，由 Stripe 處理，本公司不會保存卡片資料。", "預訂前的疑問，我們會在 24 小時內回覆。"] },
  th: { note: "การจองผ่านเว็บไซต์ทางการของเราคุ้มค่าที่สุด", cta: "ดูห้องว่างและจอง", priceFrom: "เริ่มต้น {v} / คืน", decide: ["ตรวจสอบห้องว่างและราคารวมได้ที่นี่", "ราคาที่แสดงรวมค่าทำความสะอาดและภาษีที่พักแล้ว ไม่มีค่าใช้จ่ายเพิ่มเมื่อเดินทางถึง", "ยกเลิกฟรีได้ถึง {d} วันก่อนวันเช็คอิน", "ชำระด้วยบัตรอย่างปลอดภัยผ่าน Stripe เราไม่จัดเก็บข้อมูลบัตรของท่าน", "มีคำถามก่อนจอง? เราตอบภายใน 24 ชั่วโมง"] },
}[lang];

// 言語別テキストの {ci}/{co}/{cap} に SSoT の値を差し込む（lib/factText.ts）
const fill = makeFill(pf, lang);

const hero480 = thumb(heroImage);
const hero768 = heroImage.replace(/\.webp$/, "-768.webp");

// FAQPage JSON-LD（物件別）
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (d.faq?.items ?? []).map((item: { q: string; a: string }) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const overviewCards = [
  { label: d.ui.overviewLabels.bedrooms, value: d.overview.bedrooms },
  { label: d.ui.overviewLabels.beds, value: d.overview.beds },
  { label: d.ui.overviewLabels.maxGuests, value: d.overview.maxGuests },
  { label: d.ui.overviewLabels.area, value: d.overview.area },
];

const descLists: { title: string; items: string[] }[] = [
  d.propertyDescription.bedroomGuide,
  d.propertyDescription.facilityGuide,
  d.propertyDescription.equipment,
  d.propertyDescription.amenitiesDetail,
  d.propertyDescription.otherNotes,
];

const conditionRows: string[] = [
  d.conditions.cancellation,
  d.conditions.cleaningFee,
  d.conditions.extraGuest,
  d.conditions.noiseRule,
  d.conditions.petRule,
  d.conditions.smokingRule,
].filter(Boolean);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<!-- Hero -->
<section class="pd-hero">
  <img
    src={heroImage}
    srcset={`${hero480} 480w, ${hero768} 768w, ${heroImage} 1280w`}
    sizes="100vw"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    width="1280"
    height="853"
    class="pd-hero-bg"
  />
  <div class="pd-hero-grad" aria-hidden="true"></div>
  <!-- LCP対策: 見出しは即時描画 -->
  <div class="pd-hero-content">
    <p class="pd-area">{d.hero.area}</p>
    <h1 class="pd-name">{d.hero.propertyName}</h1>
    <p class="pd-tagline">{d.hero.tagline}</p>
    <p class="pd-capacity">{fill(d.hero.capacity)}</p>
    <!-- 2026-08-08: Beds24 iframe撤去に伴い、ヒーローCTAはAirbnb直行に（右上Book Nowと同方針） -->
    <div class="pd-hero-ctas">
      {BOOK_PREVIEW && <p class="pd-price-from" id="pd-price-from" hidden></p>}
      {BOOK_PREVIEW && (
        <a href={bookHref} class="pd-cta-direct" data-cta-location="property_detail_hero_direct">{DIRECT.cta}</a>
      )}
    </div>
    {BOOK_PREVIEW && (
      // 予約判断カード（計画書§4）。CTA直前の迷いは価格だけでなく
      // 「安全か・取り消せるか・誰かに聞けるか」なので、その不確実性を先に消す。
      // 無料取消の日数は SSoT（property_facts）から。ここで日付を出さないのは、
      // 宿泊日が未確定の段階で日付を示すと誤解を招くため（日付は日程確定後に表示）。
      <ul class="pd-decide">
        {DIRECT.decide.map((line) => (
          <li>{line.replace("{d}", String(pf.freeCancelDays))}</li>
        ))}
      </ul>
    )}
  </div>
</section>

<!-- Meta ViewContent。予約機能の公開可否とは無関係なので BOOK_PREVIEW ゲートの外に置く
     （物件への興味＝リターゲティングの母集団は、直販公開前から溜める価値がある） -->
<script is:inline define:vars={{ propertyKey }}>
  window.fbq?.("track", "ViewContent", {
    content_ids: [`stay_${propertyKey}`],
    content_type: "product",
    content_name: `yah.homes ${propertyKey}`,
    content_category: "whole_house_stay",
    currency: "JPY",
    property_id: propertyKey,
  });
</script>

{BOOK_PREVIEW && (
  <script is:inline define:vars={{ propertyKey, priceFromLabel: DIRECT.priceFrom }}>
    // 価格の目安。/book と同じ空室カレンダーAPI（Beds24 のデイリー料金）から
    // 向こう13ヶ月の空室日の最安値を出す＝実売価格からの自動導出で、手動管理を作らない
    (async () => {
      try {
        const j = await fetch(`https://bookingapi-gpjsgjko3a-an.a.run.app/?props=${propertyKey === "test" ? "test" : propertyKey}`).then((r) => r.json());
        const p = (j.properties ?? [])[0];
        if (!p?.prices) return;
        const vals = Object.entries(p.prices).filter(([d]) => p.dates?.[d] === true).map(([, v]) => v);
        if (!vals.length) return;
        const el = document.getElementById("pd-price-from");
        el.textContent = priceFromLabel.replace("{v}", `¥${Math.min(...vals).toLocaleString("en-US")}`);
        el.hidden = false;
      } catch { /* 出せなければ黙って出さない */ }
    })();
  </script>
)}

<!-- Overview + Review badge -->
<section class="pd-section">
  <div class="pd-container">
    <div class="pd-overview">
      {
        overviewCards.map((c) => (
          <div class="ov-card">
            <p class="ov-value">{c.value}</p>
            <p class="ov-label">{c.label}</p>
          </div>
        ))
      }
    </div>

    <a href={p.airbnbUrl} target="_blank" rel="noopener noreferrer" class="pd-review" data-cta-location="property_detail">
      <Fragment set:html={starRating(Number(pf.rating), 14, `pd-${propertyKey}`)} />
      <span class="pd-review-num">{pf.rating}</span>
      <span class="pd-review-count">{d.review.count.replace('{n}', pf.reviewCount)}</span>
      <span class="pd-review-tag">{d.review.superhostLabel}</span>
      <span class="pd-review-tag">{d.review.airbnbLabel}</span>
    </a>
  </div>
</section>

<!-- Description -->
<section class="pd-section">
  <div class="pd-container narrow">
    <h2 class="pd-h2">{d.propertyDescription.title}</h2>
    <p class="pd-body" style="white-space:pre-line;">{d.propertyDescription.intro}</p>

    {
      d.propertyDescription.highlights.map((h: { title: string; body: string }) => (
        <div style="margin-top:1.75rem;">
          <h3 class="pd-h3">{h.title}</h3>
          <p class="pd-body" style="white-space:pre-line;">{h.body}</p>
        </div>
      ))
    }

    <details class="pd-more">
      <summary>{d.propertyDescription.showMore}</summary>
      <div>
        {
          descLists.map((sec) => (
            <div style="margin-top:1.75rem;">
              <h3 class="pd-h3">{sec.title}</h3>
              <ul class="pd-list">
                {sec.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))
        }
        <div style="margin-top:1.75rem;">
          <h3 class="pd-h3">{d.propertyDescription.guestAccess.title}</h3>
          <p class="pd-body" style="white-space:pre-line;">{d.propertyDescription.guestAccess.body}</p>
        </div>
        <div style="margin-top:1.75rem;">
          <h3 class="pd-h3">{d.propertyDescription.registration.title}</h3>
          <p class="pd-body">{d.propertyDescription.registration.body}</p>
        </div>
      </div>
    </details>
  </div>
</section>

<!-- Amenities -->
<section class="pd-section alt">
  <div class="pd-container">
    <h2 class="pd-h2">{d.amenityCategories.title}</h2>
    <div class="am-grid">
      {
        d.amenityCategories.categories.map(
          (cat: { name: string; items: { label: string; note?: string; unavailable?: boolean }[] }) => (
            <div class="am-cat">
              <h3 class="am-cat-name">{cat.name}</h3>
              <ul class="am-items">
                {cat.items.map((item) => (
                  <li class="am-item" data-off={item.unavailable ? "true" : undefined}>
                    <span class="am-icon" aria-hidden="true">
                      <Fragment set:html={lucide(item.unavailable ? "x" : "check", { size: 14, strokeWidth: 2 })} />
                    </span>
                    <span>
                      {item.label}
                      {item.note && <span class="am-note"> — {item.note}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )
        )
      }
    </div>
  </div>
</section>

{
  floorPlanImage && (
    <section class="pd-section">
      <div class="pd-container narrow">
        <h2 class="pd-h2">{d.floorPlan.title}</h2>
        <p class="pd-sub">{d.floorPlan.subtitle}</p>
        <img
          src={floorPlanImage}
          srcset={`${thumb(floorPlanImage)} 480w, ${floorPlanImage.replace(/\.webp$/, "-768.webp")} 768w, ${floorPlanImage} 1200w`}
          sizes="(max-width: 768px) 100vw, 720px"
          alt={d.floorPlan.imageAlt}
          loading="lazy"
          decoding="async"
          style="width:100%;display:block;border:1px solid #e8e8e8;border-radius:4px;"
        />
      </div>
    </section>
  )
}

<!-- Access -->
<section class="pd-section">
  <div class="pd-container narrow">
    <h2 class="pd-h2">{d.access.title}</h2>
    <ul class="acc-list">
      {
        d.access.items.map((a: { from: string; time: string }) => (
          <li class="acc-row">
            <span class="acc-from">{a.from}</span>
            <span class="acc-time">{a.time}</span>
          </li>
        ))
      }
    </ul>

    <!-- GEO: 周辺スポット距離表（住吉神社・柳橋連合市場・キャナルシティ・大濠公園・中洲） -->
    <h3 class="pd-h3" style="margin-top:2.5rem;">{nearby.title}</h3>
    <ul class="acc-list">
      {
        nearby.rows.map((row) => (
          <li class="acc-row">
            <span class="acc-from">{row.name}</span>
            <span class="acc-time">{row[propertyKey]}</span>
          </li>
        ))
      }
    </ul>

    <!-- Googleマップ埋め込み（APIキー不要・遅延ロードで初期表示速度を維持） -->
    <h3 class="pd-h3" style="margin-top:2.5rem;">{MAP_LABEL[lang]}</h3>
    <div class="pd-map">
      <iframe
        title={`yah.homes ${propertyKey} — ${MAP_LABEL[lang]}`}
        src={`https://www.google.com/maps?q=${PROPERTY_GEO[propertyKey].lat},${PROPERTY_GEO[propertyKey].lng}&hl=${lang}&z=16&output=embed`}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        width="100%"
        height="320"
        style="border:0;display:block;border-radius:4px;"
      ></iframe>
    </div>
  </div>
</section>

<!-- Check-in / Conditions / House Rules -->
<section class="pd-section alt">
  <div class="pd-container">
    <div class="info-cols">
      <div>
        <h2 class="pd-h2 sm">{d.checkin.title}</h2>
        <ul class="pd-list">
          <li>{fill(d.checkin.time)}</li>
          <li>{fill(d.checkin.checkout)}</li>
          <li>{d.checkin.method}</li>
          <li>{d.checkin.idVerification}</li>
        </ul>
      </div>
      <div>
        <h2 class="pd-h2 sm">{d.conditions.title}</h2>
        <ul class="pd-list">
          {conditionRows.map((row) => <li>{row}</li>)}
        </ul>
      </div>
      <div>
        <h2 class="pd-h2 sm">{d.houseRules.title}</h2>
        <ul class="pd-list">
          {d.houseRules.items.map((r: { rule: string }) => <li>{fill(r.rule)}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Gallery -->
<section class="pd-section">
  <div class="pd-container">
    <h2 class="pd-h2">Gallery</h2>
    <div class="pd-gallery">
      {
        gallery.map((src, i) => (
          <button class="g-item img-zoom js-pd-gallery" data-index={i} aria-label={`Photo ${i + 1}`}>
            <img src={thumb(src)} alt={`${d.hero.propertyName} — ${i + 1}`} width="480" height="320" loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
  </div>

  <!-- Lightbox -->
  <div class="lightbox" id="pd-lightbox" hidden>
    <button class="lb-close" aria-label="Close">×</button>
    <button class="lb-prev" aria-label="Previous">‹</button>
    <img class="lb-img" alt="" />
    <button class="lb-next" aria-label="Next">›</button>
    <p class="lb-counter"></p>
  </div>
  <script is:inline type="application/json" id="pd-gallery-data" set:html={JSON.stringify(gallery)} />
</section>

<!-- FAQ -->
<section class="pd-section alt">
  <div class="pd-container narrow">
    <h2 class="pd-h2">{d.faq.title}</h2>
    {
      d.faq.items.map((item: { q: string; a: string }) => (
        <details class="pd-faq">
          <summary>
            <span class="q">{item.q}</span>
            <span class="plus" aria-hidden="true">+</span>
          </summary>
          <p class="a" style="white-space:pre-line;">{item.a}</p>
        </details>
      ))
    }
    {BOOK_PREVIEW && (
      <div class="pd-direct-band">
        <p class="pd-direct-note">{DIRECT.note}</p>
        <a href={bookHref} class="pd-cta-direct" data-cta-location="property_detail_footer_direct">{DIRECT.cta}</a>
      </div>
    )}
    <div style="margin-top:2.5rem;display:flex;gap:0.75rem;flex-wrap:wrap;">
      <a href={localizedPath(lang, "/")} class="pd-cta-ghost">{ui.backToHome}</a>
    </div>
  </div>
</section>

<!-- Press / Media Coverage（旧サイトの復活・物件別フィルタ） -->
<PressSection property={propertyKey} heading="Media Coverage" />

<style>
  .pd-hero {
    position: relative;
    width: 100%;
    min-height: 88svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .pd-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .pd-hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.2) 40%, rgba(0, 0, 0, 0.72) 100%);
    z-index: 1;
  }
  .pd-hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 3.5rem;
    color: #fff;
  }
  .pd-area {
    font-size: clamp(0.65rem, 1.4vw, 0.8rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.75rem;
  }
  .pd-name {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 0.75rem;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  .pd-tagline {
    font-size: clamp(0.9rem, 2vw, 1.05rem);
    color: rgba(255, 255, 255, 0.88);
    max-width: 540px;
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }
  .pd-capacity {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.03em;
    margin-bottom: 1.75rem;
  }
  .pd-decide {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    max-width: 30rem;
  }
  .pd-decide li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.8rem;
    line-height: 1.7;
    color: #ffffff;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
  }
  .pd-decide li::before {
    content: "✓";
    position: absolute;
    left: 0;
    font-weight: 700;
  }
  @media (max-width: 720px) {
    .pd-decide li { font-size: 0.75rem; }
  }
  .pd-price-from {
    font-size: 1.05rem; font-weight: 600; color: #ffffff; margin-bottom: 0.4rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }
  .pd-hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .pd-cta-direct {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.8rem;
    background: #ffffff;
    color: #111111;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 1px solid #ffffff;
