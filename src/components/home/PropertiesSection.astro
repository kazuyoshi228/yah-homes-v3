---
import { makeFill } from "../../lib/factText";
/* yah.homes PropertiesSection — 旧 PropertiesSection.tsx の忠実移植
   Wonder Here コピー＋ロゴ → 縦書き Properties ラベル＋2カラムカード
   （3/4画像・photos バッジ・星評価・Airbnb / Booking.com / Gallery ボタン）
   ギャラリーはバニラJSのライトボックスで再現 */
import { translations } from "../../i18n/translations";
import SectionHeading from "../SectionHeading.astro";
import { localizedPath, type Locale } from "../../i18n/config";
import { starRating } from "../../lib/lucide";
import { GALLERIES, PROPERTIES } from "../../data/properties";
import { getPropertyFacts } from "../../lib/propertyFacts";
import { uiStrings } from "../../i18n/uiStrings";
import { propertyCardDirectLabel } from "../../i18n/pageStrings";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
// 評価・スペックは Firestore の SSoT から（ビルド時に焼き込む）
const { facts } = await getPropertyFacts();
// 直販ボタン: /book/ が生成されるプレビュー時のみ表示（本番は従来どおりOTAのみ）
const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";
const BOOK_PATH = localizedPath(lang, "/book");
const DIRECT_LABEL = propertyCardDirectLabel[lang];
const t = translations[lang];

// 評価・リンクは data/properties.ts を単一ソースに（不整合の再発防止）
const PROPERTY_META = [
  {
    id: "kiyokawa",
    booking: PROPERTIES.kiyokawa.bookingUrl,
    airbnb:
      "https://www.airbnb.jp/rooms/1427842426961787667?guests=1&adults=1&s=67&unique_share_id=4f784e83-f8e1-4d15-b98c-6e272b8da0a9",
    image: "/manus-storage/kiyokawa-exterior_18a3409b.webp",
    image768: "/manus-storage/kiyokawa-exterior_18a3409b-768.webp",
    imageMobile: "/manus-storage/kiyokawa-exterior-480_cbb57d9a.webp",
    gallery: GALLERIES.kiyokawa,
    rating: Number(facts.kiyokawa.rating),
    reviewCount: Number(facts.kiyokawa.reviewCount),
    name: t.properties.kiyokawa.name,
    info: makeFill(facts.kiyokawa, lang)(t.properties.kiyokawa.info),
  },
  {
    id: "takasago",
    booking: PROPERTIES.takasago.bookingUrl,
    airbnb:
      "https://www.airbnb.jp/rooms/1497546315476018480?guests=1&adults=1&s=67&unique_share_id=5babfb67-49de-4d85-afa9-b80719dbd3c9",
    image: "/manus-storage/takasago-exterior_d4f7ccff.webp",
    image768: "/manus-storage/takasago-exterior_d4f7ccff-768.webp",
    imageMobile: "/manus-storage/takasago-exterior-480_0292d3a7.webp",
    gallery: GALLERIES.takasago,
    rating: Number(facts.takasago.rating),
    reviewCount: Number(facts.takasago.reviewCount),
    name: t.properties.takasago.name,
    info: makeFill(facts.takasago, lang)(t.properties.takasago.info),
  },
];
// ステートメントの署名（誰が言っているのかを示す。/book/ の信頼ブロックと同じ写真・同じ扱い）
const SIGN_PHOTO = "/manus-storage/director-photo_def5f1a6-480.webp";
const SIGN = {
  en: { name: "Kazuyoshi Yamada", role: "yah.homes Creative Director", note: "Ask me anything before you book — I reply within 24 hours." },
  ja: { name: "Kazuyoshi Yamada", role: "yah.homes Creative Director", note: "ご不明な点は直接お答えします。24時間以内にご連絡いたします。" },
  ko: { name: "Kazuyoshi Yamada", role: "yah.homes Creative Director", note: "궁금한 점은 직접 답변드립니다. 24시간 이내에 연락드립니다." },
  zh: { name: "Kazuyoshi Yamada", role: "yah.homes Creative Director", note: "有任何問題我會親自回覆，24小時內與您聯繫。" },
  th: { name: "Kazuyoshi Yamada", role: "yah.homes Creative Director", note: "มีคำถามอะไรถามได้เลย เราตอบภายใน 24 ชั่วโมง" },
}[lang];

const SH_PROPS = { en: "Our Houses", ja: "施設", ko: "숙소", zh: "房源", th: "ที่พัก" }[lang];
---

<section id="properties" style="background:#ffffff;padding-top:3rem;padding-bottom:6rem;">
  <div style="max-width:900px;margin:0 auto;padding:0 1.5rem;">
    <!-- a11y: 見出し階層の維持（h1→h2→h3）— 視覚上は縦書きラベルが担うため sr-only -->
    <h2 class="sr-only">{t.properties.sectionLabel}</h2>
    <!-- Wonder Here copy block -->
    <div class="reveal-fade wonder-block">
      <SectionHeading num="01" label="Our Statement" />
      {
        t.properties.wonderBody.map((para, idx) => (
          <p class={idx === 0 ? "wonder-lead" : "wonder-body"}>{para}</p>
        ))
      }
      <p class="wonder-tagline">{t.properties.wonderTagline}</p>
      <!-- 署名: 一人称で書かれたステートメントに、誰が言っているのかを添える -->
      <div class="ps-sign">
        <img class="ps-sign-photo" src={SIGN_PHOTO} alt="" width="80" height="80" loading="lazy" />
        <div>
          <p class="ps-sign-name">{SIGN.name}<span class="ps-sign-role">{SIGN.role}</span></p>
          <p class="ps-sign-note">
            {SIGN.note}
            <a class="ps-sign-link" href="#contact" aria-label={SIGN.role}>→</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Cards row -->
    <div style="margin-top:4.5rem;">
      <SectionHeading num="02" label="Properties" title={SH_PROPS} />
      <div class="properties-grid" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1.5rem;">
        {
          PROPERTY_META.map((p, i) => (
            <div
              class="reveal prop-card"
              style={`transition-delay:${i * 120}ms;`}
            >
              <button
                class="img-zoom prop-img js-open-gallery"
                data-property={p.id}
                aria-label={`${p.name} gallery`}
              >
                <img
                  src={p.image}
                  srcset={`${p.imageMobile} 480w, ${p.image768} 768w, ${p.image} 902w`}
                  sizes="(max-width: 640px) 92vw, (max-width: 900px) 45vw, 430px"
                  alt={p.name}
                  loading="lazy"
                  decoding="async"
                  width="902"
                  height="1280"
                />
                <span class="photos-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                  {p.gallery.length} photos
                </span>
              </button>

              <div style="padding:1.25rem 1rem;">
                <h3 class="prop-name">{p.name}</h3>
                <p class="prop-info">{p.info}</p>

                <a href={p.airbnb} target="_blank" rel="noopener noreferrer" class="rating-badge" data-cta-location="property_card_rating">
                  <Fragment set:html={starRating(p.rating, 12, `star-${p.id}`)} />
                  <span class="rating-num">{p.rating}</span>
                  <span class="rating-count">({p.reviewCount} {t.properties.reviewsLabel})</span>
                </a>

                <div style="display:flex;flex-direction:column;gap:0.5rem;">
                  {BOOK_PREVIEW && (
                    <a href={`${BOOK_PATH}?prop=${p.id}`} class="btn-direct" data-cta-location="property_card_direct">
                      {DIRECT_LABEL}
                    </a>
                  )}
                  <a href={p.airbnb} target="_blank" rel="noopener noreferrer" class="btn-booking" data-cta-location="property_card">
                    {t.properties.airbnbBtn}
                  </a>
                  <a href={p.booking} target="_blank" rel="noopener noreferrer" class="btn-booking" data-cta-location="property_card">
                    {t.properties.bookingBtn}
                  </a>
                  <button class="gallery-btn js-open-gallery" data-property={p.id}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                      <circle cx="8.5" cy="8.5" r="1.5" />
                      <polyline points="21 15 16 10 5 21" />
                    </svg>
                    {t.properties.galleryBtn}
                    <span style="font-size:0.75rem;font-weight:300;opacity:0.8;">({p.gallery.length})</span>
                  </button>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Lightbox overlay（バニラJS） -->
  <div class="lightbox" id="prop-lightbox" hidden>
    <button class="lb-close" aria-label="Close">×</button>
    <button class="lb-prev" aria-label="Previous">‹</button>
    <img class="lb-img" alt="" />
    <button class="lb-next" aria-label="Next">›</button>
    <p class="lb-counter"></p>
  </div>

  <!-- ギャラリー画像リスト（JSON・JSが拾う） -->
  <script
    is:inline
    type="application/json"
    id="prop-galleries"
    set:html={JSON.stringify({
      kiyokawa: GALLERIES.kiyokawa,
      takasago: GALLERIES.takasago,
    })}
  />
</section>

<style>
  .wonder-block {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e8e8e8;
  }
  /* GEO: 直接回答ブロック — 控えめだが本文としてHTMLに存在させる */
  .wonder-lead {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.3;
    color: #111111;
    white-space: pre-line;
    margin-bottom: 1.25rem;
  }
  .wonder-body {
    font-size: clamp(1rem, 1.8vw, 1.1rem);
    font-weight: 400;
    line-height: 1.85;
    color: #444444;
    white-space: pre-line;
    margin-bottom: 1rem;
  }
  .wonder-tagline {
    font-size: clamp(0.75rem, 1.2vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #111111;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }
  .v-label-wrap {
    padding-top: 0.5rem;
    flex-shrink: 0;
    display: none;
  }
  @media (min-width: 768px) {
    .v-label-wrap {
      display: flex;
    }
  }
  .prop-card {
    background: #ffffff;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    overflow: hidden;
  }
  .prop-img {
    aspect-ratio: 3/4;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
  }
  .prop-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photos-badge {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    pointer-events: none;
  }
  .prop-name {
    font-size: 2rem;
    font-weight: 500;
    color: #111111;
    margin-bottom: 0.25rem;
    letter-spacing: -0.01em;
  }
  .prop-info {
    font-size: 0.875rem;
    font-weight: 400;
    color: #666666;
    margin-bottom: 0.75rem;
  }
  .rating-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1rem;
    text-decoration: none;
    padding: 0.3rem 0.6rem;
    border: 1px solid #e8e8e8;
    border-radius: 4px;
    background: #fafafa;
    transition: border-color 0.2s;
  }
  .rating-badge:hover {
    border-color: #111111;
  }
  .rating-num {
    font-size: 0.8rem;
    font-weight: 500;
    color: #111111;
    line-height: 1;
  }
  .rating-count {
    font-size: 0.75rem;
    font-weight: 300;
    color: #666666;
    line-height: 1;
  }
  .gallery-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.65rem 1rem;
    /* ブランドBlack — ギャラリーは直販CTAではないためパレット準拠（docs/brand/brand-reference.md） */
    background: #111111;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.18s cubic-bezier(0.23, 1, 0.32, 1), transform 0.16s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .gallery-btn:hover {
    background: #333333;
  }
  .gallery-btn:active {
    transform: scale(0.97);
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lb-img {
    max-width: 92vw;
    max-height: 86vh;
    object-fit: contain;
    display: block;
  }
  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    font-size: 2.25rem;
    line-height: 1;
    padding: 0.5rem 1rem;
    opacity: 0.85;
    transition: opacity 0.15s;
  }
  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    opacity: 1;
  }
  .lb-close {
    top: max(0.75rem, env(safe-area-inset-top));
    right: 0.75rem;
  }
  .lb-prev {
    left: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
  }
  .lb-next {
    right: 0.25rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 3rem;
  }
  .lb-counter {
    position: absolute;
    bottom: max(1rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
  }
  .ps-sign {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    max-width: 34rem;
  }
  .ps-sign-photo {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    background: #f2f2f2;
    display: block;
  }
  .ps-sign-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: #111111;
    line-height: 1.5;
  }
  .ps-sign-role {
    display: block;
    font-size: 0.72rem;
    font-weight: 400;
    color: #666666;
    margin-top: 0.1rem;
  }
  .ps-sign-note {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: #666666;
    line-height: 1.8;
  }
  /* 言葉と行動を一致させる: 「直接お答えします」の直後に問い合わせへの矢印を1つ */
  .ps-sign-link {
    display: inline-block;
    margin-left: 0.4rem;
    color: #111111;
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1;
    vertical-align: -0.05em;
    transition: transform 0.15s ease;
  }
  .ps-sign-link:hover { transform: translateX(3px); }
  @media (max-width: 520px) {
    .ps-sign { gap: 0.85rem; }
    .ps-sign-photo { width: 64px; height: 64px; }
  }
</style>

<script>
  // ライトボックス（旧 Lightbox.tsx の代替・バニラJS）
  const dataEl = document.getElementById("prop-galleries");
  const galleries: Record<string, string[]> = dataEl ? JSON.parse(dataEl.textContent || "{}") : {};
  const lb = document.getElementById("prop-lightbox") as HTMLElement | null;
  const lbImg = lb?.querySelector(".lb-img") as HTMLImageElement | null;
  const lbCounter = lb?.querySelector(".lb-counter") as HTMLElement | null;
  let current: string[] = [];
  let idx = 0;

  function render() {
    if (!lbImg || !lbCounter) return;
    lbImg.src = current[idx] ?? "";
    lbCounter.textContent = `${idx + 1} / ${current.length}`;
  }
  function openGallery(id: string) {
    current = galleries[id] ?? [];
    if (!current.length || !lb) return;
    idx = 0;
    render();
    lb.hidden = false;
    document.body.style.overflow = "hidden";
  }
  function close() {
    if (!lb) return;
    lb.hidden = true;
    document.body.style.overflow = "";
  }
  function prev() {
    idx = (idx - 1 + current.length) % current.length;
    render();
  }
  function next() {
    idx = (idx + 1) % current.length;
    render();
  }

  document.querySelectorAll<HTMLElement>(".js-open-gallery").forEach((el) => {
    el.addEventListener("click", () => openGallery(el.dataset.property || ""));
  });
  lb?.querySelector(".lb-close")?.addEventListener("click", close);
  lb?.querySelector(".lb-prev")?.addEventListener("click", prev);
  lb?.querySelector(".lb-next")?.addEventListener("click", next);
  lb?.addEventListener("click", (e) => {
    if (e.target === lb) close();
  });
  document.addEventListener("keydown", (e) => {
    if (lb?.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") prev();
    if (e.key === "ArrowRight") next();
  });
</script>
