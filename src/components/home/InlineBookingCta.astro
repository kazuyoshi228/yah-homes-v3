---
/* 両棟Airbnb予約CTA（共通部品）— HERO/レビュー直後/比較表直後/末尾で再利用。
   URL は src/data/properties.ts、評価・件数・取得日は property_facts（SSoT）を参照。
   計測: BaseLayout のクリック委譲が room ID で property を自動判定し click_airbnb を送信。
   data-cta-location で配置別に分離計測する。 */
import { PROPERTIES } from "../../data/properties";
import { localizedPath } from "../../i18n/config";
import { getPropertyFacts } from "../../lib/propertyFacts";
import type { Locale } from "../../i18n/config";

interface Props {
  lang: Locale;
  /** 計測の配置ラベル（GA4 cta_location に載る） */
  ctaLocation: "hero" | "after_review" | "after_compare" | "footer_cta" | "article_footer" | "after_summary";
  /** ★評価＋取得日の補助行を出すか（HERO用） */
  showRating?: boolean;
  /** 中央寄せ（レビュー/比較/末尾）か左寄せ（HERO）か */
  align?: "center" | "left";
  /** 明るい背景に置く場合 true（rating行を暗色にする） */
  onLight?: boolean;
  /** ボタン文言の上書き（既定: "Airbnb — Kiyokawa" / "Airbnb — Takasago"） */
  labels?: { kiyokawa: string; takasago: string };
}
const { lang, ctaLocation, showRating = false, align = "center", onLight = false, labels } = Astro.props;
// labels が渡される＝「予約する」意図のCTA。直販が公開されていれば直販へ送る。
// 以前は文言だけ「予約する」に変えて遷移先は Airbnb のままで、SEO流入の入口である
// ガイド記事から OTA へ送っていた（2026-08-16 修正）。
const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";
const isBookCta = Boolean(labels) && BOOK_PREVIEW;
const bookHref = (prop: string) => `${localizedPath(lang, "/book")}?prop=${prop}`;
// OTAは「予約先」ではなく「レビューの確認先」として置く（計画書§5・2026-08-16 発注者承認）。
// 公式予約と同じ重さのボタンを並べると、比較のために離脱しやすいため。
// 「OTAより安い」とは書かない（価格差は Beds24 のレート設定に依存し保証できない）。
const REVIEW_LINK = {
  en: (n: string, r: string, c: string) => `See ${n} reviews on Airbnb (${c} reviews · ★${r})`,
  ja: (n: string, r: string, c: string) => `${n}のレビューをAirbnbで見る（${c}件・★${r}）`,
  ko: (n: string, r: string, c: string) => `${n} 후기를 Airbnb에서 보기 (${c}개 · ★${r})`,
  zh: (n: string, r: string, c: string) => `在 Airbnb 查看${n}的評價（${c} 則・★${r}）`,
  th: (n: string, r: string, c: string) => `ดูรีวิว${n}บน Airbnb (${c} รีวิว · ★${r})`,
}[lang];
const NAME = { en: ["Kiyokawa", "Takasago"], ja: ["清川", "高砂"], ko: ["기요카와", "다카사고"],
               zh: ["清川", "高砂"], th: ["คิโยกาวะ", "ทาคาซาโกะ"] }[lang];

// 事実（評価・件数）は SSoT、外部リンクは properties.ts（接続情報なので別管理）
const { facts, ratingAsOf } = await getPropertyFacts();
const k = facts.kiyokawa;
const t = facts.takasago;
const kUrl = PROPERTIES.kiyokawa;
const tUrl = PROPERTIES.takasago;

const ratingLabel =
  lang === "ja"
    ? `★${k.rating} 清川（${k.reviewCount}件）・★${t.rating} 高砂（${t.reviewCount}件）｜${ratingAsOf} 時点`
    : lang === "ko"
      ? `★${k.rating} Kiyokawa (${k.reviewCount}) · ★${t.rating} Takasago (${t.reviewCount}) | ${ratingAsOf} 기준`
      : lang === "zh"
        ? `★${k.rating} 清川（${k.reviewCount}則）・★${t.rating} 高砂（${t.reviewCount}則）｜${ratingAsOf} 時點`
        : lang === "th"
          ? `★${k.rating} Kiyokawa (${k.reviewCount}) · ★${t.rating} Takasago (${t.reviewCount}) | ${ratingAsOf}`
          : `★${k.rating} Kiyokawa (${k.reviewCount}) · ★${t.rating} Takasago (${t.reviewCount}) | as of ${ratingAsOf}`;

---

<div class:list={["ibc", `ibc-${align}`, onLight && "ibc-on-light"]}>
  <div class="ibc-pills">
    {isBookCta ? (
      <>
        <a href={bookHref("kiyokawa")} class="ibc-book" data-cta-location={ctaLocation}>{labels!.kiyokawa}</a>
        <a href={bookHref("takasago")} class="ibc-book" data-cta-location={ctaLocation}>{labels!.takasago}</a>
      </>
    ) : (
      <>
        <a href={kUrl.airbnbUrl} target="_blank" rel="noopener noreferrer"
           class="ota-link" data-cta-location={ctaLocation}>
          {labels?.kiyokawa ?? REVIEW_LINK(NAME[0], k.rating, k.reviewCount)}
        </a>
        <a href={tUrl.airbnbUrl} target="_blank" rel="noopener noreferrer"
           class="ota-link" data-cta-location={ctaLocation}>
          {labels?.takasago ?? REVIEW_LINK(NAME[1], t.rating, t.reviewCount)}
        </a>
      </>
    )}
  </div>
  {showRating && <p class="ibc-rating">{ratingLabel}</p>}
</div>

<style>
  .ibc-center {
    text-align: center;
  }
  .ibc-pills {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .ibc-center .ibc-pills {
    justify-content: center;
  }
  .ibc-left .ibc-pills {
    justify-content: flex-start;
  }
  /* 直販の予約CTA（青ボタン）。OTAリンクとは視覚的な重さを明確に分ける */
  .ibc-book {
    display: inline-block;
    padding: 0.7rem 1.5rem;
    background: #1a56db;
    color: #ffffff;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }
  .ibc-book:hover { background: #1544b0; color: #ffffff; }

  /* OTAは補助リンク（テキスト）。公式予約の青ボタンと視覚的な重さを揃えない */
  .ota-link {
    display: inline-block;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #444444;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #b0b0b0;
  }
  .ota-link:hover { color: #111111; text-decoration-color: #111111; }
  .ibc-on-light .ota-link { color: #444444; }
  .ibc:not(.ibc-on-light) .ota-link { color: rgba(255,255,255,0.85); text-decoration-color: rgba(255,255,255,0.5); }
  .ibc:not(.ibc-on-light) .ota-link:hover { color: #ffffff; text-decoration-color: #ffffff; }

  .ibc-rating {
    margin: 0.9rem 0 0;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.01em;
  }
  /* 明るい背景（レビュー/比較の直後）ではrating行を暗色に上書き */
  .ibc-on-light .ibc-rating {
    color: #666666;
  }
  @media (max-width: 420px) {
    .ibc-pills {
      flex-direction: column;
    }
    .ota-link {
      text-align: center;
    }
  }
</style>
