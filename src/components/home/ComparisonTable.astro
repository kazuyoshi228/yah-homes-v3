---
/* yah.homes ComparisonTable — 旧 ComparisonTable.tsx の忠実移植 */
import { translations } from "../../i18n/translations";
import { localizedPath, type Locale } from "../../i18n/config";
import { PROPERTIES } from "../../data/properties";
import { nearbyData } from "../../data/nearbyData";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = translations[lang];
const ct = t.comparisonTable;
const nearby = nearbyData[lang];

// GEO: Airbnb評価行（表は引用エンジンの抽出率が最も高い形式）
const RATING_LABEL: Record<Locale, string> = {
  en: "Airbnb Rating",
  ja: "Airbnb評価",
  ko: "에어비앤비 평점",
  zh: "Airbnb 評分",
  th: "คะแนน Airbnb",
};
const kiyoRating = `★ ${PROPERTIES.kiyokawa.rating} (${PROPERTIES.kiyokawa.reviewCount})`;
const takaRating = `★ ${PROPERTIES.takasago.rating} (${PROPERTIES.takasago.reviewCount})`;

// 人数単位（旧実装のロジックを言語で直接分岐）
const peopleUnit =
  lang === "ja" ? "名" : lang === "ko" ? "명" : lang === "zh" ? "人" : lang === "th" ? "คน" : "People";

type Row =
  | { type: "header"; label: string }
  | { type: "row"; label: string; kiyokawa: string; takasago: string };

const ROWS: Row[] = [
  { type: "header", label: ct.headers.capacity },
  { type: "row", label: ct.rows.maxCapacity, kiyokawa: `7 ${peopleUnit}`, takasago: `6 ${peopleUnit}` },
  { type: "row", label: RATING_LABEL[lang], kiyokawa: kiyoRating, takasago: takaRating },

  { type: "header", label: ct.headers.rooms },
  { type: "row", label: ct.rows.bedrooms, kiyokawa: "3", takasago: "3" },
  { type: "row", label: ct.rows.doubleBed, kiyokawa: "3", takasago: "1" },
  { type: "row", label: ct.rows.singleBed, kiyokawa: "1", takasago: "4" },
  { type: "row", label: ct.rows.bathroom, kiyokawa: "1", takasago: "1" },
  { type: "row", label: ct.rows.showerBooth, kiyokawa: "—", takasago: "1" },
  { type: "row", label: ct.rows.toilet, kiyokawa: "2", takasago: "2" },

  { type: "header", label: ct.headers.facilities },
  { type: "row", label: ct.rows.privateParking, kiyokawa: ct.values.available, takasago: ct.values.available },
  { type: "row", label: ct.rows.theaterRoom, kiyokawa: "—", takasago: ct.values.available },

  { type: "header", label: ct.headers.access },
  { type: "row", label: ct.rows.fromAirport, kiyokawa: ct.values.car18min, takasago: ct.values.car20min },
  { type: "row", label: ct.rows.fromStation, kiyokawa: ct.values.walk15min, takasago: ct.values.walk8min },
  { type: "row", label: ct.rows.nearestStation, kiyokawa: ct.values.watanabeDori, takasago: ct.values.watanabeDori },
  { type: "row", label: ct.rows.toTenjin, kiyokawa: ct.values.walk20min, takasago: ct.values.walk15min },
  { type: "row", label: ct.rows.toHakata, kiyokawa: ct.values.walk25min, takasago: ct.values.walk25min },

  // GEO: 周辺スポット距離（物件ページと同一ソース nearbyData — 数値のズレ防止）
  { type: "header", label: nearby.title },
  ...nearby.rows.map((r) => ({ type: "row" as const, label: r.name, kiyokawa: r.kiyokawa, takasago: r.takasago })),
];

// 予約行（表の最終行に各棟の予約導線を格納）
const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";
const BOOK_PATH = localizedPath(lang, "/book");
const BOOK_LABELS = {
  en: { head: "Book", btn: "Book now", direct: "Our site (best rate)" },
  ja: { head: "ご予約", btn: "予約する", direct: "自社ウェブサイト（最安）" },
  ko: { head: "예약", btn: "예약하기", direct: "공식 사이트(최저가)" },
  zh: { head: "預訂", btn: "立即預訂", direct: "官網（最優惠）" },
  th: { head: "จอง", btn: "จองเลย", direct: "เว็บทางการ (ถูกที่สุด)" },
}[lang];
const BOOK_LINKS = {
  kiyokawa: { airbnb: PROPERTIES.kiyokawa.airbnbUrl, booking: PROPERTIES.kiyokawa.bookingUrl, direct: `${BOOK_PATH}?prop=kiyokawa` },
  takasago: { airbnb: PROPERTIES.takasago.airbnbUrl, booking: PROPERTIES.takasago.bookingUrl, direct: `${BOOK_PATH}?prop=takasago` },
};

function cellClass(v: string): string {
  if (v === "—") return "val dash";
  if (v === ct.values.available) return "val avail";
  return "val";
}
---

<div style="max-width:900px;margin:0 auto;padding:0 1.5rem 5rem;">
  <h2 class="cmp-title">{ct.title}</h2>
  <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;">
    <table class="cmp-table">
      <thead>
        <tr>
          <th class="th-label"></th>
          <th class="th-prop">{t.properties.kiyokawa.name}</th>
          <th class="th-prop">{t.properties.takasago.name}</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) =>
            row.type === "header" ? (
              <tr>
                <td colspan="3" class="cat-head">{row.label}</td>
              </tr>
            ) : (
              <tr
                class="data-row"
                data-sub={row.label.startsWith("·") || row.label.startsWith("·") ? "true" : undefined}
              >
                <td class="row-label">{row.label}</td>
                <td class={cellClass(row.kiyokawa)}>{row.kiyokawa}</td>
                <td class={cellClass(row.takasago)}>{row.takasago}</td>
              </tr>
            )
          )
        }
        <tr>
          <td colspan="3" class="cat-head">{BOOK_LABELS.head}</td>
        </tr>
        <tr class="data-row">
          <td class="row-label">Airbnb</td>
          {(["kiyokawa", "takasago"] as const).map((k) => (
            <td class="val book-cell">
              <a class="cmp-btn" href={BOOK_LINKS[k].airbnb} target="_blank" rel="noopener noreferrer" data-cta-location="compare_table">
                {BOOK_LABELS.btn}
              </a>
            </td>
          ))}
        </tr>
        <tr class="data-row">
          <td class="row-label">Booking.com</td>
          {(["kiyokawa", "takasago"] as const).map((k) => (
            <td class="val book-cell">
              <a class="cmp-btn" href={BOOK_LINKS[k].booking} target="_blank" rel="noopener noreferrer" data-cta-location="compare_table">
                {BOOK_LABELS.btn}
              </a>
            </td>
          ))}
        </tr>
        {BOOK_PREVIEW && (
          <tr class="data-row">
            <td class="row-label">{BOOK_LABELS.direct}</td>
            {(["kiyokawa", "takasago"] as const).map((k) => (
              <td class="val book-cell">
                <a class="cmp-btn cmp-btn-direct" href={BOOK_LINKS[k].direct} data-cta-location="compare_table_direct">
                  {BOOK_LABELS.btn}
                </a>
              </td>
            ))}
          </tr>
        )}
      </tbody>
    </table>
  </div>
</div>

<style>
  .book-cell {
    padding-top: 0.5rem !important;
    padding-bottom: 0.5rem !important;
  }
  .cmp-btn {
    display: block;
    padding: 0.5rem 0.6rem;
    margin: 0 auto;
    max-width: 200px;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
    text-decoration: none;
    color: #111111;
    background: #ffffff;
    border: 1px solid #d7d7d7;
    border-radius: 4px;
    transition: background 0.2s ease;
  }
  .cmp-btn:hover { background: #f7f7f7; }
  .cmp-btn-direct {
    color: #ffffff;
    background: #111111;
    border-color: #111111;
  }
  .cmp-btn-direct:hover { background: #111111; opacity: 0.85; }
  .cmp-title {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 500;
    color: #111111;
    margin-bottom: 2rem;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }
  .cmp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    color: #111111;
  }
  .th-label {
    width: 40%;
    padding: 0.75rem 0;
    text-align: left;
    font-weight: 300;
    color: #888888;
    border-bottom: 1px solid #111111;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  .th-prop {
    width: 30%;
    padding: 0.75rem 1rem;
    text-align: center;
    font-weight: 500;
    color: #111111;
    border-bottom: 1px solid #111111;
    letter-spacing: -0.01em;
    font-size: 1rem;
  }
  .cat-head {
    padding: 1.25rem 0 0.4rem;
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888888;
  }
  .data-row {
    border-bottom: 1px solid #f0f0f0;
    transition: background 0.15s;
  }
  .data-row:hover {
    background: #fafafa;
  }
  .row-label {
    padding: 0.65rem 0;
    font-weight: 300;
    color: #333333;
  }
  .data-row[data-sub="true"] .row-label {
    color: #888888;
    padding-left: 1rem;
    font-size: 0.8rem;
  }
  .val {
    padding: 0.65rem 1rem;
    text-align: center;
    font-weight: 300;
    color: #333333;
  }
  .val.dash {
    color: #cccccc;
  }
  .val.avail {
    font-weight: 500;
    color: #111111;
  }
</style>
