---
/* yah.homes HeroSection — 旧 HeroSection.tsx の忠実移植
   フルビューポート・背景画像＋グラデーション・キャッチコピー2行・
   セールスポイント（lucideアイコン）・Airbnb CTA（赤ピル） */
import { translations } from "../../i18n/translations";
import type { Locale } from "../../i18n/config";
import { lucide, SALES_POINT_ICONS } from "../../lib/lucide";
import InlineBookingCta from "./InlineBookingCta.astro";
import { localizedPath } from "../../i18n/config";
import { BOOK_STRINGS } from "../../i18n/bookStrings";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = translations[lang];

// ヒーロー内の空室検索ボックス（着地点=トップ → /book/ へ日付・人数を引き継ぐ）
const bt = BOOK_STRINGS[lang];
const BOOK_PATH = localizedPath(lang, "/book");
const SEARCH_CTA = { en: "See availability", ja: "空室を見る", ko: "예약 가능일 보기", zh: "查詢空房", th: "ดูห้องว่าง" }[lang];
const MAX_GUESTS = 8;
// 本番は /book/ が未公開（BOOK_PREVIEW ゲートで生成されない）ため、検索ボックスを出すと
// 「空室を見る」が404になる。Footer/Navbar/PropertyDetail と同じゲートを掛ける。
const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";
const SHOW_HERO_SEARCH = BOOK_PREVIEW;
// Airbnbボタン2つ（清川・高砂）は、直販の検索ボックスが出る面では出さない。
// 本番は /book/ 未公開のため従来どおり2つ表示。P1公開時に扱いを再判断する。
const SHOW_HERO_AIRBNB = !BOOK_PREVIEW;

const HERO_IMAGE = "/manus-storage/hero-dining-006-opt_1d801c69.webp";
const HERO_IMAGE_768 = "/manus-storage/hero-dining-768_41dc6825.webp";

/** LCP対策: ホームの <head> で先行preloadするためのヒーロー定義（下の <img> と完全一致） */
export const HOME_HERO_PRELOAD = {
  href: "/manus-storage/hero-dining-006-opt_1d801c69.webp",
  imagesrcset: "/manus-storage/hero-dining-768_41dc6825.webp 768w, /manus-storage/hero-dining-006-opt_1d801c69.webp 1440w",
  imagesizes: "(max-width: 768px) 768px, 1440px",
};
---

<section class="hero">
  <img
    src={HERO_IMAGE}
    srcset={`${HERO_IMAGE_768} 768w, ${HERO_IMAGE} 1440w`}
    sizes="(max-width: 768px) 768px, 1440px"
    alt=""
    aria-hidden="true"
    fetchpriority="high"
    decoding="async"
    width="1440"
    height="983"
    class="hero-bg"
  />
  <div class="hero-grad" aria-hidden="true"></div>

  <!-- LCP対策: H1は即時描画（opacity:0開始の要素はLCP候補にならない）。フェードは補助要素のみ -->
  <div class="hero-content">
    <h1 class="hero-catch">
      {t.hero.catchcopy[0]}<br />{t.hero.catchcopy[1]}
    </h1>

    <div class="hero-divider" aria-hidden="true"></div>

    <ul class="hero-points">
      {
        t.hero.salesPoints.map((point, i) => (
          <li>
            <span class="pt-icon" aria-hidden="true">
              <Fragment
                set:html={lucide(SALES_POINT_ICONS[i] ?? "sparkles", {
                  size: 14,
                  strokeWidth: 1.8,
                  color: "rgba(255,255,255,0.9)",
                })}
              />
            </span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>

    <!-- 空室検索ボックス: 日付×人数 → /book/ へ引き継ぐ（P1公開前は非表示） -->
    {SHOW_HERO_SEARCH && (
    <form class="hero-search" id="hero-search" action={BOOK_PATH} method="get">
      <div class="hs-field">
        <label class="hs-label" for="hs-in">{bt.checkin}</label>
        <input class="hs-input" id="hs-in" name="checkin" type="date" required />
      </div>
      <div class="hs-field">
        <label class="hs-label" for="hs-out">{bt.checkout}</label>
        <input class="hs-input" id="hs-out" name="checkout" type="date" required />
      </div>
      <div class="hs-field">
        <label class="hs-label" for="hs-guests">{bt.guests}</label>
        <select class="hs-input" id="hs-guests" name="guests">
          {Array.from({ length: MAX_GUESTS }, (_, i) => i + 1).map((n) => (
            <option value={String(n)} selected={n === 4}>{bt.guestsUnit(n)}</option>
          ))}
        </select>
      </div>
      <button type="submit" class="hs-submit">{SEARCH_CTA}</button>
    </form>
    )}

    {SHOW_HERO_AIRBNB && (
      <div class="hero-ctas">
        <InlineBookingCta lang={lang} ctaLocation="hero" align="left" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    z-index: 0;
  }
  .hero-grad {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.18) 40%,
      rgba(0, 0, 0, 0.72) 100%
    );
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 3.5rem;
  }
  .hero-catch {
    font-size: clamp(2.25rem, 7vw, 5rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 1.75rem;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.35);
  }
  .hero-divider {
    width: 2.5rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.25rem;
  }
  .hero-points {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .hero-points li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: clamp(0.8rem, 1.7vw, 0.9375rem);
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.55;
    letter-spacing: 0.005em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
  .pt-icon {
    line-height: 1.55;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    opacity: 0.9;
  }
  .hero-ctas {
    margin-top: 1.5rem;
  }

  /* 空室検索ボックス（ヒーロー上・白カード） */
  .hero-search {
    display: grid;
    grid-template-columns: 1fr 1fr auto auto;
    gap: 1px;
    background: #d7d7d7;
    border-radius: 4px;
    overflow: hidden;
    max-width: 680px;
    margin-bottom: 1.25rem;
  }
  @media (max-width: 640px) {
    .hero-search { grid-template-columns: 1fr 1fr; }
    .hero-search .hs-field:nth-child(3) { grid-column: 1 / -1; }
    .hero-search .hs-submit { grid-column: 1 / -1; }
  }
  .hs-field {
    background: #ffffff;
    padding: 0.6rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .hs-label {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #888888;
  }
  .hs-input {
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    color: #111111;
    border: none;
    background: transparent;
    padding: 0;
    width: 100%;
    cursor: pointer;
  }
  .hs-submit {
    background: #111111;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    border: none;
    padding: 0 1.6rem;
    cursor: pointer;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .hs-submit { padding: 0.85rem; }
  }
  .hs-submit:hover { opacity: 0.85; }
</style>

<script>
  // 過去日を選べないようにする（min=今日・チェックアウトはチェックインの翌日以降）
  const formEl = document.getElementById("hero-search") as HTMLFormElement | null;
  const inEl = document.getElementById("hs-in") as HTMLInputElement | null;
  const outEl = document.getElementById("hs-out") as HTMLInputElement | null;

  // GA4: 検索ボックスの送信を計測（hero の Airbnb ボタン=click_airbnb と比較するため）
  formEl?.addEventListener("submit", () => {
    const g = (document.getElementById("hs-guests") as HTMLSelectElement | null)?.value;
    const nights = inEl?.value && outEl?.value
      ? Math.round((Date.parse(outEl.value) - Date.parse(inEl.value)) / 86400000) : null;
    (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.("event", "search", {
      cta_location: "hero_search",
      checkin: inEl?.value ?? null,
      nights,
      guests: g ? Number(g) : null,
    });
  });
  if (inEl && outEl) {
    const today = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" });
    inEl.min = today;
    outEl.min = today;
    inEl.addEventListener("change", () => {
      if (!inEl.value) return;
      const next = new Date(`${inEl.value}T00:00:00Z`);
      next.setUTCDate(next.getUTCDate() + 1);
      const min = next.toISOString().slice(0, 10);
      outEl.min = min;
      if (!outEl.value || outEl.value <= inEl.value) outEl.value = min;
    });
  }
</script>
