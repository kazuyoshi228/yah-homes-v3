---
import { ENDPOINTS } from "../lib/adminConfig";
import { FB_CONFIG } from "../lib/adminConfig";
/* 管理画面専用のナビゲーションバー（2026-08-16 発注者承認の仕様）。
   - お客様向けナビと取り違えないよう黒地に「ADMIN」表記
   - どの管理画面からでも1クリックで移動できる。未読メッセージ数を常時表示
   - 表示はロールで間引く（operator < admin < owner・メニューカードと同じ3段階）
   リンクの正本はここ1箇所。/admin/menu のカード定義とは意図的に重複させている
   （menu は初見向けの地図・こちらは日常動線。増減時は両方を更新すること）。 */

const OPS_ENDPOINT = ENDPOINTS.adminOps;

// role: このリンクが見える最低ロール
const GROUPS = [
  {
    label: "SSoT", role: "admin",
    items: [
      { href: "/admin/properties/", label: "物件ファクト", role: "owner" },
      { href: "/admin/secrets/", label: "セキュリティ鍵番号", role: "admin" },
      { href: "/admin/templates/", label: "定型メール", role: "admin" },
      { href: "/admin/internal-mails/", label: "社内向け定型メール", role: "admin" },
      { href: "/legal/terms/", label: "宿泊約款・ハウスルール", role: "owner" },
      { href: "/admin/users/", label: "管理者台帳", role: "admin" },
    ],
  },
  {
    label: "運営", role: "operator",
    items: [
      { href: "/admin/partners/", label: "パートナー申請", role: "operator" },
      { href: "/admin/mail-preview/", label: "メールテンプレート", role: "operator" },
      { href: "/admin/notify-emails/", label: "送信先メールアドレス", role: "operator" },
    ],
  },
  {
    label: "システム", role: "operator",
    items: [
      { href: "/admin/manual/", label: "操作マニュアル", role: "operator" },
      { href: "/admin/mail-log/", label: "メール送信ログ", role: "operator" },
      { href: "/admin/health/", label: "システムヘルス", role: "owner" },
      { href: "/admin/audit/", label: "変更履歴", role: "owner" },
      { href: "/admin/specs/", label: "システム仕様書", role: "owner" },
    ],
  },
];
const currentPath = Astro.url.pathname;
---

<nav class="an" aria-label="管理メニュー">
  <div class="an-inner">
    <a class="an-brand" href="/admin/menu/">
      <span class="an-logo">yah.homes</span>
      <span class="an-tag">ADMIN</span>
    </a>

    <button class="an-burger" id="an-burger" type="button"
            aria-label="メニュー" aria-expanded="false" aria-controls="an-links">
      <span></span><span></span><span></span>
    </button>

    <div class="an-links" id="an-links" data-path={currentPath}>
      <a class="an-link" href="/admin/messages/" data-minrole="operator">
        メッセージ<span class="an-badge" id="an-unread" hidden></span>
      </a>
      <a class="an-link" href="/admin/bookings/" data-minrole="operator">予約</a>
      {GROUPS.map((g) => (
        <details class="an-drop" data-minrole={g.role}>
          <summary class="an-link">{g.label} ▾</summary>
          <div class="an-menu">
            {g.items.map((it) => (
              <a class="an-item" href={it.href} data-minrole={it.role}>{it.label}</a>
            ))}
          </div>
        </details>
      ))}
    </div>

    <div class="an-me">
      <details class="an-drop an-drop-right">
        <summary class="an-link an-account" aria-label="アカウント">
          <svg class="an-account-icon" width="17" height="17" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" />
          </svg>
          <span class="an-email" id="an-email"></span>
        </summary>
        <div class="an-menu">
          <p class="an-me-email" id="an-me-email"></p>
          <a class="an-item" href="/" target="_blank" rel="noopener">サイトを見る</a>
          <a class="an-item" href="/admin/menu/">管理メニュー</a>
          <button type="button" class="an-item an-out" id="an-out">ログアウト</button>
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  // ハンバーガーの開閉。ページ遷移で閉じるので状態は保持しない。
  const burger = document.getElementById("an-burger");
  const links = document.getElementById("an-links");
  burger?.addEventListener("click", () => {
    const open = links?.classList.toggle("is-open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });
</script>

<script define:vars={{ FB_CONFIG, OPS_ENDPOINT }}>
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp, getApps }) => {
    const { getAuth, onAuthStateChanged, signOut } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    const app = getApps()[0] ?? initializeApp(FB_CONFIG);
    const auth = getAuth(app);
    const RANK = { operator: 1, admin: 2, owner: 3 };

    // 現在地のリンクに印
    const path = document.getElementById("an-links")?.dataset.path ?? location.pathname;
    document.querySelectorAll(".an-link[href], .an-item[href]").forEach((a) => {
      if (a.getAttribute("href") === path || a.getAttribute("href") === `${path}/`.replace(/\/\/$/, "/")) {
        a.classList.add("is-current");
      }
    });

    // 開いた details は他を閉じる／外側クリックで閉じる
    document.querySelectorAll(".an-drop").forEach((d) => {
      d.addEventListener("toggle", () => {
        if (d.open) document.querySelectorAll(".an-drop[open]").forEach((o) => { if (o !== d) o.open = false; });
      });
    });
    document.addEventListener("click", (e) => {
      if (!e.target.closest(".an-drop")) document.querySelectorAll(".an-drop[open]").forEach((o) => (o.open = false));
    });

    onAuthStateChanged(auth, async (user) => {
      if (!user) return;   // 各ページ側のガードに任せる（ここでは何も消さない）
      const emailEl = document.getElementById("an-email");
      if (emailEl) emailEl.textContent = user.email ?? "";
      const meEmail = document.getElementById("an-me-email");
      if (meEmail) meEmail.textContent = user.email ?? "";
      document.getElementById("an-out")?.addEventListener("click", () =>
        signOut(auth).then(() => location.replace("/admin/")));

      // ロールで間引く
      let myRank = 1;
      try {
        const token = await user.getIdToken();
        const r = await fetch(`${OPS_ENDPOINT}?view=me`, { headers: { Authorization: `Bearer ${token}` } });
        const j = await r.json();
        myRank = RANK[j.role] ?? (j.isAdmin ? 2 : 1);
      } catch { /* 判定不能は operator 相当（見せすぎない） */ }
      document.querySelectorAll("[data-minrole]").forEach((el) => {
        if ((RANK[el.dataset.minrole] ?? 2) > myRank) el.remove();
      });

      // 未読メッセージ数（threads.unreadForHost の合計）。失敗しても静かに諦める
      try {
        const fsm = await import("https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js");
        const fs = fsm.getFirestore(app);
        const q = fsm.query(fsm.collection(fs, "threads"), fsm.where("unreadForHost", ">", 0));
        fsm.onSnapshot(q, (snap) => {
          let total = 0;
          snap.forEach((d) => { total += d.data().unreadForHost || 0; });
          const b = document.getElementById("an-unread");
          if (b) { b.hidden = !total; b.textContent = total > 99 ? "99+" : String(total); }
        }, () => { /* 権限なし等は非表示のまま */ });
      } catch { /* noop */ }
    });
  });
</script>

<style>
  .an { position: sticky; top: 0; z-index: 50; background: #111111; }
  .an-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 1.25rem;
    display: flex; align-items: center; gap: 1.25rem; height: 52px;
  }
  .an-brand { display: inline-flex; align-items: baseline; gap: 0.5rem; text-decoration: none; flex: none; }
  .an-logo { font-size: 0.95rem; font-weight: 600; color: #ffffff; letter-spacing: 0.01em; }
  .an-tag {
    font-size: 0.6rem; font-weight: 600; letter-spacing: 0.14em; color: #111111;
    background: #ffffff; border-radius: 3px; padding: 0.1rem 0.4rem;
  }
  /* overflow-x: auto を置くとドロップダウン（絶対配置）が切り取られて見えなくなる。
     はみ出しは許容し、狭い画面ではリンクの余白を詰めて対処する */
  .an-links { display: flex; align-items: center; gap: 0.25rem; flex: 1; min-width: 0; }
  .an-link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: inherit; font-size: 0.8rem; color: rgba(255, 255, 255, 0.75);
    background: none; border: 0; padding: 0.45rem 0.7rem; border-radius: 5px;
    text-decoration: none; cursor: pointer; white-space: nowrap; list-style: none;
  }
  /* 後置しないと基本ルールに上書きされる（同一詳細度は後勝ち） */
  @media (max-width: 860px) {
    .an-link { padding: 0.45rem 0.45rem; font-size: 0.74rem; }
  }
  /* ハンバーガー。既定（PC）は出さない */
  .an-burger {
    display: none; flex: none; width: 34px; height: 34px; padding: 8px 7px;
    background: none; border: 0; cursor: pointer; flex-direction: column; justify-content: space-between;
  }
  .an-burger span { display: block; height: 2px; background: #ffffff; border-radius: 2px; }
  .an-burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .an-burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .an-burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* スマホ: ハンバーガーに畳む。横に並べたままだと画面幅を超え、ページ全体が
     横スクロールして見出しが画面外へずれる（2026-08-16 発注者指摘・実機で確認）。
     折り返す案も試したが、ナビが2〜3段になり画面を圧迫するため採らなかった。 */
  @media (max-width: 720px) {
    /* flex-wrap が無いとリンク群が行内に押し込まれ、右半分に寄って表示される
       （2026-08-17 発注者指摘・実機）。畳んだメニューを次の行に落とすために必須。 */
    .an-inner { height: auto; min-height: 52px; padding: 0.4rem 0.9rem; gap: 0.5rem; flex-wrap: wrap; }
    .an-burger { display: flex; margin-left: auto; order: 3; }
    .an-links {
      display: none; order: 4; flex: 0 0 100%; flex-direction: column;
      align-items: stretch; gap: 0; padding-bottom: 0.4rem;
      /* 親が sticky のため、項目が画面を超えると下に触れなくなる。
         メニュー自体をスクロール領域にする（お客様向けNavbarと同じ対策） */
      max-height: calc(100dvh - 60px);
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }
    .an-links.is-open { display: flex; }
    .an-link { font-size: 0.85rem; padding: 0.65rem 0.5rem; border-radius: 0; }
    /* 畳んだ中ではドロップダウンを浮かせず、そのまま下に並べる（切り取られないため） */
    .an-drop .an-menu {
      position: static; box-shadow: none; background: rgba(255, 255, 255, 0.06);
      border: 0; min-width: 0; margin: 0 0 0.25rem;
    }
    .an-item { font-size: 0.82rem; padding: 0.55rem 1rem; }
    .an-me { order: 2; margin-left: auto; }
  }
  .an-link:hover { color: #ffffff; background: rgba(255, 255, 255, 0.08); }
  .an-link.is-current { color: #ffffff; background: rgba(255, 255, 255, 0.14); }
  .an-badge {
    min-width: 18px; height: 18px; border-radius: 999px; background: #ff5a5f; color: #ffffff;
    font-size: 0.66rem; font-weight: 600; display: inline-flex; align-items: center; justify-content: center;
    padding: 0 0.3rem;
  }
  .an-drop { position: relative; }
  .an-drop summary { list-style: none; }
  .an-drop summary::-webkit-details-marker { display: none; }
  .an-menu {
    position: absolute; top: calc(100% + 6px); left: 0; min-width: 200px;
    background: #ffffff; border: 1px solid #e5e5e5; border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12); padding: 0.35rem; z-index: 60;
  }
  .an-drop-right .an-menu { left: auto; right: 0; }
  .an-item {
    display: block; width: 100%; text-align: left; font-family: inherit;
    font-size: 0.8rem; color: #111111; text-decoration: none; background: none; border: 0;
    padding: 0.5rem 0.7rem; border-radius: 5px; cursor: pointer; white-space: nowrap;
  }
  .an-item:hover { background: #f4f4f4; }
  .an-item.is-current { background: #f4f4f4; font-weight: 500; }
  .an-me { flex: none; }
  .an-account { gap: 0.4rem; }
  .an-account-icon { flex: none; }
  .an-email { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .an-me-email {
    font-size: 0.72rem; color: #666666; padding: 0.5rem 1rem 0.4rem;
    border-bottom: 1px solid #f0f0f0; margin-bottom: 0.25rem; word-break: break-all;
  }
  /* 狭い画面はアイコンのみ。以前は max-width:40px で文字が途中で切れていた
     （2026-08-17 発注者指摘）。メールはメニューを開けば全文が読める。 */
  @media (max-width: 720px) {
    .an-email { display: none; }
  }
</style>
