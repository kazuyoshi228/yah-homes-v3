---
// 公開ページ用レイアウト = BaseLayout(head) + Navbar + slot + Footer
// scroll reveal（.reveal / .reveal-fade → .visible）のオブザーバも全ページ共通で有効化
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import AdminNav from "../components/AdminNav.astro";
import AdminFooter from "../components/AdminFooter.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../i18n/config";

interface Props {
  lang: Locale;
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** 翻訳が存在する言語のみ hreflang を出す（ガイド記事用） */
  availableLocales?: Locale[];
  /** ヒーローのないページ用: ナビを白背景固定に */
  solidNav?: boolean;
  /** LCP対策: ヒーロー画像の preload（BaseLayout へ渡す） */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
  /** 管理画面: お客様向けナビの代わりに黒い管理バーを出す */
  adminNav?: boolean;
}
const { lang, path, title, description, ogImage, ogType, jsonLd, noindex, availableLocales, solidNav, preloadImage, adminNav } = Astro.props;
---

<BaseLayout
  lang={lang}
  path={path}
  title={title}
  description={description}
  ogImage={ogImage}
  ogType={ogType}
  jsonLd={jsonLd}
  noindex={noindex}
  availableLocales={availableLocales}
  preloadImage={preloadImage}
>
  <a href="#main-content" class="skip-link">{
    { ja: "本文へ移動", en: "Skip to content", ko: "본문으로 이동", zh: "跳至主要內容", th: "ข้ามไปยังเนื้อหา" }[lang] ?? "Skip to content"
  }</a>
  {adminNav ? <AdminNav /> : <Navbar lang={lang} path={path} solid={solidNav} />}
  <main id="main-content">
    <slot />
  </main>
  {adminNav ? <AdminFooter /> : <Footer lang={lang} />}

  <script>
    // scroll reveal — 旧サイトの IntersectionObserver 動作を全ページ共通化
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && e.target.classList.add("visible")),
      { threshold: 0.08 }
    );
    document.querySelectorAll(".reveal, .reveal-fade").forEach((el) => observer.observe(el));
  </script>
</BaseLayout>
