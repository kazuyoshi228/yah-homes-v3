---
// BaseLayout — 全ページ共通の <head>。SEO の核。
// title / description / canonical / hreflang / OGP / JSON-LD をビルド時に焼き込み、
// 全UAへ同一HTMLを配信する（旧サイトのUA出し分け・全ページ同一タイトルを廃止）。
import "../styles/global.css";
import {
  LOCALES,
  HREFLANG,
  DEFAULT_LOCALE,
  localizedPath,
  type Locale,
} from "../i18n/config";
import { BASE_URL, OG_IMAGE, organizationJsonLd } from "../lib/seo";

interface Props {
  lang: Locale;
  /** ページの論理パス（"/" や "/about"）。ロケール接頭辞は含めない。 */
  path: string;
  title: string;
  description: string;
  ogImage?: string;
  /** og:type（記事ページは "article"） */
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 管理画面など検索対象外ページは true */
  noindex?: boolean;
  /** このページが存在する言語（ガイド記事など翻訳が部分的なページ用）。省略時は全言語 */
  availableLocales?: Locale[];
  /** LCP対策: ヒーロー画像を <link rel="preload"> で先行取得（HTMLパース完了を待たず発見させる） */
  preloadImage?: { href: string; imagesrcset?: string; imagesizes?: string };
}

const {
  lang,
  path,
  title,
  description,
  ogImage = OG_IMAGE,
  ogType = "website",
  jsonLd,
  noindex = false,
  availableLocales,
  preloadImage,
} = Astro.props;

/* 計測タグ（GA4 / Metaピクセル）を出力しないページ。
   管理画面と My Page は発注者自身の作業であり、本番の指標を歪める
   （2026-08 実測: 管理画面が表示回数2位・「日本が最多国」の正体だった）。 */
const trackingPath = Astro.url.pathname;
const isPrivatePage = trackingPath.includes("/admin") || trackingPath.includes("/account");
const META_PIXEL_ID = "2216414819216704";

// canonical は自ロケールの絶対URL
const canonical = `${BASE_URL}${localizedPath(lang, path)}`;
// hreflang は「存在する言語」のみ＋x-default（en があれば en、無ければ先頭言語）
const hreflangLocales: Locale[] = availableLocales ?? [...LOCALES];
// 中国語は同一の繁体字ページを台湾・香港・中国語全般（フォールバック）の3宣言で配信
const alternates = hreflangLocales.flatMap((loc) => {
  const href = `${BASE_URL}${localizedPath(loc, path)}`;
  const tags = [{ hreflang: HREFLANG[loc], href }];
  if (loc === "zh") for (const h of ["zh-HK", "zh"]) tags.push({ hreflang: h, href });
  return tags;
});
const xDefaultLocale = hreflangLocales.includes(DEFAULT_LOCALE) ? DEFAULT_LOCALE : hreflangLocales[0];
const xDefault = `${BASE_URL}${localizedPath(xDefaultLocale, path)}`;
// html lang 属性（zh は繁体字）
const htmlLang = HREFLANG[lang];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {
      noindex ? (
        <meta name="robots" content="noindex,nofollow" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }

    {
      !noindex &&
        alternates.map((alt) => (
          <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- OGP -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((ld) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }

    <!-- Organization（運営会社）JSON-LD — 全ページ共通・sameAsでエンティティ接続 -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd())} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- LCP対策: ヒーロー画像の先行取得（img タグの発見を待たずダウンロード開始） -->
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.href}
          imagesrcset={preloadImage.imagesrcset}
          imagesizes={preloadImage.imagesizes}
          fetchpriority="high"
        />
      )
    }

    <!-- B11: フォント preload（見出し/本文の FOUT 抑制） -->
    <link rel="preload" href="/fonts/national-2-medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/national-2-regular.woff2" as="font" type="font/woff2" crossorigin />

    <!-- GA4 — www.yah.homes（G-VJ5DDRML79）
         遅延注入にしないこと: load 後に gtag.js を注入すると session_start が記録されず、
         参照元が (not set) になって流入の約4割が帰属不明になる（2026-07 実測）。
         fetchpriority=low: 実行は async のまま、ダウンロード帯域だけ LCP 画像に譲る（計測は壊れない）
         ※コメントを式の外に置くのは astro7 のコンパイラが {expr && ( の直後のHTMLコメントを許さないため -->
    {!isPrivatePage && (
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <script is:inline async fetchpriority="low" src="https://www.googletagmanager.com/gtag/js?id=G-VJ5DDRML79"></script>
    <script is:inline define:vars={{ metaPixelId: META_PIXEL_ID }}>
      /* ビルド成果物は本番とプレビューチャネルで同一のため、ビルド時にはホストを区別できない。
         実行時に判定し、本番ホスト以外（*.web.app のデモ・localhost）では計測を初期化しない。
         2026-08 実測: デモの決済テストが本番GA4に purchase 5件・¥196,400 を混入させていた。 */
      var TRACK = location.hostname === "yah.homes" || location.hostname === "www.yah.homes";

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      if (TRACK) {
        gtag("js", new Date());
        gtag("config", "G-VJ5DDRML79");
      }

      // Meta Pixel（GA4と同じガードの内側。リターゲティングの母集団を溜める）
      if (TRACK && metaPixelId) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', metaPixelId);
        fbq('track', 'PageView');
      }

      // 流入情報を滞在中は保持（予約時にサーバーへ渡し、広告→予約を突合する）
      (function () {
        var q = new URLSearchParams(location.search);
        ["utm_source", "utm_medium", "utm_campaign"].forEach(function (k) {
          var v = q.get(k);
          if (v) sessionStorage.setItem("yah_" + k, v);
        });
        var g = q.get("gclid");
        if (g) sessionStorage.setItem("yah_gclid", g);
      })();

      // GA4 イベント計測（クリック委譲・リンク先ドメインで自動判定）
      document.addEventListener("click", function (e) {
        var a = e.target && e.target.closest ? e.target.closest("a") : null;
        if (!a) return;
        var href = a.getAttribute("href") || "";
        var path = location.pathname;
        // 物件判定: URLのroom ID or 現在ページのパス
        var property =
          href.indexOf("1427842426961787667") > -1 || path.indexOf("kiyokawa") > -1
            ? "kiyokawa"
            : href.indexOf("1497546315476018480") > -1 || path.indexOf("takasago") > -1
              ? "takasago"
              : "general";
        // CTA配置ラベル（data-cta-location・どの位置のCTAが効くか分離計測）
        var ctaLocation = a.getAttribute("data-cta-location") || undefined;
        if (href.indexOf("airbnb") > -1) {
          gtag("event", "click_airbnb", { property: property, page_path: path, cta_location: ctaLocation });
          // OTAへの外部遷移は Lead ではなく OutboundBookingClick（2026-08-16）。
          // Lead に混ぜると、Metaが「直販の見込み」と「OTAへの流出」を同じ成果として
          // 学習し、広告が外部流出を増やす方向に最適化されてしまう。
          // fbq は未初期化（TRACK=false）のことがあるため必ず存在確認してから呼ぶ。
          window.fbq && fbq("trackCustom", "OutboundBookingClick", {
            property_id: property, destination: "airbnb", cta_location: ctaLocation,
          });
        } else if (href.indexOf("booking.com") > -1) {
          gtag("event", "click_booking_com", { property: property, page_path: path, cta_location: ctaLocation });
          window.fbq && fbq("trackCustom", "OutboundBookingClick", {
            property_id: property, destination: "booking_com", cta_location: ctaLocation,
          });
        } else if (href === "#booking") {
          gtag("event", "click_booking_calendar", { property: property, page_path: path });
        } else if (href.indexOf("instagram.com") > -1) {
          gtag("event", "click_instagram", { page_path: path });
        } else if (href.indexOf("prtimes.jp") > -1) {
          gtag("event", "click_press", { page_path: path });
        }
      });
    </script>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
