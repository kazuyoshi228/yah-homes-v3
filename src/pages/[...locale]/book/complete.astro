---

<SiteLayout
  lang={lang}
  path="/book/complete"
  title={C.metaTitle}
  description={C.lead}
  noindex={true}
  solidNav
>
  <section class="cp">
    <div class="cp-container">
      <!-- 確定待ち -->
      <div id="cp-wait" class="cp-wait">
        <div class="cp-spinner" aria-hidden="true"></div>
        <p class="cp-wait-text" id="cp-wait-text">{C.waiting}</p>
      </div>

      <!-- 確定後 -->
      <div id="cp-done" hidden>
        <p class="cp-eyebrow">{C.eyebrow}</p>
        <h1 class="cp-title">{C.title}</h1>
        <p class="cp-lead">{C.lead}</p>

        <div class="cp-card">
          <img class="cp-photo" id="cp-photo" src="" alt="" loading="lazy" />
          <dl class="cp-rows">
            <div class="cp-row"><dt>{C.bookingId}</dt><dd id="cp-id">—</dd></div>
            <div class="cp-row"><dt>{C.house}</dt><dd id="cp-house">—</dd></div>
            <div class="cp-row"><dt>{C.checkin}</dt><dd id="cp-checkin">—</dd></div>
            <div class="cp-row"><dt>{C.checkout}</dt><dd id="cp-checkout">—</dd></div>
            <div class="cp-row"><dt>{C.guests}</dt><dd id="cp-guests">—</dd></div>
            <div class="cp-row" id="cp-arrival-row" hidden><dt>{C.arrival}</dt><dd id="cp-arrival">—</dd></div>
            <div class="cp-row cp-row-total"><dt>{C.total}</dt><dd id="cp-total">—</dd></div>
          </dl>
          <p class="cp-note">{C.totalNote}</p>
        </div>

        <div class="cp-block">
          <h2 class="cp-h2">{C.cancelTitle}</h2>
          <p class="cp-body" id="cp-cancel">—</p>
        </div>
        <div class="cp-block">
          <h2 class="cp-h2">{C.checkinTitle}</h2>
          <p class="cp-body">{C.checkinBody}</p>
        </div>
        <div class="cp-block">
          <h2 class="cp-h2">{C.contactTitle}</h2>
          <p class="cp-body">{C.contactBody}</p>
        </div>

        <a class="cp-cta" href={ACCOUNT_PATH}>{C.myPage}</a>
      </div>

      <!-- 確定が確認できなかった場合（決済は完了している） -->
      <div id="cp-pending" hidden>
        <p class="cp-eyebrow">{C.eyebrow}</p>
        <h1 class="cp-title">{C.title}</h1>
        <p class="cp-lead" id="cp-pending-text">{C.pending}</p>
        <a class="cp-cta" href={ACCOUNT_PATH}>{C.myPage}</a>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ ACCOUNT_ENDPOINT, FB_CONFIG, HOUSE_META, ui, lang, BOOK_PATH }}>
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, onAuthStateChanged } = await import("https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js");
    const auth = getAuth(initializeApp(FB_CONFIG));
    const $ = (id) => document.getElementById(id);
    const yen = (n) => `¥${Number(n).toLocaleString("en-US")}`;
    const bookingId = new URLSearchParams(location.search).get("id") || "";

    if (!bookingId) { location.replace(BOOK_PATH); return; }

    const show = (which) => {
      $("cp-wait").hidden = which !== "wait";
      $("cp-done").hidden = which !== "done";
      $("cp-pending").hidden = which !== "pending";
    };

    function render(b) {
      const meta = HOUSE_META[b.prop] || { name: b.prop, image: "" };
      $("cp-photo").src = meta.image;
      $("cp-photo").alt = meta.name;
      $("cp-id").textContent = b.id;
      $("cp-house").textContent = meta.name;
      $("cp-checkin").textContent = `${b.checkin}　${meta.ci ?? ""}〜`;
      $("cp-checkout").textContent = `${b.checkout}　〜${meta.co ?? ""}`;
      $("cp-guests").textContent = String(b.guests);
      $("cp-total").textContent = yen(b.total);
      if (b.arrival) { $("cp-arrival").textContent = b.arrival; $("cp-arrival-row").hidden = false; }
      if (b.freeCancelUntilAt) {
        const d = new Date(b.freeCancelUntilAt);
        const s = d.toLocaleString(lang === "ja" ? "ja-JP" : lang === "ko" ? "ko-KR" : lang === "zh" ? "zh-TW" : lang === "th" ? "th-TH" : "en-US",
          { timeZone: "Asia/Tokyo", dateStyle: "medium", timeStyle: "short" });
        $("cp-cancel").textContent = ui.cancelBody.replace("{d}", `${s}${lang === "ja" ? "（日本時間）" : " (JST)"}`);
      }
      show("done");
      window.gtag?.("event", "booking_complete_viewed", { prop: b.prop, lang });
    }

    // 確定はWebhook起点で非同期に進むため、CONFIRMED になるまで待つ。
    // 25秒待っても確定しなければ「決済は完了・確定はメールで」に切り替える（決済は取れている）。
    async function poll(user) {
      const started = Date.now();
      let slowShown = false;
      for (;;) {
        try {
          const token = await user.getIdToken();
          const r = await fetch(`${ACCOUNT_ENDPOINT}?bookingId=${encodeURIComponent(bookingId)}`, {
            headers: { Authorization: `Bearer ${token}` },
          });
          if (r.status === 404) { $("cp-wait-text").textContent = ui.notFound; return; }
          const j = await r.json();
          if (j.ok && j.item) {
            if (j.item.status === "CONFIRMED") { render(j.item); return; }
            if (["VOIDED", "CANCELLED", "PAYMENT_FAILED"].includes(j.item.status)) { show("pending"); return; }
          }
        } catch { /* 通信エラーは待って再試行 */ }

        const elapsed = Date.now() - started;
        if (elapsed > 25000) { show("pending"); return; }
        if (elapsed > 8000 && !slowShown) { slowShown = true; $("cp-wait-text").textContent = ui.slow; }
        await new Promise((r) => setTimeout(r, 1500));
      }
    }

    onAuthStateChanged(auth, (user) => {
      if (!user) { $("cp-wait-text").textContent = ui.signIn; return; }
      poll(user);
    });
  });
</script>

<style>
  .cp { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .cp-container { max-width: 640px; margin: 0 auto; }
  .cp-wait { display: flex; flex-direction: column; align-items: center; gap: 1.25rem; padding: 4rem 0; }
  .cp-spinner {
    width: 28px; height: 28px; border: 2px solid #e5e5e5; border-top-color: #111111;
    border-radius: 50%; animation: cp-spin 0.9s linear infinite;
  }
  @keyframes cp-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .cp-spinner { animation-duration: 3s; } }
  .cp-wait-text { font-size: 0.88rem; color: #555555; text-align: center; line-height: 1.8; }
  .cp-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #666666; margin-bottom: 1rem; }
  .cp-title { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 500; color: #111111; margin-bottom: 0.85rem; letter-spacing: -0.01em; }
  .cp-lead { font-size: 0.9rem; color: #555555; line-height: 1.9; margin-bottom: 2.5rem; }
  .cp-card { border: 1px solid #e8e8e8; border-radius: 4px; overflow: hidden; margin-bottom: 2rem; }
  .cp-photo { display: block; width: 100%; height: 200px; object-fit: cover; background: #f5f5f5; }
  .cp-rows { padding: 1.5rem 1.5rem 0.5rem; margin: 0; }
  .cp-row { display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; border-bottom: 1px solid #f2f2f2; }
  .cp-row dt { font-size: 0.8rem; color: #666666; flex-shrink: 0; }
  .cp-row dd { font-size: 0.85rem; color: #111111; margin: 0; text-align: right; word-break: break-all; }
  .cp-row-total { border-bottom: none; padding-top: 0.9rem; }
  .cp-row-total dt { font-size: 0.85rem; color: #555555; }
  .cp-row-total dd { font-size: 1.25rem; font-weight: 500; font-variant-numeric: tabular-nums; }
  .cp-note { padding: 0 1.5rem 1.4rem; margin: 0; font-size: 0.75rem; color: #666666; text-align: right; }
  .cp-block { padding: 1.4rem 0; border-top: 1px solid #f0f0f0; }
  .cp-h2 { font-size: 0.82rem; font-weight: 500; color: #111111; margin-bottom: 0.5rem; }
  .cp-body { font-size: 0.82rem; color: #555555; line-height: 1.9; }
  .cp-cta {
    display: block; margin-top: 2rem; padding: 0.95rem 1.5rem; background: #111111; color: #ffffff;
    font-size: 0.9rem; font-weight: 500; text-align: center; text-decoration: none; border-radius: 4px;
  }
  .cp-cta:hover { opacity: 0.85; }
</style>
