---
/* /book/ — 予約の「選択」ページ（design_booking_p1_v4.md §3〜4・MS2）
   日付×人数 → 2棟の空室と総額を即表示 → 「この棟で進む」で /book/checkout へ。
   デザイン: ブランドガイドライン準拠のモノクローム（Black/White/LightGray/Gray）。
   公開ガード: 本番ビルドでは生成しない（BOOK_PREVIEW=1 のときのみ・v4 §7）。 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { LOCALES, localeParam, localizedPath, type Locale } from "../../../i18n/config";
import { BOOK_STRINGS, FX_PER_JPY } from "../../../i18n/bookStrings";
import { PROPERTIES } from "../../../data/properties";
import { getPropertyFacts } from "../../../lib/propertyFacts";

export const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";

export function getStaticPaths() {
  if (!BOOK_PREVIEW) return [];
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { lang: locale as Locale },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const t = BOOK_STRINGS[lang];

const AVAIL_ENDPOINT = "https://asia-northeast1-yah-homes.cloudfunctions.net/bookingApi";
const CHECKOUT_PATH = localizedPath(lang, "/book/checkout");

// カード表示用スペック（2026-08-08 発注者提供・表示のみ。properties.ts/Beds24の正本は未変更）
const SPEC_LABELS = {
  en: { cap: "Capacity", rooms: "Bedrooms", beds: "Beds", bath: "Bathroom", shower: "Shower room", sink: "Washbasin", toilet: "Toilet",
        guests: (n: number) => `Up to ${n}`, room: (n: number) => `${n} rooms`,
        bed: (s: number, d: number) => `${d} double / ${s} single`, unit: (n: number) => `${n}` },
  ja: { cap: "定員", rooms: "寝室", beds: "ベッド", bath: "浴室", shower: "シャワーブース", sink: "洗面台", toilet: "トイレ",
        guests: (n: number) => `最大${n}名`, room: (n: number) => `${n}室`,
        bed: (s: number, d: number) => `ダブル${d}・シングル${s}`, unit: (n: number) => `${n}` },
  ko: { cap: "정원", rooms: "침실", beds: "침대", bath: "욕실", shower: "샤워부스", sink: "세면대", toilet: "화장실",
        guests: (n: number) => `최대 ${n}명`, room: (n: number) => `${n}개`,
        bed: (s: number, d: number) => `더블 ${d}・싱글 ${s}`, unit: (n: number) => `${n}` },
  zh: { cap: "人數", rooms: "臥室", beds: "床鋪", bath: "浴室", shower: "淋浴間", sink: "洗手台", toilet: "廁所",
        guests: (n: number) => `最多${n}人`, room: (n: number) => `${n}間`,
        bed: (s: number, d: number) => `雙人床${d}・單人床${s}`, unit: (n: number) => `${n}` },
  th: { cap: "จำนวน", rooms: "ห้องนอน", beds: "เตียง", bath: "ห้องอาบน้ำ", shower: "ห้องอาบน้ำฝักบัว", sink: "อ่างล้างหน้า", toilet: "ห้องน้ำ",
        guests: (n: number) => `สูงสุด ${n} ท่าน`, room: (n: number) => `${n} ห้อง`,
        bed: (s: number, d: number) => `เตียงคู่ ${d} / เดี่ยว ${s}`, unit: (n: number) => `${n}` },
}[lang];

// スペックは Firestore の SSoT から（/admin/properties で編集・ビルド時に焼き込む）
const { facts } = await getPropertyFacts();
const SPECS = {
  kiyokawa: { max: facts.kiyokawa.capacity, rooms: facts.kiyokawa.bedrooms, single: facts.kiyokawa.bedSingle, double: facts.kiyokawa.bedDouble,
              bath: facts.kiyokawa.bath, shower: facts.kiyokawa.shower, sink: facts.kiyokawa.sink, toilet: facts.kiyokawa.toilet },
  takasago: { max: facts.takasago.capacity, rooms: facts.takasago.bedrooms, single: facts.takasago.bedSingle, double: facts.takasago.bedDouble,
              bath: facts.takasago.bath, shower: facts.takasago.shower, sink: facts.takasago.sink, toilet: facts.takasago.toilet },
  // 検証用物件（Beds24 yah.homes test1 / propertyId 346442）。デモ面にのみ出す。
  test: { max: 7, rooms: 1, single: 0, double: 0, bath: 1, shower: 0, sink: 1, toilet: 1 },
};
const specRows = (k: "kiyokawa" | "takasago") => {
  const v = SPECS[k];
  const L = SPEC_LABELS;
  return [
    [L.cap, L.guests(v.max)],
    [L.rooms, L.room(v.rooms)],
    [L.beds, L.bed(v.single, v.double)],
    [L.bath, v.bath ? L.unit(v.bath) : "—"],
    [L.shower, v.shower ? L.unit(v.shower) : "—"],
    [L.sink, v.sink ? L.unit(v.sink) : "—"],
    [L.toilet, v.toilet ? L.unit(v.toilet) : "—"],
  ];
};

const HOUSES = [
  {
    key: "kiyokawa" as const,
    name: "yah.homes kiyokawa",
    area: { en: "Kiyokawa · 8 min to Tenjin", ja: "清川・天神まで車で8分", ko: "기요카와・텐진까지 차로 8분", zh: "清川・開車8分鐘到天神", th: "คิโยคาวะ・8 นาทีถึงเทนจิน" }[lang],
    capacity: facts.kiyokawa.capacity,
    image: PROPERTIES.kiyokawa.exterior,
    detail: localizedPath(lang, "/properties/kiyokawa"),
  },
  {
    key: "takasago" as const,
    name: "yah.homes takasago",
    area: { en: "Takasago · walk to Tenjin", ja: "高砂・天神徒歩圏", ko: "다카사고・텐진 도보권", zh: "高砂・步行可達天神", th: "ทาคาซาโกะ・เดินถึงเทนจิน" }[lang],
    capacity: facts.takasago.capacity,
    image: PROPERTIES.takasago.exterior,
    detail: localizedPath(lang, "/properties/takasago"),
  },
  // 決済〜Beds24書込〜二重予約防止を通しで検証するための棟。
  // BOOK_PREVIEW ではなく専用フラグで出す。公開ゲート解除後は本番も BOOK_PREVIEW=1 で
  // ビルドされるため、そちらに紐づけると検証用物件が本番に出てしまう（監査 P1）。
  ...(process.env.BOOK_TEST_PROPERTY === "1" ? [{
    key: "test" as const,
    name: "yah.homes test1（検証用・実際には泊まれません）",
    area: { en: "Test property for end-to-end verification", ja: "動作検証用の物件です。ご予約はできません。", ko: "동작 검증용 숙소입니다.", zh: "測試用房源，無法實際入住。", th: "ที่พักสำหรับทดสอบระบบ" }[lang],
    capacity: 7,
    image: PROPERTIES.kiyokawa.exterior,
    detail: localizedPath(lang, "/properties/kiyokawa"),
  }] : []),
];

// 信頼ブロック: 運営者の顔と「聞けば人が答える」約束（写真は差し替え用スロット）
// 空室APIに要求する棟（カード構成と一致させる）
const PROPS_PARAM = HOUSES.map((h) => h.key).join(",");

const OWNER_PHOTO = "/manus-storage/director-photo_def5f1a6-480.webp"; // /about と同じ代表写真
const CONTACT_HREF = `${localizedPath(lang, "/")}#contact`;
const HOST_NAME = "Kazuyoshi Yamada";
const HOST_ROLE = "yah.homes Creative Director";
// 料金の透明性（v4 §4）: 追加費用がないことと、直販の価値を総額の近くに置く
const PRICE_NOTE = {
  en: { noExtra: "No additional charges on arrival.", direct: "Book direct and we'll handle date changes and pre-stay questions ourselves." },
  ja: { noExtra: "現地でのお支払いはありません。", direct: "公式予約なら、日程変更や滞在前のご相談を直接承ります。" },
  ko: { noExtra: "현지에서 추가로 결제하실 금액은 없습니다.", direct: "공식 예약이라면 일정 변경과 숙박 전 상담을 직접 도와드립니다." },
  zh: { noExtra: "現場無需再支付任何費用。", direct: "官網預訂，日期變更與入住前的諮詢由我們直接為您處理。" },
  th: { noExtra: "ไม่มีค่าใช้จ่ายเพิ่มเติมเมื่อเข้าพัก", direct: "จองผ่านเว็บทางการ เราดูแลการเปลี่ยนวันและคำถามก่อนเข้าพักให้เอง" },
}[lang];

// 満室時の回復導線（別棟提案・近い空室日）
const RECOVERY = {
  en: { soldOutTitle: "Not available for these dates", altSame: "The other house is available for the same dates",
        altCta: "Book this house", nearTitle: "Available on nearby dates", nights: (n: number) => `${n} nights` },
  ja: { soldOutTitle: "この日程は満室です", altSame: "同じ日程なら、こちらの棟をご予約いただけます",
        altCta: "この棟の予約へ", nearTitle: "近い日程で空室があります", nights: (n: number) => `${n}泊` },
  ko: { soldOutTitle: "해당 날짜는 예약이 불가합니다", altSame: "같은 날짜라면 이 동을 예약하실 수 있습니다",
        altCta: "이 동으로 예약", nearTitle: "가까운 날짜에 빈방이 있습니다", nights: (n: number) => `${n}박` },
  zh: { soldOutTitle: "此日期已滿房", altSame: "相同日期可預訂另一棟",
        altCta: "預訂這一棟", nearTitle: "鄰近日期尚有空房", nights: (n: number) => `${n}晚` },
  th: { soldOutTitle: "วันที่เลือกไม่ว่าง", altSame: "วันเดียวกันนี้ยังมีอีกหลังว่างอยู่",
        altCta: "จองหลังนี้", nearTitle: "มีห้องว่างในวันใกล้เคียง", nights: (n: number) => `${n} คืน` },
}[lang];

const HOST_COPY = {
  en: { lead: "yah.homes runs two houses in Fukuoka. Ask us anything before you book — we reply within 24 hours.", cta: "Contact us",
        title: "Ask us anything", name: "Name", email: "Email", message: "Your question", send: "Send", close: "Close",
        sending: "Sending…", done: "Thank you. We'll reply within 24 hours.", fail: "Could not send. Please try again shortly.",
        ctx: "Dates you were viewing" },
  ja: { lead: "yah.homes は福岡で2棟を運営しています。ご不明な点は直接お答えします。24時間以内にご連絡いたします。", cta: "ご質問・ご相談はこちら",
        title: "ご質問・ご相談", name: "お名前", email: "メールアドレス", message: "ご質問内容", send: "送信する", close: "閉じる",
        sending: "送信中…", done: "ありがとうございます。24時間以内にご連絡いたします。", fail: "送信に失敗しました。時間をおいてお試しください。",
        ctx: "ご覧の日程" },
  ko: { lead: "yah.homes는 후쿠오카에서 2개 동을 운영하고 있습니다. 궁금한 점은 직접 답변드리며, 24시간 이내에 연락드립니다.", cta: "문의하기",
        title: "문의하기", name: "성함", email: "이메일", message: "문의 내용", send: "보내기", close: "닫기",
        sending: "전송 중…", done: "감사합니다. 24시간 이내에 연락드리겠습니다.", fail: "전송에 실패했습니다. 잠시 후 다시 시도해 주세요.",
        ctx: "보고 계신 날짜" },
  zh: { lead: "yah.homes 在福岡經營兩棟房源。有任何疑問我們會親自回覆，並於24小時內與您聯繫。", cta: "諮詢與提問",
        title: "諮詢與提問", name: "姓名", email: "電子郵件", message: "問題內容", send: "送出", close: "關閉",
        sending: "傳送中…", done: "感謝您的來訊，我們將於24小時內回覆。", fail: "傳送失敗，請稍後再試。",
        ctx: "您查看的日期" },
  th: { lead: "yah.homes ดูแลบ้าน 2 หลังในฟุกุโอกะ หากมีข้อสงสัยเราตอบเองและจะติดต่อกลับภายใน 24 ชั่วโมง", cta: "ติดต่อสอบถาม",
        title: "ติดต่อสอบถาม", name: "ชื่อ", email: "อีเมล", message: "คำถามของคุณ", send: "ส่ง", close: "ปิด",
        sending: "กำลังส่ง…", done: "ขอบคุณค่ะ เราจะติดต่อกลับภายใน 24 ชั่วโมง", fail: "ส่งไม่สำเร็จ กรุณาลองใหม่อีกครั้ง",
        ctx: "วันที่คุณกำลังดู" },
}[lang];
const CONTACT_ENDPOINT = "https://asia-northeast1-yah-homes.cloudfunctions.net/contact";

const MAX_CAP = Math.max(...HOUSES.map((h) => h.capacity));
const fxRate = FX_PER_JPY[t.fxCode] ?? 1;

// カレンダー見出しラベル（言語別表記をビルド時に確定）
// 表示しうる全月ぶん（今月〜12ヶ月後）を "YYYY-M" キーで持つ。
// 月名表記の言語（en/th）では月番号の文字列置換が成立しないため、実体を全て渡す。
const now = new Date();
const monthLabels: Record<string, string> = {};
for (let i = 0; i <= 13; i++) {
  const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
  monthLabels[`${d.getFullYear()}-${d.getMonth()}`] = t.monthLabel(d.getFullYear(), d.getMonth());
}
// 「2泊4名」表記のテンプレ（{n}/{g} を置換）
const noteTemplate = t.totalNote(-1, -2).replace("-1", "{n}").replace("-2", "{g}");

const strings = {
  selectDates: t.selectDates,
  selectCheckout: t.selectCheckout,
  searching: t.searching,
  soldOut: t.soldOut,
  soldOutHint: t.soldOutHint,
  minStay: t.minStay,
  upstreamFailed: t.upstreamFailed,
  tooLate: t.tooLate,
  tooFar: t.tooFar,
  priceFrom: t.priceFrom,
  overCapacity: t.overCapacity,
  overCapacityHint: t.overCapacityHint,
  totalLabel: t.totalLabel,
  rackLabel: t.rackLabel,
  discountApplied: t.discountApplied,
  approx: t.approx,
  errorFetch: t.errorFetch,
  loadingSlow: t.loadingSlow,
  loadingTooLong: t.loadingTooLong,
  retry: t.retry,
  conditionsChanged: t.conditionsChanged,
  proceed: t.proceed,
  monthLabels,
  noteTemplate,
  noExtra: PRICE_NOTE.noExtra,
  directNote: PRICE_NOTE.direct,
  recovery: RECOVERY,
  nightsUnit: RECOVERY.nights(-1).replace("-1", "{n}"),
  houseNames: { kiyokawa: "yah.homes kiyokawa", takasago: "yah.homes takasago", test: "yah.homes test1（検証用）" },
  nightsLabel: t.nights(-1).replace("-1", "{n}"),
  dow: t.dow,
  fxCode: t.fxCode,
  fxSymbol: t.fxSymbol,
  fxRate,
};
---

<SiteLayout
  lang={lang}
  path="/book"
  title={t.metaTitle}
  description={t.metaDescription}
  noindex={true}
  solidNav
>
  <section class="bk">
    <div class="bk-container">
      <header class="bk-header">
        <h1 class="bk-title">{t.title}</h1>
        <p class="bk-lead">{t.lead}</p>
      </header>

      <!-- 検索バー: 日付（カレンダーで選択）× 人数 -->
      <div class="bk-search" id="bk-search">
        <div class="bk-field">
          <span class="bk-field-label">{t.checkin}</span>
          <output class="bk-field-value" id="bk-in">—</output>
        </div>
        <div class="bk-field">
          <span class="bk-field-label">{t.checkout}</span>
          <output class="bk-field-value" id="bk-out">—</output>
        </div>
        <div class="bk-field">
          <label class="bk-field-label" for="bk-guests">{t.guests}</label>
          <select class="bk-select" id="bk-guests">
            {Array.from({ length: MAX_CAP }, (_, i) => i + 1).map((n) => (
              <option value={String(n)} selected={n === 4}>{t.guestsUnit(n)}</option>
            ))}
          </select>
        </div>
      </div>
      <p class="bk-hint" id="bk-hint">{t.selectDates}</p>

      <!-- カレンダー（2ヶ月ずつ・1年先まで月送り・満室日は選択前からグレーアウト） -->
      <div class="bk-calnav">
        <button type="button" class="bk-navbtn" id="bk-prev" aria-label="prev">‹</button>
        <span class="bk-navlabel" id="bk-navlabel"></span>
        <button type="button" class="bk-navbtn" id="bk-next" aria-label="next">›</button>
      </div>
      <div class="bk-cal" id="bk-cal"></div>
      <div class="bk-legend">
        <span><i class="lg-open"></i>{t.legendOpen}</span>
        <span><i class="lg-closed"></i>{t.legendClosed}</span>
      </div>

      <!-- 棟カード -->
      <div class="bk-houses" id="bk-houses">
        {HOUSES.map((h) => (
          <article class="bk-house" data-house={h.key}>
            <a class="bk-house-img" href={h.detail}>
              <img src={h.image} alt={h.name} loading="lazy" width="480" height="320" />
            </a>
            <div class="bk-house-body">
              <div class="bk-house-head">
                <h2 class="bk-house-name">{h.name}</h2>
                <p class="bk-house-meta">{h.area}</p>
                <p class="bk-house-price" data-pricefrom={h.key} hidden></p>
                <table class="bk-house-spec">
                  <tbody>
                    {specRows(h.key).map(([label, value]) => (
                      <tr><th>{label}</th><td>{value}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div class="bk-quote" data-quote={h.key}>
                <p class="bk-quote-idle">{t.selectDates}</p>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- 信頼ブロック（迷って下までスクロールした人向け・売り込みにはしない） -->
      <div class="bk-host">
        {OWNER_PHOTO && <img class="bk-host-photo" src={OWNER_PHOTO} alt="" width="80" height="80" loading="lazy" />}
        <div class="bk-host-body">
          <p class="bk-host-name">{HOST_NAME}<span class="bk-host-role">{HOST_ROLE}</span></p>
          <p class="bk-host-text">{HOST_COPY.lead}</p>
          <button type="button" class="bk-host-link" id="bk-ask">{HOST_COPY.cta}</button>
        </div>
      </div>

      <!-- 問い合わせダイアログ（ページ遷移せず、選択中の日程を保持したまま質問できる） -->
      <dialog class="bk-dialog" id="bk-dialog">
        <form class="bk-dialog-form" id="bk-ask-form" method="dialog">
          <h2 class="bk-dialog-title">{HOST_COPY.title}</h2>
          <p class="bk-dialog-ctx" id="bk-ask-ctx"></p>
          <label class="bk-dialog-label" for="ask-name">{HOST_COPY.name}</label>
          <input class="bk-dialog-input" id="ask-name" type="text" required maxlength="200" />
          <label class="bk-dialog-label" for="ask-email">{HOST_COPY.email}</label>
          <input class="bk-dialog-input" id="ask-email" type="email" required maxlength="320" />
          <label class="bk-dialog-label" for="ask-message">{HOST_COPY.message}</label>
          <textarea class="bk-dialog-input" id="ask-message" rows="4" required maxlength="5000"></textarea>
          <input type="text" id="ask-website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;" />
          <p class="bk-dialog-status" id="ask-status" role="status"></p>
          <div class="bk-dialog-actions">
            <button type="button" class="bk-dialog-close" id="ask-close">{HOST_COPY.close}</button>
            <button type="button" class="bk-dialog-send" id="ask-send">{HOST_COPY.send}</button>
          </div>
        </form>
      </dialog>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ AVAIL_ENDPOINT, PROPS_PARAM, CONTACT_ENDPOINT, CHECKOUT_PATH, lang, HOST_COPY, strings, HOUSES: HOUSES.map((h) => ({ key: h.key, capacity: h.capacity })) }}>
  const $ = (id) => document.getElementById(id);
  const pad = (n) => String(n).padStart(2, "0");
  const key = (y, m, d) => `${y}-${pad(m + 1)}-${pad(d)}`;
  const today = new Date();
  const todayKey = key(today.getFullYear(), today.getMonth(), today.getDate());
  const addDays = (k, n) => {
    const [y, m, d] = k.split("-").map(Number);
    return new Date(Date.UTC(y, m - 1, d + n)).toISOString().slice(0, 10);
  };
  const nightsBetween = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 86400000);
  const yen = (n) => `¥${n.toLocaleString("en-US")}`;

  // URLパラメータで状態復元（v4 §3: 非機微値のみ）
  const params = new URLSearchParams(location.search);
  const state = {
    checkin: params.get("checkin") || null,
    checkout: params.get("checkout") || null,
    guests: Number(params.get("guests")) || 4,
    avail: null, // { kiyokawa: {date:bool}, takasago: {...} }
    monthOffset: 0, // 表示開始月（0=今月）・0〜11 で1年先まで
  };
  const MAX_OFFSET = 11; // 今月+11 → 表示は最大で「11ヶ月後・12ヶ月後」
  if (state.guests) $("bk-guests").value = String(state.guests);
  // URLで先の日付が指定されていれば、その月を開いた状態で表示
  if (state.checkin) {
    const [cy, cm] = state.checkin.split("-").map(Number);
    const diff = (cy - today.getFullYear()) * 12 + (cm - 1 - today.getMonth());
    state.monthOffset = Math.max(0, Math.min(MAX_OFFSET, diff));
  }

  // 入ってきた prop=（物件ページや広告からの棟指定）は日付選択後も保持する
  const initialProp = new URLSearchParams(location.search).get("prop");
  const focusedProp = HOUSES.some((h) => h.key === initialProp) ? initialProp : "";

  function syncUrl() {
    const p = new URLSearchParams();
    if (focusedProp) p.set("prop", focusedProp);
    if (state.checkin) p.set("checkin", state.checkin);
    if (state.checkout) p.set("checkout", state.checkout);
    p.set("guests", String(state.guests));
    history.replaceState(null, "", `${location.pathname}?${p.toString()}`);
  }

  const anyAvail = (k) => {
    if (!state.avail) return true; // 未取得時は選択可（取得後に確定）
    return HOUSES.some((h) => state.avail[h.key]?.[k] === true);
  };

  // ── カレンダー描画（2ヶ月・満室と過去はグレーアウト） ──
  const monthLabel = (y, mo) => strings.monthLabels[`${y}-${mo}`] ?? `${y}-${String(mo + 1).padStart(2, "0")}`;

  function renderCal() {
    const base = new Date(today.getFullYear(), today.getMonth() + state.monthOffset, 1);
    let html = "";
    for (let i = 0; i < 2; i++) {
      const m = new Date(base.getFullYear(), base.getMonth() + i, 1);
      const y = m.getFullYear(), mo = m.getMonth();
      const days = new Date(y, mo + 1, 0).getDate();
      const startDow = new Date(y, mo, 1).getDay();
      let cells = "";
      for (let s = 0; s < startDow; s++) cells += '<span class="cal-cell cal-empty"></span>';
      for (let d = 1; d <= days; d++) {
        const k = key(y, mo, d);
        // 締切は「チェックイン前日23:59」＝選べる最短のチェックインは明日。
        // チェックアウトも必ずその翌日以降なので、今日はどの用途でも選べない。
        // 選ばせてから「期限切れ」と言うより、最初から閉じるほうが親切
        const past = k <= todayKey;
        const closed = past || !anyAvail(k);
        const isIn = state.checkin === k;
        const isOut = state.checkout === k;
        const inRange = state.checkin && state.checkout && k > state.checkin && k < state.checkout;
        const cls = ["cal-cell", closed ? "cal-closed" : "cal-open", isIn || isOut ? "cal-sel" : "", inRange ? "cal-range" : ""].filter(Boolean).join(" ");
        // 空いている日には、その日の最安デイリー料金を添える（Beds24 のOTAと同じ値）。
        // 桁が入らないので千円単位の略記にする（¥45k）。正確な総額は日程選択後に出る
        const pr = !closed ? minPriceFor(k) : null;
        const prTag = pr ? `<span class="cal-price">¥${pr >= 100000 ? Math.round(pr / 1000) : (pr / 1000).toFixed(pr % 1000 ? 1 : 0)}k</span>` : "";
        cells += `<button type="button" class="${cls}" data-date="${k}"${closed ? " disabled" : ""}><span class="cal-day">${d}</span>${prTag}</button>`;
      }
      const head = strings.dow.map((w) => `<span class="cal-dow">${w}</span>`).join("");
      const label = monthLabel(y, mo);
      html += `<div class="cal-month"><p class="cal-title">${label}</p><div class="cal-grid">${head}${cells}</div></div>`;
    }
    $("bk-cal").innerHTML = html;
    $("bk-cal").querySelectorAll("[data-date]").forEach((b) =>
      b.addEventListener("click", () => pickDate(b.dataset.date))
    );
    $("bk-prev").disabled = state.monthOffset <= 0;
    $("bk-next").disabled = state.monthOffset >= MAX_OFFSET;
    const b0 = new Date(today.getFullYear(), today.getMonth() + state.monthOffset, 1);
    const b1 = new Date(today.getFullYear(), today.getMonth() + state.monthOffset + 1, 1);
    $("bk-navlabel").textContent = `${monthLabel(b0.getFullYear(), b0.getMonth())} – ${monthLabel(b1.getFullYear(), b1.getMonth())}`;
  }

  $("bk-prev").addEventListener("click", () => { if (state.monthOffset > 0) { state.monthOffset--; renderCal(); } });
  $("bk-next").addEventListener("click", () => { if (state.monthOffset < MAX_OFFSET) { state.monthOffset++; renderCal(); } });

  // 予約までのリードタイムを区分に丸める。具体的な宿泊日は広告基盤へ送らない（計画書 §6-3）。
  function bucketOf(checkinDate) {
    const d = Math.round((Date.parse(checkinDate) - Date.now()) / 86400000);
    return d <= 3 ? "0_3_days" : d <= 7 ? "4_7_days"
      : d <= 14 ? "8_14_days" : d <= 30 ? "15_30_days" : "over_30_days";
  }

  // GA4送信のラッパー。氏名・メール・電話・カード情報は絶対に含めない（v4 §10）
  function track(name, params) {
    window.gtag?.("event", name, { ...params, lang });
  }

  function pickDate(k) {
    if (!state.checkin || state.checkout || k <= state.checkin) {
      state.checkin = k;
      state.checkout = null;
    } else {
      // チェックイン〜アウトの間に満室日があれば、その日を新しいチェックインにする
      for (let d = state.checkin; d < k; d = addDays(d, 1)) {
        if (!anyAvail(d)) { state.checkin = k; state.checkout = null; renderAll(); return; }
      }
      state.checkout = k;
      track("dates_selected", {
        checkin: state.checkin, checkout: state.checkout,
        nights: nightsBetween(state.checkin, state.checkout), guests: state.guests,
      });
    }
    renderAll();
  }

  function renderAll() {
  // 日付をUIの言語で曜日付き表記に（宿泊予約では曜日が意思決定材料のため）
  const DATE_LOCALE = { en: "en-US", ja: "ja-JP", ko: "ko-KR", zh: "zh-TW", th: "th-TH" }[lang] || "en-US";
  const fmtDate = (iso) => {
    try {
      return new Intl.DateTimeFormat(DATE_LOCALE, { year: "numeric", month: "long", day: "numeric", weekday: "short", timeZone: "Asia/Tokyo" })
        .format(new Date(`${iso}T00:00:00+09:00`));
    } catch { return iso; }
  };
    $("bk-in").textContent = state.checkin ? fmtDate(state.checkin) : "—";
    $("bk-out").textContent = state.checkout ? fmtDate(state.checkout) : "—";
    $("bk-hint").textContent = !state.checkin
      ? strings.selectDates
      : !state.checkout
        ? strings.selectCheckout
        : strings.nightsLabel.replace("{n}", nightsBetween(state.checkin, state.checkout));
    renderCal();
    syncUrl();
    if (state.checkin && state.checkout) loadQuotes();
    else HOUSES.forEach((h) => {
      document.querySelector(`[data-quote="${h.key}"]`).innerHTML = `<p class="bk-quote-idle">${strings.selectDates}</p>`;
    });
  }

  // ── 空室・見積りの取得（統合API・重複排除・中断・stale応答の破棄） ──
  // 検索条件は checkin:checkout:guests[:prop] で一意に扱う。
  const keyOf = (ci, co, g, prop) => `${ci}:${co}:${g}${prop ? `:${prop}` : ""}`;
  const inflight = new Map();   // searchKey -> { promise, abort }
  let activeQuoteKey = null;    // 画面が待っている最新の検索キー（これ以外の応答は捨てる）
  let settledQuoteKey = null;   // 取得中 or 描画済みのキー（同一条件の二重発火を止める）

  function availUrl(ci, co, g, prop) {
    return prop
      ? `${AVAIL_ENDPOINT}?prop=${prop}&checkin=${ci}&checkout=${co}&guests=${g}`
      : `${AVAIL_ENDPOINT}?props=${PROPS_PARAM}&checkin=${ci}&checkout=${co}&guests=${g}`;
  }

  // 同じ検索が進行中なら既存のPromiseを共有し、二重に発行しない。
  function fetchAvailability(ci, co, g, prop) {
    const key = keyOf(ci, co, g, prop);
    const running = inflight.get(key);
    if (running) {
      track("availability_request_deduped", { search_key: key });
      return running.promise;
    }
    const abort = new AbortController();
    const t0 = performance.now();
    track("availability_requested", { search_key: key, properties_count: prop ? 1 : 2 });
    const promise = fetch(availUrl(ci, co, g, prop), { signal: abort.signal })
      .then((r) => r.json())
      .then((j) => {
        const list = j.properties ?? (j.ok ? [j] : []);
        track("availability_response", {
          duration_ms: Math.round(performance.now() - t0),
          cache_status: j.cacheStatus ?? "unknown",
          result_summary: list.map((x) => `${x.id}:${x.available ? "open" : "full"}`).join(","),
        });
        // Meta Search: 日程・人数が揃い、空室照会が成立した時点だけ送る。
        // 検索文字列や具体的な宿泊日は送らない（個人の旅行計画になりうるため）。
        if (j.ok) {
          window.fbq?.("track", "Search", {
            content_ids: list.map((x) => `stay_${x.id}`),
            content_type: "product",
            num_items: 1,
          });
        }
        return j;
      })
      .catch((err) => {
        if (err?.name === "AbortError") track("availability_request_aborted", { reason: "superseded" });
        else track("availability_failed", { error_type: err?.name || "network", duration_ms: Math.round(performance.now() - t0) });
        throw err;
      })
      .finally(() => { if (inflight.get(key)?.abort === abort) inflight.delete(key); });
    inflight.set(key, { promise, abort });
    return promise;
  }

  // 条件が変わったら、前回の通信を中断して最新だけを有効にする。
  function abortOthers(exceptKey) {
    inflight.forEach((v, k) => { if (k !== exceptKey) v.abort.abort(); });
  }

  let quoteTimers = [];
  const clearQuoteTimers = () => { quoteTimers.forEach(clearTimeout); quoteTimers = []; };

  const SKELETON = `<div class="bk-skel"><span class="bk-skel-line bk-skel-sm"></span><span class="bk-skel-line bk-skel-lg"></span><span class="bk-skel-line"></span></div>`;

  // 失敗・遅延時。古い料金で予約できないよう、CTAは出さず再試行だけを出す。
  function showRetry(house, message) {
    const box = document.querySelector(`[data-quote="${house.key}"]`);
    if (!box) return;
    box.innerHTML = `<p class="bk-quote-hint">${message}</p>
      <button type="button" class="bk-retry" data-retry="${house.key}">${strings.retry}</button>`;
    box.querySelector("[data-retry]")?.addEventListener("click", () => { settledQuoteKey = null; loadQuotes(true); });
  }

  function renderQuote(house, p, nights, byId) {
    const box = document.querySelector(`[data-quote="${house.key}"]`);
    if (!box) return;
    // 定員超過は「満室」ではない。日付を変えても解決しないので、人数の上限を伝える。
    if (state.guests > house.capacity) {
      box.innerHTML = `<p class="bk-quote-out">${strings.overCapacity.replace("{n}", house.capacity)}</p>
        <p class="bk-quote-hint">${strings.overCapacityHint.replace("{n}", house.capacity)}</p>`;
      return;
    }
    if (!p || !p.available) {
      // 満室・最低泊数割れ・API障害を1つに畳まない。理由が違えば次の行動も違う
      const why = p?.reason ?? "";
      track("sold_out_viewed", { prop: house.key, checkin: state.checkin, nights, guests: state.guests, reason: why || "unknown" });
      if (why === "min_stay" && p?.minStay) {
        box.innerHTML = `<p class="bk-quote-out">${strings.minStay.replace("{n}", String(p.minStay))}</p>`;
        return;
      }
      if (why === "too_late") {
        box.innerHTML = `<p class="bk-quote-out">${strings.tooLate}</p>`;
        return;
      }
      if (why === "too_far") {
        box.innerHTML = `<p class="bk-quote-out">${strings.tooFar}</p>`;
        return;
      }
      if (why === "upstream_failed") {
        box.innerHTML = `<p class="bk-quote-out">${strings.upstreamFailed}</p>`;
        return;
      }
      box.innerHTML = `<p class="bk-quote-out">${strings.recovery.soldOutTitle}</p>
        <p class="bk-quote-hint" data-recovery="${house.key}">…</p>`;
      const other = HOUSES.find((h) => h.key !== house.key);
      renderRecovery(house, nights, other ? byId[other.key] : null);
      return;
    }
    const fx = strings.fxCode === "JPY" ? "" :
      `<p class="bk-quote-fx">${strings.approx} ${strings.fxSymbol}${Math.round(p.total * strings.fxRate).toLocaleString("en-US")}</p>`;
    // 定価 = カレンダー日別価格(price1)の合計。実売(offer)は割引後なので、差があれば「定価→割引適用」を見せる
    let rack = 0;
    for (let d = new Date(`${state.checkin}T00:00:00Z`); ; d.setUTCDate(d.getUTCDate() + 1)) {
      const k = d.toISOString().slice(0, 10);
      if (k === state.checkout) break;
      const pr = state.prices?.[house.key]?.[k];
      if (typeof pr !== "number") { rack = 0; break; }
      rack += pr;
    }
    const href = `${CHECKOUT_PATH}?prop=${house.key}&checkin=${state.checkin}&checkout=${state.checkout}&guests=${state.guests}${rack > p.total ? `&rack=${rack}` : ""}`;
    track("availability_result_viewed", {
      prop: house.key, checkin: state.checkin, nights, guests: state.guests, total: p.total, currency: "JPY",
    });
    box.innerHTML = `
      <p class="bk-quote-label">${strings.totalLabel}</p>
      ${rack > p.total ? `<p class="bk-quote-rack"><s>${yen(rack)}</s>　<span class="bk-quote-disc">${strings.discountApplied}</span></p>` : ""}
      <p class="bk-quote-total">${yen(p.total)}</p>
      ${fx}
      <p class="bk-quote-note">${strings.noteTemplate.replace("{n}", nights).replace("{g}", state.guests)}</p>
      <p class="bk-quote-note">${strings.noExtra}</p>
      <p class="bk-quote-direct">${strings.directNote}</p>
      <a class="bk-cta" href="${href}">${strings.proceed}</a>`;
    track("official_value_viewed", { screen: "availability_result", prop: house.key, checkin: state.checkin });
    // Meta ViewQuote（カスタム）: 日程・人数・価格まで確認した高意向者。
    // リターゲティングの母集団づくりに使う。売上ではないので最終最適化先にはしない。
    window.fbq?.("trackCustom", "ViewQuote", {
      property_id: house.key,
      nights,
      guests: state.guests,
      value: p.total,
      currency: "JPY",
      lead_time_bucket: bucketOf(state.checkin),
    });
    box.querySelector(".bk-cta")?.addEventListener("click", () => {
      window.gtag?.("event", "begin_checkout", {
        currency: "JPY", value: p.total, lang,
        items: [{ item_id: house.key, item_name: `yah.homes ${house.key}`, price: p.total, quantity: 1 }],
      });
      // Meta InitiateCheckout（2026-08-16）。Purchase が貯まるまでの立ち上げ期は
      // これを最適化先に使う。OTAクリック（OutboundBookingClick）とは別物として扱う。
      // 具体的な宿泊日は送らない（個人の旅行計画になりうるため）。リードタイムは丸める。
      const bucket = bucketOf(state.checkin);
      window.fbq?.("track", "InitiateCheckout", {
        content_ids: [`stay_${house.key}`],
        content_type: "product",
        contents: [{ id: `stay_${house.key}`, quantity: 1, item_price: p.total }],
        currency: "JPY",
        value: p.total,
        num_items: 1,
        property_id: house.key,
        nights,
        guests: state.guests,
        lead_time_bucket: bucket,
        booking_channel: "direct",
      });
    });
  }

  // 2棟ぶんを統合APIから1回で取得する。
  async function loadQuotes(force = false) {
    if (!state.checkin || !state.checkout) return;
    const key = keyOf(state.checkin, state.checkout, state.guests);
    if (!force && key === settledQuoteKey) return; // 同一条件では再発行しない
    const changed = settledQuoteKey !== null && settledQuoteKey !== key;
    settledQuoteKey = key;
    activeQuoteKey = key;
    abortOthers(key);
    clearQuoteTimers();

    const nights = nightsBetween(state.checkin, state.checkout);
    HOUSES.forEach((h) => {
      const box = document.querySelector(`[data-quote="${h.key}"]`);
      if (box) box.innerHTML = `${SKELETON}<p class="bk-quote-hint" data-progress="${h.key}">${changed ? strings.conditionsChanged : strings.searching}</p>`;
    });
    // 1.5秒で進捗を説明、4秒で再試行を提示（自動連打はしない）
    quoteTimers.push(setTimeout(() => {
      if (activeQuoteKey !== key) return;
      document.querySelectorAll("[data-progress]").forEach((el) => { el.textContent = strings.loadingSlow; });
    }, 1500));
    quoteTimers.push(setTimeout(() => {
      if (activeQuoteKey !== key) return;
      HOUSES.forEach((h) => showRetry(h, strings.loadingTooLong));
    }, 4000));

    try {
      const j = await fetchAvailability(state.checkin, state.checkout, state.guests, null);
      if (activeQuoteKey !== key) return; // 古い応答は画面へ反映しない
      clearQuoteTimers();
      if (!j.ok) throw new Error("quote");
      const byId = Object.fromEntries((j.properties ?? []).map((x) => [x.id, x]));
      HOUSES.forEach((h) => renderQuote(h, byId[h.key], nights, byId));
    } catch (err) {
      if (err?.name === "AbortError") return;
      if (activeQuoteKey !== key) return;
      clearQuoteTimers();
      settledQuoteKey = null; // 再試行できるようにする
      HOUSES.forEach((h) => showRetry(h, strings.errorFetch));
    }
  }

  // ── 満室時の回復導線: ①同日程で別棟が空いていれば具体提案 ②なければ近い空室日を最大3件 ──
  /** その日の最安デイリー料金（表示対象の実物件のみ・検証用は除く） */
  function minPriceFor(dateKey) {
    if (!state.prices) return null;
    let min = null;
    for (const h of HOUSES) {
      if (h.key === "test") continue;
      if (state.avail?.[h.key]?.[dateKey] !== true) continue;
      const p = state.prices[h.key]?.[dateKey];
      if (p && (!min || p < min)) min = p;
    }
    return min;
  }

  /** 物件カードの「¥X〜/泊」。向こう13ヶ月の空室日の最安値＝実売価格からの自動導出 */
  function renderPriceFrom() {
    for (const h of HOUSES) {
      const box = document.querySelector(`[data-pricefrom="${h.key}"]`);
      if (!box) continue;
      const prices = Object.entries(state.prices?.[h.key] ?? {})
        .filter(([d]) => state.avail?.[h.key]?.[d] === true)
        .map(([, v]) => v);
      if (!prices.length) continue;
      const min = Math.min(...prices);
      box.innerHTML = `${strings.priceFrom.replace("{v}", `¥${min.toLocaleString("en-US")}`)}`;
      box.hidden = false;
    }
  }

  const availFor = (propKey, ci, n) => {
    if (!state.avail?.[propKey]) return false;
    for (let i = 0; i < n; i++) {
      if (state.avail[propKey][addDays(ci, i)] !== true) return false;
    }
    return true;
  };

  function nearbyOptions(preferProp, nights, max = 3) {
    const out = [];
    for (let d = 1; d <= 21 && out.length < max; d++) {
      for (const sign of [1, -1]) {
        const ci = addDays(state.checkin, d * sign);
        if (ci < todayKey) continue;
        // 元の棟を優先し、次にもう一方
        // 検証用物件は回復導線に混ぜない（名前も価格も本物ではない）
        for (const key of [preferProp, ...HOUSES.map((h) => h.key).filter((k) => k !== preferProp)].filter((k) => k !== "test")) {
          if (out.length >= max) break;
          if (out.some((o) => o.checkin === ci && o.prop === key)) continue;
          if (availFor(key, ci, nights)) out.push({ prop: key, checkin: ci, checkout: addDays(ci, nights), offset: d * sign });
        }
      }
    }
    return out.slice(0, max);
  }

  async function renderRecovery(house, nights, otherQuote) {
    const box = document.querySelector(`[data-recovery="${house.key}"]`);
    if (!box) return;
    const other = HOUSES.find((h) => h.key !== house.key);

    // ① 同日程で別棟が空いているか — 統合レスポンスに入っているので追加通信は不要
    if (other && state.guests <= other.capacity) {
      try {
        const q = otherQuote ?? {};
        if (q.available) {
          const href = `${CHECKOUT_PATH}?prop=${other.key}&checkin=${state.checkin}&checkout=${state.checkout}&guests=${state.guests}`;
          box.outerHTML = `
            <div class="bk-recovery">
              <p class="bk-rec-lead">${strings.recovery.altSame}</p>
              <p class="bk-rec-house">${strings.houseNames[other.key]}</p>
              <p class="bk-rec-meta">${strings.noteTemplate.replace("{n}", nights).replace("{g}", state.guests)}</p>
              <p class="bk-rec-total">${yen(q.total)}</p>
              <a class="bk-cta bk-rec-cta" href="${href}" data-alt="${other.key}">${strings.recovery.altCta}</a>
            </div>`;
          track("alternative_property_shown", { from: house.key, to: other.key, checkin: state.checkin, total: q.total });
          document.querySelector(`[data-alt="${other.key}"]`)?.addEventListener("click", () => {
            track("alternative_property_selected", { from: house.key, to: other.key, checkin: state.checkin });
          });
          return;
        }
      } catch { /* 続けて近い日程を提案する */ }
    }

    // ② 近い空室日（最大3件）
    const opts = nearbyOptions(house.key, nights);
    if (!opts.length) {
      box.textContent = strings.soldOutHint;
      return;
    }
    const quotes = await Promise.all(opts.map(async (o) => {
      try {
        const q = await fetchAvailability(o.checkin, o.checkout, state.guests, o.prop);
        return q.ok && q.available ? { ...o, total: q.total } : null;
      } catch { return null; }
    }));
    const valid = quotes.filter(Boolean);
    if (!valid.length) { box.textContent = strings.soldOutHint; return; }

    box.outerHTML = `
      <div class="bk-recovery">
        <p class="bk-rec-lead">${strings.recovery.nearTitle}</p>
        ${valid.map((o) => `
          <a class="bk-rec-option" href="${CHECKOUT_PATH}?prop=${o.prop}&checkin=${o.checkin}&checkout=${o.checkout}&guests=${state.guests}"
             data-altdate="${o.prop}_${o.checkin}" data-offset="${o.offset}">
            <span class="bk-rec-date">${o.checkin} 〜 ${o.checkout}</span>
            <span class="bk-rec-sub">${strings.houseNames[o.prop]} · ${strings.nightsUnit.replace("{n}", nights)}</span>
            <span class="bk-rec-price">${yen(o.total)}</span>
          </a>`).join("")}
      </div>`;
    track("alternative_dates_shown", { prop: house.key, count: valid.length, checkin: state.checkin });
    document.querySelectorAll("[data-altdate]").forEach((el) =>
      el.addEventListener("click", () => {
        track("alternative_date_selected", {
          from_prop: house.key, to_prop: el.dataset.altdate.split("_")[0],
          offset_days: Number(el.dataset.offset),
        });
      })
    );
  }

  // ── 空室先読み（2棟を統合APIで1回・約13ヶ月分） ──
  // 完了後は renderCal() のみ。renderAll() を呼ぶと loadQuotes が二重発火する。
  (async () => {
    try {
      const j = await fetch(`${AVAIL_ENDPOINT}?props=${PROPS_PARAM}`).then((r) => r.json());
      state.avail = j.ok ? Object.fromEntries((j.properties ?? []).map((x) => [x.id, x.dates || {}])) : null;
      state.prices = j.ok ? Object.fromEntries((j.properties ?? []).map((x) => [x.id, x.prices || {}])) : null;
      renderPriceFrom();
    } catch {
      state.avail = null;
    }
    renderCal();
  })();

  $("bk-guests").addEventListener("change", (e) => {
    state.guests = Number(e.target.value);
    track("guests_changed", { guests: state.guests });
    syncUrl();
    if (state.checkin && state.checkout) loadQuotes();
  });

  renderAll();

  // ── 問い合わせダイアログ（遷移なし・選択中の日程を本文へ自動添付） ──
  const dlg = $("bk-dialog");
  $("bk-ask").addEventListener("click", () => {
    const ctx = state.checkin && state.checkout
      ? `${HOST_COPY.ctx}: ${state.checkin} 〜 ${state.checkout}（${state.guests}）`
      : "";
    track("inquiry_opened", { hasDates: Boolean(state.checkin && state.checkout) });
    $("bk-ask-ctx").textContent = ctx;
    $("ask-status").textContent = "";
    dlg.showModal();
  });
  $("ask-close").addEventListener("click", () => dlg.close());
  $("ask-send").addEventListener("click", async () => {
    const form = $("bk-ask-form");
    if (!form.reportValidity()) return;
    const ctx = $("bk-ask-ctx").textContent;
    $("ask-send").disabled = true;
    $("ask-status").textContent = HOST_COPY.sending;
    try {
      const r = await fetch(CONTACT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: $("ask-name").value,
          email: $("ask-email").value,
          message: ctx ? `${$("ask-message").value}\n\n---\n${ctx}` : $("ask-message").value,
          lang,
          website: $("ask-website").value,
        }),
      });
      const j = await r.json();
      $("ask-status").textContent = j.ok ? HOST_COPY.done : HOST_COPY.fail;
      if (j.ok) { $("ask-message").value = ""; setTimeout(() => dlg.close(), 2500); }
    } catch {
      $("ask-status").textContent = HOST_COPY.fail;
    } finally {
      $("ask-send").disabled = false;
    }
  });
</script>

