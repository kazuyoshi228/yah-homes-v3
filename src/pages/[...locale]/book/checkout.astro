    title: "ยืนยันการจอง", steps: ["วันที่・บ้าน", "ข้อมูลผู้เข้าพัก", "ชำระเงิน"],
    summary: "รายละเอียดการจอง", checkin: "เช็คอิน", checkout: "เช็คเอาท์", guests: "ผู้เข้าพัก",
    checkinTime: "15:00 เป็นต้นไป", checkoutTime: "ก่อน 10:00", nightsGuests: (n: number, g: number) => `${n} คืน ${g} ท่าน`,
    priceTitle: "รายละเอียดราคา", total: "ราคารวม", taxNote: "รวมภาษีและค่าทำความสะอาด",
    cancelTitle: "การยกเลิก", freeUntil: (d: string) => `ยกเลิกฟรีถึง ${d}`,
    cancelAfter: "หลังจากนั้นจะเรียกเก็บเต็มจำนวน",
    authTitle: "เข้าสู่ระบบเพื่อดำเนินการต่อ", authLead: "เราใช้บัญชี Google เพื่อให้คุณจัดการการจองได้ภายหลัง ไม่ต้องใช้รหัสผ่าน",
    authBtn: "ดำเนินการต่อด้วย Google", authDone: "เข้าสู่ระบบแล้ว",
    detailsTitle: "ข้อมูลผู้เข้าพัก", name: "ชื่อ-นามสกุล", email: "อีเมล", phone: "เบอร์โทรศัพท์", phoneNote: "ใช้ติดต่อระหว่างการเข้าพัก",
    leadGuest: "ชื่อผู้เข้าพักหลัก (หากต่างจากผู้จอง)", optional: "ไม่บังคับ",
    arrival: "เวลาที่คาดว่าจะถึง", arrivalNote: "เช็คอินด้วยตนเองผ่านตู้เก็บกุญแจนิรภัย จึงไม่มีข้อจำกัดเรื่องเวลาที่มาถึง", arrivalAny: "ยังไม่ระบุ", arrivalLate: "หลังเที่ยงคืน",
    rulesTitle: "กฎของที่พัก", rules: ["ไม่อนุญาตให้จัดปาร์ตี้หรืออีเวนต์", "กรุณาเข้าพักตามจำนวนที่แจ้ง เราจะจัดเตรียมผ้าเช็ดตัวและเครื่องนอนตามจำนวนที่แจ้งไว้", "มีกล้องวงจรปิดภายนอกที่ทางเข้า", "ห้ามสูบบุหรี่ภายในบ้าน"],
    rulesAgree: "ฉันยอมรับกฎของที่พัก",
    marketing: "รับข้อเสนอและคูปองพิเศษ",
    trustReply: "เราจะติดต่อกลับภายใน 2–3 วันทำการ", operator: "ดำเนินการโดย Bonfire Inc.",
    confirmTitle: "ยืนยันครั้งสุดท้าย", payBtn: "ยอมรับและชำระเงิน", paySoon: "ระบบชำระเงินกำลังเตรียมการ จะเปิดให้ใช้งานเร็ว ๆ นี้",
    back: "เปลี่ยนวันที่หรือบ้าน", missing: "กรุณาเลือกวันที่ก่อน",
  },
}[lang];

const fxRate = FX_PER_JPY[t.fxCode] ?? 1;
const uiStrings = {
  approx: t.approx, fxCode: t.fxCode, fxSymbol: t.fxSymbol, fxRate,
  total: C.total, missing: C.missing, authDone: C.authDone,
  nightsGuests: C.nightsGuests(-1, -2).replace("-1", "{n}").replace("-2", "{g}"),
  freeUntil: C.freeUntil("{d}"),
  soldOut: t.soldOut,
};
---

<SiteLayout
  lang={lang}
  path="/book/checkout"
  title={`${C.title} | yah.homes`}
  description={t.metaDescription}
  noindex={true}
  solidNav
>
  <section class="co">
    <div class="co-container">
      <!-- 進行ステップ -->
      <ol class="co-steps">
        {C.steps.map((label, i) => (
          <li class={i === 1 ? "co-step is-current" : i === 0 ? "co-step is-done" : "co-step"}>
            <span class="co-step-no">{i + 1}</span>{label}
          </li>
        ))}
      </ol>

      <div class="co-grid">
        <!-- 左: 予約サマリ（PCは追従） -->
        <aside class="co-summary">
          <div class="co-card">
            <img class="co-photo" id="co-photo" src={HOUSE_META.kiyokawa.image} alt="" width="360" height="240" />
            <div class="co-card-body">
              <h2 class="co-house" id="co-house">—</h2>
              <a class="co-back" href={BOOK_PATH}>{C.back}</a>
            </div>
          </div>

          <div class="co-block">
            <h3 class="co-block-title">{C.summary}</h3>
            <dl class="co-dl">
              <div><dt>{C.checkin}</dt><dd id="co-in">—<span class="co-time">{C.checkinTime}</span></dd></div>
              <div><dt>{C.checkout}</dt><dd id="co-out">—<span class="co-time">{C.checkoutTime}</span></dd></div>
              <div><dt>{C.guests}</dt><dd id="co-guests">—</dd></div>
            </dl>
          </div>

          <div class="co-block">
            <h3 class="co-block-title">{C.priceTitle}</h3>
            <div class="co-total-row">
              <span>{C.total}</span>
              <strong class="co-total" id="co-total">—</strong>
            </div>
            <p class="co-fx" id="co-fx"></p>
            <p class="co-note">{C.taxNote}</p>
          </div>

          <div class="co-block">
            <h3 class="co-block-title">{C.cancelTitle}</h3>
            <p class="co-cancel" id="co-cancel">—</p>
            <p class="co-note">{C.cancelAfter}</p>
          </div>
        </aside>

        <!-- 右: 入力ステップ -->
        <div class="co-main">
          <h1 class="co-title">{C.title}</h1>

          <!-- 認証 -->
          <section class="co-sec" id="co-auth">
            <h2 class="co-sec-title">{C.authTitle}</h2>
            <p class="co-sec-lead">{C.authLead}</p>
            <button type="button" class="co-google" id="co-google">{C.authBtn}</button>
            <p class="co-status" id="co-auth-status"></p>
          </section>

          <!-- お客様情報 -->
          <section class="co-sec" id="co-details" hidden>
            <h2 class="co-sec-title">{C.detailsTitle}</h2>
            <div class="co-field">
              <label for="cf-name">{C.name}</label>
              <input id="cf-name" type="text" required maxlength="200" />
            </div>
            <div class="co-field">
              <label for="cf-email">{C.email}</label>
              <input id="cf-email" type="email" required maxlength="320" readonly />
            </div>
            <div class="co-field">
              <label for="cf-phone">{C.phone}</label>
              <div class="co-phone">
                <select id="cf-cc">
                  {[["+81", "JP"], ["+886", "TW"], ["+852", "HK"], ["+82", "KR"], ["+66", "TH"], ["+65", "SG"], ["+1", "US"], ["+44", "GB"], ["+61", "AU"]].map(([code, cc]) => (
                    <option value={code} selected={(lang === "ja" && cc === "JP") || (lang === "zh" && cc === "TW") || (lang === "ko" && cc === "KR") || (lang === "th" && cc === "TH") || (lang === "en" && cc === "US")}>{cc} {code}</option>
                  ))}
                </select>
                <input id="cf-phone" type="tel" required maxlength="20" inputmode="tel" />
              </div>
              <p class="co-hint">{C.phoneNote}</p>
            </div>
            <div class="co-field">
              <label for="cf-lead">{C.leadGuest}<span class="co-optional">{C.optional}</span></label>
              <input id="cf-lead" type="text" maxlength="200" />
            </div>
            <div class="co-field">
              <label for="cf-arrival">{C.arrival}<span class="co-optional">{C.optional}</span></label>
              <select id="cf-arrival">
                <option value="">{C.arrivalAny}</option>
                {["15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"].map((h) => (
                  <option value={h}>{h}〜</option>
                ))}
                <option value="24:00+">{C.arrivalLate}</option>
              </select>
              <p class="co-hint">{C.arrivalNote}</p>
            </div>
          </section>

          <!-- ハウスルール -->
          <section class="co-sec" id="co-rules" hidden>
            <h2 class="co-sec-title">{C.rulesTitle}</h2>
            <ul class="co-rules">
              {C.rules.map((r) => <li>{r}</li>)}
            </ul>
            <label class="co-check"><input type="checkbox" id="cf-rules" /> {C.rulesAgree}</label>
            <label class="co-check"><input type="checkbox" id="cf-marketing" /> {C.marketing}</label>
          </section>

          <!-- 最終確認・決済 -->
          <section class="co-sec co-sec-final" id="co-pay" hidden>
            <h2 class="co-sec-title">{C.confirmTitle}</h2>
            <div class="co-trust">
              <span id="co-trust-cancel">—</span>
            </div>
            <div class="co-final" id="co-final"></div>
            <button type="button" class="co-pay-btn" id="co-pay-btn" disabled>{C.payBtn}</button>
            <p class="co-status" id="co-pay-status">{C.paySoon}</p>
          </section>

        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ AVAIL_ENDPOINT, BOOK_PATH, FB_CONFIG, HOUSE_META, uiStrings, lang }}>
  const $ = (id) => document.getElementById(id);
  const yen = (n) => `¥${n.toLocaleString("en-US")}`;
  const p = new URLSearchParams(location.search);
  const prop = p.get("prop");
  const checkin = p.get("checkin");
  const checkout = p.get("checkout");
  const guests = Number(p.get("guests")) || 0;

  // 日程が無ければ選択ページへ戻す
  if (!prop || !HOUSE_META[prop] || !checkin || !checkout || !guests) {
    $("co-house").textContent = uiStrings.missing;
    $("co-pay-status").textContent = "";
  } else {
    const meta = HOUSE_META[prop];
    const nights = Math.round((Date.parse(checkout) - Date.parse(checkin)) / 86400000);
    $("co-photo").src = meta.image;
    $("co-house").textContent = meta.name;
    $("co-in").firstChild.textContent = checkin;
    $("co-out").firstChild.textContent = checkout;
    $("co-guests").textContent = uiStrings.nightsGuests.replace("{n}", nights).replace("{g}", guests);

    // 無料キャンセル期限 = チェックイン7日前（JST基準・v4 §4）
    const fc = new Date(Date.parse(`${checkin}T00:00:00+09:00`) - 7 * 86400000);
    const fcStr = fc.toISOString().slice(0, 10);
    $("co-cancel").textContent = uiStrings.freeUntil.replace("{d}", fcStr);
    $("co-trust-cancel").textContent = uiStrings.freeUntil.replace("{d}", fcStr);

    // 総額（サーバー側の見積りを再取得）
    fetch(`${AVAIL_ENDPOINT}?prop=${prop}&checkin=${checkin}&checkout=${checkout}&guests=${guests}`)
      .then((r) => r.json())
      .then((j) => {
        if (!j.ok || !j.available) { $("co-total").textContent = uiStrings.soldOut; return; }
        $("co-total").textContent = yen(j.total);
        if (uiStrings.fxCode !== "JPY") {
          $("co-fx").textContent = `${uiStrings.approx} ${uiStrings.fxSymbol}${Math.round(j.total * uiStrings.fxRate).toLocaleString("en-US")}`;
        }
        $("co-final").textContent = `${meta.name}　${checkin} 〜 ${checkout}　${uiStrings.nightsGuests.replace("{n}", nights).replace("{g}", guests)}　${uiStrings.total} ${yen(j.total)}`;
      })
      .catch(() => { $("co-total").textContent = "—"; });
  }

  // ── 認証（Google一本・v4 §5） ──
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    const auth = getAuth(initializeApp(FB_CONFIG));

    // WebView検出: Google OAuthが弾かれるため外部ブラウザへ誘導（v4 §5）
    const ua = navigator.userAgent || "";
    const isWebView = /(FBAN|FBAV|Instagram|Line\/|NAVER|KAKAOTALK)/i.test(ua);
    if (isWebView) {
      $("co-google").disabled = true;
      $("co-auth-status").textContent = "Safari / Chrome で開いてご予約ください";
    }

    $("co-google").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("co-auth-status").textContent = "ログインに失敗しました"; }
    });

    onAuthStateChanged(auth, (user) => {
      if (!user) return;
      $("co-auth").hidden = true;
      ["co-details", "co-rules", "co-pay"].forEach((id) => ($(id).hidden = false));
      $("cf-name").value = user.displayName || "";
      $("cf-email").value = user.email || "";
    });
  });

  // 同意チェックで決済ボタンの活性を制御（MS3でStripeに結線）
  const sync = () => {
    const ok = $("cf-rules").checked && $("cf-name").value && $("cf-phone").value;
    $("co-pay-btn").disabled = true; // MS3までは常に無効
    $("co-pay-btn").dataset.ready = ok ? "1" : "";
  };
  ["cf-rules", "cf-name", "cf-phone"].forEach((id) => {
    $(id).addEventListener("input", sync);
    $(id).addEventListener("change", sync);
  });
</script>

