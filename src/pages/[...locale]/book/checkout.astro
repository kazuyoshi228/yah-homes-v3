  payFailed: { en: "Payment could not be completed. Please try again.", ja: "決済を完了できませんでした。もう一度お試しください。", ko: "결제를 완료하지 못했습니다. 다시 시도해 주세요.", zh: "付款未能完成，請再試一次。", th: "ชำระเงินไม่สำเร็จ กรุณาลองใหม่" }[lang],
  bd: {
    en: { rack: "List price", discount: "Discount", room: "Room rate (cleaning fee included)", tax: "Lodging tax ({r} × {g} guests × {n} nights)" },
    ja: { rack: "定価", discount: "割引", room: "宿泊料（清掃料込み）", tax: "宿泊税（{r}×{g}名×{n}泊）" },
    ko: { rack: "정가", discount: "할인", room: "숙박료(청소비 포함)", tax: "숙박세({r}×{g}명×{n}박)" },
    zh: { rack: "定價", discount: "折扣", room: "住宿費（含清潔費）", tax: "住宿稅（{r}×{g}人×{n}晚）" },
    th: { rack: "ราคาปกติ", discount: "ส่วนลด", room: "ค่าห้อง (รวมค่าทำความสะอาด)", tax: "ภาษีที่พัก ({r}×{g} คน×{n} คืน)" },
  }[lang],
  priceChanged: { en: "The total has been updated to the latest price. Please review it and continue.", ja: "最新の料金に更新しました。金額をご確認のうえ、もう一度お進みください。", ko: "최신 요금으로 업데이트했습니다. 금액을 확인하신 후 다시 진행해 주세요.", zh: "已更新為最新金額，請確認後再繼續。", th: "อัปเดตเป็นราคาล่าสุดแล้ว กรุณาตรวจสอบแล้วดำเนินการต่อ" }[lang],
  freeUntil: C.freeUntil("{d}"),
  soldOut: t.soldOut,
  errOverCapacity: C.errOverCapacity, errTooLate: C.errTooLate, errTooFar: C.errTooFar,
};
const agreeParts = C.rulesAgree.split(/(\{terms\}|\{privacy\})/);
---

<SiteLayout
  lang={lang}
  path="/book/checkout"
  title={`${C.title} | yah.homes`}
  description={t.metaDescription}
  noindex={true}
  solidNav
>
  <section class="co">
    <div class="co-container">
      <!-- 進行ステップ -->
      <ol class="co-steps">
        {C.steps.map((label, i) => (
          <li class={i === 1 ? "co-step is-current" : i === 0 ? "co-step is-done" : "co-step"}>
            <span class="co-step-no">{i + 1}</span>{label}
          </li>
        ))}
      </ol>

      <div class="co-grid">
        <!-- 左: 予約サマリ（PCは追従） -->
        <aside class="co-summary">
          <div class="co-card">
            <img class="co-photo" id="co-photo" src={HOUSE_META.kiyokawa.image} alt="" width="902" height="1280" />
            <div class="co-card-body">
              <h2 class="co-house" id="co-house">—</h2>
              <a class="co-back" href={BOOK_PATH}>{C.back}</a>
            </div>
          </div>

          <div class="co-block">
            <h3 class="co-block-title">{C.summary}</h3>
            <dl class="co-dl">
              <div><dt>{C.checkin}</dt><dd id="co-in">—<span class="co-time" id="co-in-time">{C.checkinTime.replace("{t}", facts.kiyokawa.checkinTime)}</span></dd></div>
              <div><dt>{C.checkout}</dt><dd id="co-out">—<span class="co-time" id="co-out-time">{C.checkoutTime.replace("{t}", facts.kiyokawa.checkoutTime)}</span></dd></div>
              <div><dt>{C.guests}</dt><dd id="co-guests">—</dd></div>
            </dl>
          </div>

          <div class="co-block">
            <h3 class="co-block-title">{C.priceTitle}</h3>
            <dl class="co-breakdown" id="co-breakdown" hidden></dl>
            <div class="co-total-row">
              <span>{C.total}</span>
              <strong class="co-total" id="co-total">—</strong>
            </div>
            <p class="co-fx" id="co-fx"></p>
            <p class="co-note">{C.taxNote}</p>
          </div>

          <div class="co-block">
            <h3 class="co-block-title">{C.cancelTitle}</h3>
            <p class="co-cancel" id="co-cancel">—</p>
            <p class="co-note">{C.cancelAfter}</p>
          </div>
        </aside>

        <!-- 右: 入力ステップ -->
        <div class="co-main">
          <h1 class="co-title">{C.title}</h1>
          <ol class="co-steps" id="co-steps" aria-label={C.title}>
            {C.steps.map((label, i) => (
              <li class="co-step" data-step={i + 1}><span class="co-step-no">{i + 1}</span>{label}</li>
            ))}
          </ol>

          <!-- 認証 -->
          <section class="co-sec" id="co-auth">
            <h2 class="co-sec-title">{C.authTitle}</h2>
            <p class="co-sec-lead">{C.authLead}</p>
            <button type="button" class="co-google" id="co-google">{C.authBtn}</button>

            <div class="co-authsep"><span>or</span></div>

            <div class="co-emailauth">
              <label class="co-authlabel" for="co-email">{C.authEmail}</label>
              <div class="co-emailrow">
                <input id="co-email" type="email" placeholder={C.authEmailPlaceholder} maxlength="320" />
                <button type="button" class="co-emailbtn" id="co-email-send">{C.authEmailSend}</button>
              </div>
            </div>
            <p class="co-status" id="co-auth-status"></p>
          </section>

          <!-- お客様情報 -->
          <section class="co-sec" id="co-details" hidden>
            <h2 class="co-sec-title">{C.detailsTitle}</h2>
            <div class="co-field">
              <label for="cf-name">{C.name}</label>
              <input id="cf-name" type="text" required maxlength="200" />
            </div>
            <div class="co-field">
              <label for="cf-email">{C.email}</label>
              <input id="cf-email" type="email" required maxlength="320" readonly />
            </div>
            <div class="co-field">
              <label for="cf-phone">{C.phone}</label>
              <div class="co-phone">
                <select id="cf-cc">
                  {[["+81", "JP"], ["+886", "TW"], ["+852", "HK"], ["+82", "KR"], ["+66", "TH"], ["+65", "SG"], ["+1", "US"], ["+44", "GB"], ["+61", "AU"]].map(([code, cc]) => (
                    <option value={code} selected={(lang === "ja" && cc === "JP") || (lang === "zh" && cc === "TW") || (lang === "ko" && cc === "KR") || (lang === "th" && cc === "TH") || (lang === "en" && cc === "US")}>{cc} {code}</option>
                  ))}
                </select>
                <input id="cf-phone" type="tel" required maxlength="20" inputmode="tel" />
              </div>
              <p class="co-hint">{C.phoneNote}</p>
            </div>
            <div class="co-field">
              <label for="cf-lead">{C.leadGuest}<span class="co-optional">{C.optional}</span></label>
              <input id="cf-lead" type="text" maxlength="200" />
            </div>
            <div class="co-field">
              <label for="cf-arrival">{C.arrival}<span class="co-optional">{C.optional}</span></label>
              <select id="cf-arrival">
                <option value="">{C.arrivalAny}</option>
                {["15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"].map((h) => (
                  <option value={h}>{h}〜</option>
                ))}
                <option value="24:00+">{C.arrivalLate}</option>
              </select>
              <p class="co-hint">{C.arrivalNote}</p>
            </div>
          </section>

          <!-- ハウスルール -->
          <section class="co-sec" id="co-rules" hidden>
            <h2 class="co-sec-title">{C.rulesTitle}</h2>
            <ul class="co-rules">
              {C.rules.map((r) => <li>{r}</li>)}
            </ul>
            <label class="co-check">
              <input type="checkbox" id="cf-rules" />
              <span>
                {agreeParts.map((part) =>
                  part === "{terms}" ? <a href={TERMS_PATH} target="_blank" rel="noopener">{C.termsLink}</a>
                  : part === "{privacy}" ? <a href={PRIVACY_PATH} target="_blank" rel="noopener">{C.privacyLink}</a>
                  : part
                )}
              </span>
            </label>
            <label class="co-check"><input type="checkbox" id="cf-marketing" /> {C.marketing}</label>
          </section>

          <!-- 最終確認・決済 -->
          <section class="co-sec co-sec-final" id="co-pay" hidden>
            <h2 class="co-sec-title">{C.confirmTitle}</h2>
            <div class="co-trust">
              <span id="co-trust-cancel">—</span>
            </div>
            <div class="co-final" id="co-final"></div>
            <div class="co-payment" id="co-payment-element" hidden></div>
            <button type="button" class="co-pay-btn" id="co-pay-btn" disabled>{C.payBtn}</button>
            <p class="co-status" id="co-pay-status"></p>
          </section>

        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ AVAIL_ENDPOINT, BOOK_CREATE_ENDPOINT, STRIPE_PK, BOOK_PATH, FB_CONFIG, HOUSE_META, uiStrings, lang, TERMS_VERSION }}>
  const $ = (id) => document.getElementById(id);
  const yen = (n) => `¥${n.toLocaleString("en-US")}`;

  // GA4送信のラッパー。氏名・メール・電話・カード情報は絶対に含めない（v4 §10）
  function setStep(n) {
    document.querySelectorAll(".co-step").forEach((el) => {
      const i = Number(el.dataset.step);
      el.classList.toggle("is-done", i < n);
      el.classList.toggle("is-current", i === n);
    });
  }
  setStep(2);   // 日程・棟はこのページに来た時点で選択済み

  const isWebViewUA = /(FBAN|FBAV|Instagram|Line\/|NAVER|KAKAOTALK)/i.test(navigator.userAgent || "");
  const device = /Mobi|Android|iPhone/i.test(navigator.userAgent || "") ? "mobile" : "desktop";
  function track(name, params) {
    window.gtag?.("event", name, { ...params, lang, device, webview: isWebViewUA });
  }
  /* GA4の client_id と session_id を取得。
     サーバー送信の purchase を「同一ユーザーの、同一セッションのイベント」としてGA4に合流させるために両方が要る。
     session_id が無いと GA4 は新規セッションとして扱い、参照元が失われて Unassigned になる
     （2026-08-16 実測: 直販初日の purchase 2件がすべて Unassigned だった）。 */
  function gaField(field) {
    return new Promise((resolve) => {
      if (!window.gtag) return resolve("");
      let done = false;
      const t = setTimeout(() => { if (!done) { done = true; resolve(""); } }, 800);
      window.gtag("get", "G-VJ5DDRML79", field, (v) => {
        if (done) return;
        done = true; clearTimeout(t); resolve(v == null ? "" : String(v));
      });
    });
  }
  const gaClientId = () => gaField("client_id");
  const gaSessionId = () => gaField("session_id");

  const startedAt = Date.now();
  const elapsed = () => Math.round((Date.now() - startedAt) / 1000);

  const p = new URLSearchParams(location.search);
  const prop = p.get("prop");
  const checkin = p.get("checkin");
  const checkout = p.get("checkout");
  const guests = Number(p.get("guests")) || 0;
  // 決済処理からも参照するためモジュール直下に置く
  const meta = HOUSE_META[prop] || null;
  const nights = checkin && checkout ? Math.round((Date.parse(checkout) - Date.parse(checkin)) / 86400000) : 0;

  // 日程が無ければ選択ページへ戻す
  if (!prop || !meta || !checkin || !checkout || !guests) {
    $("co-house").textContent = uiStrings.missing;
    $("co-pay-status").textContent = "";
  } else {
    $("co-photo").src = meta.image;
    // 時刻は棟ごとに持つ（物件ファクト管理の値）
    if (meta.checkinTime) $("co-in-time").textContent = uiStrings.checkinTime.replace("{t}", meta.checkinTime);
    if (meta.checkoutTime) $("co-out-time").textContent = uiStrings.checkoutTime.replace("{t}", meta.checkoutTime);
    $("co-house").textContent = meta.name;
  // 料金内訳。Beds24 の見積は合計1本のため、宿泊税（福岡市: 1人1泊¥200・
  // 税抜宿泊料が1人1泊¥20,000以上は¥500）を法定ルールで分離して表示する。
  // 定価(rack)は /book のカレンダー(price1)合計から表示専用で受け取る（正はサーバー見積）。
  const rackParam = Number(p.get("rack")) || 0;
  function renderBreakdown(total) {
    const el = $("co-breakdown");
    if (!el || !guests || !nights) return;
    let taxRate = 200;
    if ((total - taxRate * guests * nights) / (guests * nights) >= 20000) taxRate = 500;
    const tax = taxRate * guests * nights;
    const room = total - tax;
    if (room <= 0) return;
    const row = (k, v, cls) => `<div class="co-bd-row${cls ? " " + cls : ""}"><dt>${k}</dt><dd>${v}</dd></div>`;
    let html = "";
    if (rackParam > total) {
      html += row(uiStrings.bd.rack, `<s>${yen(rackParam)}</s>`, "co-bd-rack");
      html += row(uiStrings.bd.discount, `−${yen(rackParam - total)}`, "co-bd-disc");
    }
    html += row(uiStrings.bd.room, yen(room));
    html += row(uiStrings.bd.tax.replace("{r}", yen(taxRate)).replace("{g}", guests).replace("{n}", nights), yen(tax));
    el.innerHTML = html;
    el.hidden = false;
  }
  // 日付をUIの言語で曜日付き表記に（例 ja: 2026年8月30日(日)）。値の受け渡しはISOのまま
  const DATE_LOCALE = { en: "en-US", ja: "ja-JP", ko: "ko-KR", zh: "zh-TW", th: "th-TH" }[lang] || "en-US";
  const fmtDate = (iso) => {
    try {
      return new Intl.DateTimeFormat(DATE_LOCALE, { year: "numeric", month: "long", day: "numeric", weekday: "short", timeZone: "Asia/Tokyo" })
        .format(new Date(`${iso}T00:00:00+09:00`));
    } catch { return iso; }
  };
    $("co-in").firstChild.textContent = fmtDate(checkin);
    $("co-out").firstChild.textContent = fmtDate(checkout);
    $("co-guests").textContent = uiStrings.nightsGuests.replace("{n}", nights).replace("{g}", guests);

    // 無料キャンセル期限。日数の正は property_facts（/admin/properties）で、
    // サーバーの返金判定（bookCreate の freeCancelUntilAt）と同じ値を使う。
    // N日前の 00:00 JST = (N+1)日前の 23:59 JST。表記は後者に揃える（実質同じ期限）
    const fcDays = meta?.freeCancelDays ?? 8;
    const fc = new Date(Date.parse(`${checkin}T00:00:00+09:00`) - fcDays * 86400000);
    const fcStr = new Date(fc.getTime() + 9 * 3600000).toISOString().slice(0, 10);
    $("co-cancel").textContent = uiStrings.freeUntil.replace("{d}", fmtDate(fcStr));
    $("co-trust-cancel").textContent = uiStrings.freeUntil.replace("{d}", fmtDate(fcStr));

    track("checkout_viewed", { prop, checkin, nights, guests });

    // 総額（サーバー側の見積りを再取得）
    fetch(`${AVAIL_ENDPOINT}?prop=${prop}&checkin=${checkin}&checkout=${checkout}&guests=${guests}`)
      .then((r) => r.json())
      .then((j) => {
        if (!j.ok || !j.available) { $("co-total").textContent = uiStrings.soldOut; return; }
        displayedTotal = j.total;
        $("co-total").textContent = yen(j.total);
        renderBreakdown(j.total);
        if (uiStrings.fxCode !== "JPY") {
          $("co-fx").textContent = `${uiStrings.approx} ${uiStrings.fxSymbol}${Math.round(j.total * uiStrings.fxRate).toLocaleString("en-US")}`;
        }
        $("co-final").textContent = `${meta.name}　${fmtDate(checkin)} 〜 ${fmtDate(checkout)}　${uiStrings.nightsGuests.replace("{n}", nights).replace("{g}", guests)}　${uiStrings.total} ${yen(j.total)}`;
      })
      .catch(() => { $("co-total").textContent = "—"; });
  }

  // ── 認証（Google一本・v4 §5） ──
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged,
            sendSignInLinkToEmail, isSignInWithEmailLink, signInWithEmailLink } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    const auth = getAuth(initializeApp(FB_CONFIG));

    // WebView検出: Google OAuthが弾かれるため外部ブラウザへ誘導（v4 §5）
    const ua = navigator.userAgent || "";
    const isWebView = /(FBAN|FBAV|Instagram|Line\/|NAVER|KAKAOTALK)/i.test(ua);
    if (isWebView) {
      $("co-google").disabled = true;
      $("co-auth-status").textContent = "アプリ内ブラウザでは Google ログインをご利用いただけません。下のメールアドレスでの認証をご利用いただくか、Safari / Chrome で開いてください。";
    }

    $("co-google").addEventListener("click", async () => {
      track("auth_started", { auth_provider: "google", seconds: elapsed() });
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch (err) {
        track("auth_failed", { auth_provider: "google", error_type: String(err?.code ?? "unknown") });
        $("co-auth-status").textContent = "ログインに失敗しました";
      }
    });

    // メールリンク認証（パスワードなし）。戻り先URLに予約条件を保持するため状態は失われない。
    $("co-email-send").addEventListener("click", async () => {
      const addr = $("co-email").value.trim();
      if (!/^\S+@\S+\.\S+$/.test(addr)) { $("co-auth-status").textContent = uiStrings.authEmailFail; return; }
      $("co-email-send").disabled = true;
      track("email_link_started", { prop, seconds: elapsed() });
      try {
        await sendSignInLinkToEmail(auth, addr, { url: location.href, handleCodeInApp: true });
        window.localStorage.setItem("yah_email_for_signin", addr);
        window.localStorage.setItem("yah_email_sent_at", String(Date.now()));
        track("email_link_sent", { result: "ok" });
        $("co-auth-status").textContent = uiStrings.authEmailSent;
      } catch (err) {
        track("email_link_sent", { result: "error", error_type: String(err?.code ?? "unknown") });
        $("co-auth-status").textContent = uiStrings.authEmailFail;
      }
      $("co-email-send").disabled = false;
    });

    // メールのリンクから戻ってきた場合はそのままログインを完了する
    if (isSignInWithEmailLink(auth, location.href)) {
      let saved = window.localStorage.getItem("yah_email_for_signin");
      if (!saved) saved = window.prompt("ご予約に使用するメールアドレスをご入力ください") || "";
      if (saved) {
        try {
          await signInWithEmailLink(auth, saved, location.href);
          const sentAt = Number(window.localStorage.getItem("yah_email_sent_at") || 0);
          track("email_link_completed", {
            same_device: Boolean(window.localStorage.getItem("yah_email_for_signin")),
            wait_seconds: sentAt ? Math.round((Date.now() - sentAt) / 1000) : null,
          });
          window.localStorage.removeItem("yah_email_for_signin");
          window.localStorage.removeItem("yah_email_sent_at");
          history.replaceState(null, "", location.pathname + location.search.replace(/[?&](apiKey|oobCode|mode|lang)=[^&]*/g, "").replace(/^&/, "?"));
        } catch {
          $("co-auth-status").textContent = uiStrings.authEmailFail;
        }
      }
    }

    onAuthStateChanged(auth, (user) => {
      if (!user) return;
      $("co-auth").hidden = true;
      ["co-details", "co-rules", "co-pay"].forEach((id) => ($(id).hidden = false));
      setStep(2);
      currentUser = user;
      const provider = user.providerData?.[0]?.providerId === "google.com" ? "google" : "email_link";
      window.gtag?.("event", "login", { method: provider, lang });
      track("auth_completed", { auth_provider: provider, seconds: elapsed() });
      $("cf-name").value = user.displayName || "";
      $("cf-email").value = user.email || "";
      sync();
    });
  });

  // ── 決済（Stripe Payment Element・v4 §8-1） ──
  // 入力が揃うまでボタンは無効。押下時に bookCreate → PaymentIntent → 決済フォーム表示 → 確定。
  // 冪等キーは「この申込み」に紐づける。セッション単位で1本にすると、同じタブで
  // 日程を選び直したときに前の予約のキーを使い回してしまい、サーバが別物と判断して
  // 弾く（以前は前の予約の決済がそのまま返り、違う日程・違う金額で決済が成立していた）。
  const bookingKeyName = `yah_book_key:${prop}_${checkin}_${checkout}_${guests}`;
  let idempotencyKey = sessionStorage.getItem(bookingKeyName);
  if (!idempotencyKey) {
    idempotencyKey = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now() + Math.random()));
    sessionStorage.setItem(bookingKeyName, idempotencyKey);
  }
  sessionStorage.removeItem("yah_book_key");   // 旧方式の残骸を掃除する
  let stripe = null, elements = null, clientSecret = null, currentUser = null;
  // 予約開始時のサーバー再検証で金額が動いた場合、一度提示して再同意を得る（v4 §4）
  let displayedTotal = null, priceAcknowledged = false;
  let bookingIdForComplete = "";

  const sync = () => {
    const ok = $("cf-rules").checked && $("cf-name").value.trim() && $("cf-phone").value.trim();
    $("co-pay-btn").disabled = !ok;
  };
  ["cf-rules", "cf-name", "cf-phone"].forEach((id) => {
    $(id).addEventListener("input", sync);
    $(id).addEventListener("change", sync);
  });

  async function loadStripe() {
    if (window.Stripe) return window.Stripe(STRIPE_PK);
    await new Promise((resolve, reject) => {
      const el = document.createElement("script");
      el.src = "https://js.stripe.com/v3/";
      el.onload = resolve;
      el.onerror = reject;
      document.head.appendChild(el);
    });
    return window.Stripe(STRIPE_PK);
  }

  // 決済まで到達せずに離脱した場合を記録（保留時間の把握・v4 §10）
  let reachedPayment = false;
  window.addEventListener("pagehide", () => {
    if (!reachedPayment && clientSecret) {
      track("booking_draft_abandoned", { prop, seconds: elapsed() });
    }
  });

  $("co-pay-btn").addEventListener("click", async () => {
    const btn = $("co-pay-btn");
    btn.disabled = true;

    // 2回目以降のクリック=決済確定
    if (clientSecret && elements) {
      $("co-pay-status").textContent = uiStrings.paying;
      track("payment_started", { prop, seconds: elapsed() });
      const { error } = await stripe.confirmPayment({
        elements,
        confirmParams: { return_url: `${location.origin}${BOOK_PATH}complete/?id=${encodeURIComponent(bookingIdForComplete)}` },
        redirect: "if_required",
      });
      if (error) {
        track("payment_failed", { prop, error_type: String(error.code ?? error.type ?? "unknown"), seconds: elapsed() });
        $("co-pay-status").textContent = error.message || uiStrings.payFailed;
        btn.disabled = false;
      } else {
        // 予約の確定はサーバー側（Webhook起点）。ここは「オーソリ完了」の到達点として計測する。
        reachedPayment = true;
        track("payment_authorized", {
          prop, seconds: elapsed(),
          auth_provider: currentUser?.providerData?.[0]?.providerId === "google.com" ? "google" : "email_link",
        });
        sessionStorage.removeItem("yah_book_key");
        $("co-pay-status").textContent = uiStrings.paid;
        // 確定待ちは完了ページで行う（離脱防止のため戻れないよう replace）
        location.replace(`${BOOK_PATH}complete/?id=${encodeURIComponent(bookingIdForComplete)}`);
      }
      return;
    }

    // 初回=予約作成 + PaymentIntent
    $("co-pay-status").textContent = uiStrings.preparing;
    track("booking_draft_started", { prop, seconds: elapsed() });
    try {
      const token = await currentUser.getIdToken();
      const r = await fetch(BOOK_CREATE_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({
          prop, checkin, checkout, guests, lang, idempotencyKey,
          // 購買行動の突合用（個人情報ではない）
          clientId: await gaClientId(),
          sessionId: await gaSessionId(),
          gclid: new URLSearchParams(location.search).get("gclid") || sessionStorage.getItem("yah_gclid") || "",
          utm: {
            source: sessionStorage.getItem("yah_utm_source") || "",
            medium: sessionStorage.getItem("yah_utm_medium") || "",
            campaign: sessionStorage.getItem("yah_utm_campaign") || "",
          },
          authProvider: currentUser?.providerData?.[0]?.providerId === "google.com" ? "google" : "email_link",
          name: $("cf-name").value.trim(),
          phone: `${$("cf-cc").value}${$("cf-phone").value.trim().replace(/^0/, "")}`,
          leadGuest: $("cf-lead").value.trim(),
          arrival: $("cf-arrival").value,
          rulesAccepted: $("cf-rules").checked,
          termsVersion: TERMS_VERSION,
          marketingOptIn: $("cf-marketing").checked,
        }),
      });
      const j = await r.json();
      if (!j.ok || !j.clientSecret) {
        track("inventory_revalidated", {
          success: false, price_changed: false, availability_changed: j.error === "unavailable",
        });
        track("booking_draft_failed", { prop, error_type: String(j.error ?? "unknown"), seconds: elapsed() });
        // 受付の可否は理由を出す（「失敗しました」で終わらせない）
        const ERRS = { unavailable: uiStrings.soldOut, over_capacity: uiStrings.errOverCapacity,
          too_late: uiStrings.errTooLate, too_far: uiStrings.errTooFar,
          // 同じキーで別内容が来た＝古いキーが残っている。捨てて押し直せば通る
          idempotency_conflict: uiStrings.payFailed };
        if (j.error === "idempotency_conflict") sessionStorage.removeItem(bookingKeyName);
        $("co-pay-status").textContent = ERRS[j.error] ?? uiStrings.payFailed;
        btn.disabled = false;
        return;
      }
      const priceChanged = typeof j.total === "number" && displayedTotal !== null && j.total !== displayedTotal;
      track("inventory_revalidated", { success: true, price_changed: priceChanged, availability_changed: false });
      if (priceChanged && !priceAcknowledged) {
        // 表示と違う金額で決済に進ませない。更新して提示し、もう一度押してもらう。
        priceAcknowledged = true;
        displayedTotal = j.total;
        $("co-total").textContent = yen(j.total);
        renderBreakdown(j.total);
        if (uiStrings.fxCode !== "JPY") {
          $("co-fx").textContent = `${uiStrings.approx} ${uiStrings.fxSymbol}${Math.round(j.total * uiStrings.fxRate).toLocaleString("en-US")}`;
        }
        $("co-final").textContent = `${meta.name}　${fmtDate(checkin)} 〜 ${fmtDate(checkout)}　${uiStrings.nightsGuests.replace("{n}", nights).replace("{g}", guests)}　${uiStrings.total} ${yen(j.total)}`;
        $("co-pay-status").textContent = uiStrings.priceChanged;
        btn.disabled = false;
        return;
      }
      clientSecret = j.clientSecret;
      bookingIdForComplete = j.bookingId || "";
      stripe = await loadStripe();
      elements = stripe.elements({ clientSecret, appearance: { theme: "stripe", variables: { colorPrimary: "#111111", borderRadius: "4px" } } });
      elements.create("payment").mount("#co-payment-element");
      window.gtag?.("event", "add_payment_info", {
        currency: "JPY", value: j.total, lang,
        items: [{ item_id: prop, item_name: `yah.homes ${prop}`, price: j.total, quantity: 1 }],
      });
      track("payment_form_shown", { prop, seconds: elapsed() });
      $("co-payment-element").hidden = false;
      setStep(3);
      $("co-pay-status").textContent = "";
      btn.disabled = false;
    } catch (err) {
      $("co-pay-status").textContent = uiStrings.payFailed;
      btn.disabled = false;
    }
  });
</script>

