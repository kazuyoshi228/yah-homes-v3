---
/* /book/checkout — 予約の「確定」ページ（design_booking_p1_v4.md §3〜5・MS3）
   構成はBooking.comの2カラム（左=予約サマリ固定／右=入力ステップ）を参考に、ブランド準拠のモノクロームで再構成。
   現段階: 認証・入力・同意・最終確認まで。Stripe決済の結線はMS3で追加（ボタンは無効表示）。
   公開ガード: BOOK_PREVIEW=1 のときのみ生成・noindex。 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { LOCALES, localeParam, localizedPath, type Locale } from "../../../i18n/config";
import { BOOK_STRINGS, FX_PER_JPY } from "../../../i18n/bookStrings";
import { PROPERTIES } from "../../../data/properties";

export const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";

export function getStaticPaths() {
  if (!BOOK_PREVIEW) return [];
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { lang: locale as Locale },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const t = BOOK_STRINGS[lang];

const AVAIL_ENDPOINT = "https://asia-northeast1-yah-homes.cloudfunctions.net/bookingApi";
const BOOK_PATH = localizedPath(lang, "/book");
const FB_CONFIG = {
  apiKey: "AIzaSyBgHbTL5caL-itDIFTlSZNMPeHNsSnwEDs",
  authDomain: "yah-homes.firebaseapp.com",
  projectId: "yah-homes",
  appId: "1:18500698213:web:8b4cf08b97d916c216068c",
};

const HOUSE_META = {
  kiyokawa: { name: "yah.homes kiyokawa", image: PROPERTIES.kiyokawa.exterior, capacity: 8 },
  takasago: { name: "yah.homes takasago", image: PROPERTIES.takasago.exterior, capacity: 6 },
};

// 画面文言（5言語）
const C = {
