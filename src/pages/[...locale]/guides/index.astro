---
/* ガイド一覧（/guides/）— 記事系の入口。map系の /locals とは役割を分ける */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { LOCALES, localeParam, localizedPath, type Locale } from "../../../i18n/config";
import { getGuides, GUIDES_PREVIEW } from "../../../lib/guides";
import { translations } from "../../../i18n/translations";
import { BASE_URL, breadcrumbJsonLd } from "../../../lib/seo";
import { guidesIndexMeta } from "../../../i18n/pageStrings";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { lang: locale as Locale },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const guides = (await getGuides()).filter((g) => g.translations[lang]);

const META = guidesIndexMeta;
const m = META[lang];
const noindex = GUIDES_PREVIEW || guides.length === 0;
const breadcrumb = breadcrumbJsonLd([
  { name: translations[lang].nav.home, url: `${BASE_URL}${localizedPath(lang, "/")}` },
  { name: translations[lang].nav.guides, url: `${BASE_URL}${localizedPath(lang, "/guides")}` },
]);
---

<SiteLayout lang={lang} path="/guides" title={m.title} description={m.description} jsonLd={breadcrumb} noindex={noindex} solidNav>
  <section class="gl">
    <div class="gl-container">
      <p class="gl-eyebrow">Guides</p>
      <h1 class="gl-heading">{m.heading}</h1>

      {guides.length === 0 && <p class="gl-empty">{m.empty}</p>}

      <div class="gl-list">
        {
          guides.map((g) => {
            const t = g.translations[lang]!;
            return (
              <a href={localizedPath(lang, `/guides/${g.slug}`)} class="gl-item">
                {g.thumbnailUrl && <img class="gl-item-thumb" src={g.thumbnailUrl} alt="" loading="lazy" />}
                <div class="gl-item-body">
                  <h2 class="gl-item-title">{t.title}</h2>
                  <p class="gl-item-excerpt">{t.excerpt}</p>
                  <p class="gl-item-meta">
                    {g.confirmedDate && <span>{g.confirmedDate}</span>}
                    <span class="gl-item-arrow" aria-hidden="true">
                      →
                    </span>
                  </p>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .gl {
    background: #ffffff;
    padding: 7rem 1.5rem 5rem;
    min-height: 70vh;
  }
  .gl-container {
    max-width: 720px;
    margin: 0 auto;
  }
  .gl-eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #666666;
    margin-bottom: 1rem;
  }
  .gl-heading {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    font-weight: 500;
    color: #111111;
    letter-spacing: -0.01em;
    margin-bottom: 2.5rem;
  }
  .gl-empty {
    font-size: 0.9rem;
    font-weight: 300;
    color: #666666;
  }
  .gl-list {
    display: flex;
    flex-direction: column;
  }
  .gl-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.75rem 0;
    border-top: 1px solid #eeeeee;
    text-decoration: none;
  }
  .gl-item:last-child {
    border-bottom: 1px solid #eeeeee;
  }
  .gl-item-thumb {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 4px;
  }
  .gl-item-body {
    flex: 1;
    min-width: 0;
  }
  .gl-item-title {
    font-size: 1.15rem;
    font-weight: 500;
    color: #111111;
    line-height: 1.5;
    margin-bottom: 0.5rem;
    transition: opacity 0.2s;
  }
  .gl-item:hover .gl-item-title {
    opacity: 0.6;
  }
  .gl-item-excerpt {
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.8;
    color: #666666;
    margin-bottom: 0.6rem;
  }
  .gl-item-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: #666666;
  }
</style>
