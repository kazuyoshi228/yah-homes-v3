---
/* 特定商取引法に基づく表記（通信販売）。日本法準拠のため本文は日本語。
   確定ファクト（登記情報）＋直販決済（Stripe・カード）とOTA経由の両方を明記する。
   電話番号は「請求に応じ遅滞なく開示」方式（design_booking_p1.md §14-6）。 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { LOCALES, localeParam, localizedPath, type Locale } from "../../../i18n/config";
import { translations } from "../../../i18n/translations";
import { OPERATOR, BASE_URL, breadcrumbJsonLd } from "../../../lib/seo";
import { lucide } from "../../../lib/lucide";
import { uiStrings } from "../../../i18n/uiStrings";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { lang: locale as Locale },
  }));
}

const { lang } = Astro.props as { lang: Locale };
const t = translations[lang];
const ui = uiStrings[lang];
const homeHref = localizedPath(lang, "/");
const contactHref = `${homeHref}#contact`;

const TITLE: Record<Locale, string> = {
  ja: "特定商取引法に基づく表記 | yah.homes",
  en: "Legal Notice (Act on Specified Commercial Transactions) | yah.homes",
  ko: "특정상거래법에 근거한 표기 | yah.homes",
  zh: "基於特定商業交易法之標示 | yah.homes",
  th: "ประกาศทางกฎหมาย | yah.homes",
};
const DESC: Record<Locale, string> = {
  ja: "yah.homes（運営：ボンファイア株式会社）の特定商取引法に基づく表記です。",
  en: "Legal notice under Japan's Act on Specified Commercial Transactions for yah.homes, operated by Bonfire Inc.",
  ko: "yah.homes(운영: 보ンファイア 주식회사)의 특정상거래법에 근거한 표기입니다.",
  zh: "yah.homes（營運：Bonfire Inc.）依日本特定商業交易法之標示。",
  th: "ประกาศทางกฎหมายของ yah.homes ดำเนินการโดย Bonfire Inc.",
};

// 見出しは訪問者の言語、本文（法定表記）は日本語で統一
const HEADING: Record<Locale, string> = {
  ja: "特定商取引法に基づく表記",
  en: "Legal Notice (Specified Commercial Transactions Act)",
  ko: "특정상거래법에 근거한 표기",
  zh: "基於特定商業交易法之標示",
  th: "ประกาศตามกฎหมายว่าด้วยการค้าเฉพาะ",
};
const NOTE: Record<Locale, string> = {
  ja: "",
  en: "The following is the statutory disclosure required under Japanese law, provided in Japanese.",
  ko: "다음은 일본 법률에 따라 요구되는 법정 표기이며 일본어로 제공됩니다.",
  zh: "以下為日本法律要求之法定標示，以日文提供。",
  th: "ต่อไปนี้คือข้อมูลตามกฎหมายญี่ปุ่น จัดทำเป็นภาษาญี่ปุ่น",
};

const ROWS: { k: string; v: string }[] = [
  { k: "販売事業者", v: "ボンファイア株式会社（Bonfire Inc.）" },
  { k: "運営統括責任者", v: "山田一慶" },
  { k: "所在地", v: OPERATOR.addressJa },
  { k: "法人番号", v: OPERATOR.corporateNumber },
  { k: "電話番号", v: "お客様からのご請求があれば、遅滞なく開示いたします。お問い合わせフォームよりご連絡ください。" },
  { k: "お問い合わせ", v: "本サイトのお問い合わせフォームより承ります（通常2〜3営業日以内にご返信）。" },
  { k: "販売価格", v: "各物件ページおよびご予約時に表示します。ご予約手続きの各画面で総額（消費税込）を表示します。" },
  {
    k: "商品代金以外に必要な料金",
    v: "ありません。表示する総額に、宿泊料・宿泊税・清掃料を含みます。現地でのお支払いは発生しません。通信料等はお客様のご負担となります。",
  },
  {
    k: "お支払い方法",
    v: "本サイトからのご予約：クレジットカード（Visa・Mastercard・American Express・JCB 等）。決済は Stripe, Inc. の決済システムを利用し、カード情報は当社では保持しません。／ Airbnb・Booking.com 経由のご予約：各プラットフォームの定めによります。",
  },
  {
    k: "お支払い時期",
    v: "本サイトからのご予約：ご予約手続きの完了時に、カードへのお支払いが確定します（ご予約確定と同時）。／ Airbnb・Booking.com 経由のご予約：各プラットフォームの定めによります。",
  },
  { k: "役務の提供時期", v: "ご予約いただいた宿泊日に、宿泊施設をご利用いただけます。チェックイン・チェックアウトの時刻は、ご予約時および確定メールに表示します。" },
  {
    k: "キャンセル・返金",
    v: "本サイトからのご予約：チェックイン日の8日前まで無料でキャンセルいただけます（期限は日本時間。ご予約時および確定メールに具体的な日時を表示します）。期限を過ぎたキャンセル、および無連絡不泊の場合は、宿泊料金の全額をキャンセル料として申し受けます。無料期間内のキャンセルは全額を返金し、決済されたカードへ返金処理を行います（カード会社の処理により、ご返金の反映まで数日から1か月程度かかる場合があります）。／ Airbnb・Booking.com 経由のご予約：各プラットフォームの定めによります。",
  },
  {
    k: "キャンセルのお申し出方法",
    v: "My Page（ご予約時のアカウントでログイン）またはお問い合わせフォームより承ります。確定メールに記載のご連絡先へご返信いただく方法でも受け付けます。",
  },
  {
    k: "役務の性質による特記事項",
    v: "宿泊サービスは特定商取引法上の通信販売にあたり、クーリング・オフ制度の適用対象外です。キャンセルの取扱いは上記のとおりです。",
  },
  { k: "動作環境", v: "最新版の Google Chrome・Safari・Microsoft Edge・Firefox。JavaScript および Cookie を有効にしてご利用ください。" },
  { k: "宿泊者名簿", v: "旅館業法に基づき、宿泊者の氏名・住所・連絡先等をご記入いただきます。取得した情報の取扱いはプライバシーポリシーに従います。" },
];

const breadcrumb = breadcrumbJsonLd([
  { name: t.nav.home, url: `${BASE_URL}${homeHref}` },
  { name: HEADING[lang], url: `${BASE_URL}${localizedPath(lang, "/legal/tokushoho")}` },
]);
---

<SiteLayout
  lang={lang}
  path="/legal/tokushoho"
  title={TITLE[lang]}
  description={DESC[lang]}
  jsonLd={breadcrumb}
  solidNav
>
  <section class="legal">
    <div class="legal-inner">
      <p class="legal-eyebrow">Legal</p>
      <h1 class="legal-title">{HEADING[lang]}</h1>
      {NOTE[lang] && <p class="legal-note">{NOTE[lang]}</p>}

      <dl class="legal-dl">
        {ROWS.map((row) => (
          <div class="legal-row">
            <dt>{row.k}</dt>
            <dd>{row.v}</dd>
          </div>
        ))}
      </dl>

      <p class="legal-back">
        <a href={homeHref} class="legal-back-link">
          <Fragment set:html={lucide("chevronLeft", { size: 14, strokeWidth: 2.5 })} />
          {ui.backToHome}
        </a>
      </p>
    </div>
  </section>
</SiteLayout>

<style>
  .legal {
    background: #ffffff;
    padding: 7rem 1.5rem 5rem;
    min-height: 70vh;
  }
  .legal-inner {
    max-width: 680px;
    margin: 0 auto;
  }
  .legal-eyebrow {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #666666;
    margin-bottom: 1rem;
  }
  .legal-title {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: 500;
    color: #111111;
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }
  .legal-note {
    font-size: 0.8rem;
    color: #666666;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .legal-dl {
    margin: 2rem 0 0;
  }
  .legal-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 1.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid #f2f2f2;
  }
  .legal-row dt {
    font-size: 0.85rem;
    font-weight: 500;
    color: #666666;
  }
  .legal-row dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.8;
    color: #222222;
  }
  @media (max-width: 560px) {
    .legal-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
  .legal-back {
    margin-top: 3rem;
  }
  .legal-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: #555555;
    text-decoration: none;
  }
  .legal-back-link:hover {
    color: #111111;
  }
</style>
