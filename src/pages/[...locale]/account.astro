<SiteLayout
  lang={lang}
  path="/account"
  title={`${A.title} | yah.homes`}
  description={A.lead}
  noindex={true}
  solidNav
>
  <section class="ac">
    <div class="ac-container">
      <h1 class="ac-title">{A.title}</h1>
      <p class="ac-lead">{A.lead}</p>

      <!-- 未ログイン: 予約が無い状態として見せ、ログインを促す（C案） -->
      <div class="ac-signin" id="ac-signin" hidden>
        <p class="ac-empty">{A.empty}</p>
        <p class="ac-signin-lead">{A.signInLead}</p>
        <button type="button" class="ac-btn" id="ac-google">{A.signIn}</button>
        <div class="ac-sep"><span>or</span></div>
        <div class="ac-emailrow">
          <input id="ac-email" type="email" placeholder="your@email.com" maxlength="320" />
          <button type="button" class="ac-btn-sub" id="ac-email-send">{A.signInEmail}</button>
        </div>
        <p class="ac-status" id="ac-signin-status"></p>
      </div>

      <!-- ログイン後 -->
      <div id="ac-app" hidden>
        <div class="ac-bar">
          <span class="ac-user" id="ac-user"></span>
          <button type="button" class="ac-link" id="ac-signout">{A.signOut}</button>
        </div>

        <nav class="ac-tabs" role="tablist">
          <button type="button" class="ac-tab is-active" data-tab="bookings">{A.tabBookings}</button>
          <button type="button" class="ac-tab" data-tab="messages">
            {A.tabMessages}<span class="ac-badge" id="ac-badge" hidden></span>
          </button>
          <button type="button" class="ac-tab" data-tab="profile">{A.tabProfile}</button>
        </nav>

        <div id="ac-list" data-panel="bookings"></div>

        <div data-panel="messages" hidden>
          <div class="ac-mx" id="ac-mx">
            <aside class="ac-mx-list" id="ac-msg-picker"></aside>
            <section class="ac-mx-conv">
              <div class="ac-conv-head" id="ac-conv-head" hidden></div>
              <p class="ac-status ac-mx-pick" id="ac-msg-pick">{A.msgPick}</p>
              <div class="ac-thread" id="ac-thread"></div>
              <div class="ac-compose" id="ac-compose" hidden>
                <textarea id="ac-msg-input" rows="2" maxlength="2000" placeholder={A.msgPlaceholder}></textarea>
                <button type="button" class="ac-btn" id="ac-msg-send">{A.msgSend}</button>
              </div>
              <p class="ac-status" id="ac-msg-status"></p>
            </section>
            <aside class="ac-mx-booking" id="ac-mx-booking" hidden></aside>
          </div>
        </div>

        <div data-panel="profile" hidden>
          <p class="ac-panel-note">{A.profLead} {A.profOptional}</p>
          <div class="ac-photo">
            <div class="ac-avatar" id="pf-avatar"></div>
            <div class="ac-photo-acts">
              <p class="ac-photo-title">{A.photoTitle}</p>
              <label class="ac-outline ac-photo-pick">
                {A.photoPick}
                <input type="file" id="pf-file" accept="image/*" hidden />
              </label>
              <button type="button" class="ac-link ac-photo-del" id="pf-photo-del" hidden>{A.photoRemove}</button>
            </div>
          </div>

          <div class="ac-crop" id="pf-crop" hidden>
            <div class="ac-crop-box">
              <p class="ac-crop-title">{A.photoCropTitle}</p>
              <div class="ac-crop-stage" id="pf-stage">
                <canvas id="pf-canvas" width="256" height="256"></canvas>
              </div>
              <label class="ac-crop-zoom">{A.photoZoom}
                <input type="range" id="pf-zoom" min="100" max="300" value="100" />
              </label>
              <div class="ac-crop-acts">
                <button type="button" class="ac-link" id="pf-crop-cancel">{A.photoCancel}</button>
                <button type="button" class="ac-btn" id="pf-crop-ok">{A.photoOk}</button>
              </div>
            </div>
          </div>

          <div class="ac-form">
            <label>{A.profNameJa}<input id="pf-nameJa" type="text" maxlength="60" /></label>
            <label>{A.profNameRoman}<input id="pf-nameRoman" type="text" maxlength="60" /></label>
            <label>{A.profEmail}<input id="pf-email" type="email" disabled /><span class="ac-hint">{A.profEmailNote}</span></label>
            <label>{A.profPhone}
              <span class="ac-phone">
                <select id="pf-phoneCc">
                  {PHONE_CC.map((o) => <option value={o.c}>{o.c}　{o.n}</option>)}
                </select>
                <input id="pf-phone" type="tel" maxlength="30" inputmode="tel" />
              </span>
            </label>
            <label>{A.profCountry}<input id="pf-country" type="text" maxlength="60" /></label>
            <label>{A.profBirthday}<input id="pf-birthday" type="date" /></label>
            <label>{A.profLang}
              <select id="pf-lang">
                <option value="ja">日本語</option><option value="en">English</option>
                <option value="ko">한국어</option><option value="zh">繁體中文</option><option value="th">ไทย</option>
              </select>
            </label>
          </div>
          <button type="button" class="ac-btn" id="pf-save">{A.profSave}</button>
          <p class="ac-status" id="pf-status"></p>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ ACCOUNT_ENDPOINT, MESSAGES_ENDPOINT, BOOK_PATH, FB_CONFIG, uiA, lang }}>
  const $ = (id) => document.getElementById(id);
  const esc = (x) => String(x ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const yen = (n) => `¥${Number(n).toLocaleString("en-US")}`;
  const todayKey = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" });

  let auth = null;
  let cache = [];

  const statusLabel = (s) =>
    s === "CONFIRMED" ? uiA.statusConfirmed
    : s === "CANCELLED" ? uiA.statusCancelled
    : s === "PAYMENT_PENDING" ? uiA.statusUnpaid
    : uiA.statusProcessing;

  const ARRIVALS = ["15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"];
  const LOC = { en: "en-US", ja: "ja-JP", ko: "ko-KR", zh: "zh-TW", th: "th-TH" }[lang];
  const shortDate = (d) => new Date(`${d}T00:00:00`).toLocaleDateString(LOC, { month: "short", day: "numeric" });
  const nightsOf = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 86400000);

  // 予約確認メールと同じ項目立て・同じ順序で組む（ご予約内容／キャンセル料／お支払い）
  const rows = (list) => `<table class="ac-rows">${list.filter(Boolean).map(([k, v, sub]) =>
    `<tr><th>${k}</th><td>${v}${sub ? `<span>${sub}</span>` : ""}</td></tr>`).join("")}</table>`;
  const panel = (title, inner, note) =>
    `<section class="ac-panel"><p class="ac-panel-title">${title}</p>${inner}${note ? `<p class="ac-panel-note">${note}</p>` : ""}</section>`;

  // キャンセル可否の判定（表示用。最終判定はサーバー時刻で行う）
  const canSelfCancel = (b) =>
    b.status === "CONFIRMED" && Date.parse(`${b.checkin}T00:00:00+09:00`) > Date.now();
  const withinFree = (b) => b.freeCancelUntilAt && Date.parse(b.freeCancelUntilAt) > Date.now();

  function cancelBlock(b) {
    if (b.status === "CANCELLED") return "";
    if (!canSelfCancel(b)) {
      // チェックイン当日・滞在中・手続き中は問い合わせのみ（決定事項④）
      return `
        <div class="ac-block">
          <p class="ac-block-title">${uiA.cancel}</p>
          <p class="ac-note">${uiA.cancelSoon}</p>
        </div>
        <div class="ac-block">
          <p class="ac-block-title">${uiA.change}</p>
          <p class="ac-note">${uiA.changeNote}</p>
          <button type="button" class="ac-outline ac-tomsg" data-tomsg="${esc(b.id)}">${uiA.msgCardBtn}</button>
        </div>`;
    }
    const free = withinFree(b);
    const info = free
      ? uiA.cancelFreeUntil.replace("{d}", String(b.freeCancelUntilAt).slice(0, 10))
      : uiA.cancelFeeNow.replace("{a}", yen(b.total));
    return `
      <div class="ac-block">
        <p class="ac-block-title">${uiA.cancel}</p>
        <p class="ac-note">${info}</p>
        <button type="button" class="ac-outline ac-cancel-open" data-cancel="${esc(b.id)}">
          ${free ? uiA.cancelBtn : uiA.cancelBtnAfter}
        </button>
        <span class="ac-cancel-msg" data-cancelmsg="${esc(b.id)}"></span>
      </div>
      <div class="ac-block">
        <p class="ac-block-title">${uiA.change}</p>
        <p class="ac-note">${uiA.changeNote}</p>
        <button type="button" class="ac-outline ac-tomsg" data-tomsg="${esc(b.id)}">${uiA.msgCardBtn}</button>
      </div>`;
  }

  // 確認ダイアログ（返金額を明示してから実行・二重の確認）
  function openCancelDialog(b) {
    const free = withinFree(b);
    const refund = free ? b.total : 0;
    const dlg = document.createElement("div");
    dlg.className = "ac-modal";
    dlg.innerHTML = `
      <div class="ac-modal-box" role="dialog" aria-modal="true">
        <p class="ac-modal-title">${uiA.confirmTitle}</p>
        <p class="ac-modal-sub">${esc(uiA.houses[b.prop] ?? b.prop)}<br>${esc(b.checkin)} 〜 ${esc(b.checkout)}</p>
        <table class="ac-modal-rows">
          <tr><th>${uiA.confirmPaid}</th><td>${yen(b.total)}</td></tr>
          <tr><th>${uiA.confirmFee}</th><td>${yen(b.total - refund)}</td></tr>
          <tr class="ac-modal-total"><th>${uiA.confirmRefund}</th><td>${yen(refund)}</td></tr>
        </table>
        <p class="ac-modal-note">${free ? uiA.confirmRefundNote : uiA.confirmNoRefundNote}</p>
        <label class="ac-modal-reason">
          <span>${uiA.reasonLabel}</span>
          <textarea id="ac-reason" rows="2" maxlength="500"></textarea>
        </label>
        <div class="ac-modal-actions">
          <button type="button" class="ac-modal-no" id="ac-cancel-no">${uiA.confirmNo}</button>
          <button type="button" class="ac-modal-yes" id="ac-cancel-yes">${free ? uiA.confirmYes : uiA.cancelBtnAfter}</button>
        </div>
        <p class="ac-modal-status" id="ac-modal-status"></p>
      </div>`;
    document.body.appendChild(dlg);
    const close = () => dlg.remove();
    dlg.addEventListener("click", (e) => { if (e.target === dlg) close(); });
    dlg.querySelector("#ac-cancel-no").addEventListener("click", close);
    dlg.querySelector("#ac-cancel-yes").addEventListener("click", async () => {
      const yes = dlg.querySelector("#ac-cancel-yes");
      yes.disabled = true;
      dlg.querySelector("#ac-modal-status").textContent = uiA.cancelBusy;
      window.gtag?.("event", "cancel_confirmed", { prop: b.prop, within_free: free, lang });
      const r = await api("POST", { action: "cancel", bookingId: b.id, reason: dlg.querySelector("#ac-reason").value });
      if (r.ok) {
        close();
        load();
      } else {
        window.gtag?.("event", "cancel_failed", { prop: b.prop, error_type: String(r.error ?? "unknown"), lang });
        dlg.querySelector("#ac-modal-status").textContent = uiA.cancelFail;
        yes.disabled = false;
      }
    });
  }

  function card(b) {
    const house = uiA.houses[b.prop] ?? b.prop;
    const image = uiA.images[b.prop] ?? "";
    const place = uiA.places[b.prop] ?? { address: "", map: "" };
    const tm = uiA.times[b.prop] ?? { ci: "", co: "" };
    const nights = nightsOf(b.checkin, b.checkout);
    const no = esc(b.id).slice(0, 8).toUpperCase();
    const freeDate = b.freeCancelUntilAt ? String(b.freeCancelUntilAt).slice(0, 10) : "";
    const opts = [`<option value="">${uiA.arrivalAny}</option>`]
      .concat(ARRIVALS.map((h) => `<option value="${h}"${b.arrival === h ? " selected" : ""}>${h}〜</option>`))
      .concat([`<option value="24:00+"${b.arrival === "24:00+" ? " selected" : ""}>${uiA.arrivalLate}</option>`])
      .join("");

    return `
      <article class="ac-card" data-s="${esc(b.status)}">
        <header class="ac-bar">
          <span class="ac-bar-house">${esc(house)}</span>
          <span class="ac-bar-right">
            <span class="ac-bar-no">${uiA.bookingNo}<strong>${no}</strong></span>
            <span class="ac-badge" data-s="${esc(b.status)}">${statusLabel(b.status)}</span>
          </span>
        </header>

        <div class="ac-body">
          ${image ? `<img class="ac-hero" src="${esc(image)}" alt="${esc(house)}" loading="lazy" />` : ""}
          ${panel(uiA.detailTitle, rows([
            [uiA.house, esc(house)],
            [uiA.checkin, esc(b.checkin), uiA.checkinWindow.replace("{ci}", tm.ci)],
            [uiA.checkout, esc(b.checkout), uiA.checkoutWindow.replace("{co}", tm.co)],
            [uiA.stay, uiA.nightsUnit.replace("{n}", nights)],
            [uiA.guestsRow, uiA.guestsUnit.replace("{g}", esc(b.guests))],
          ]))}

          ${freeDate ? panel(uiA.cancelFeeTitle, rows([
            [uiA.cancelFreeRow.replace("{d}", freeDate), yen(0)],
            [uiA.cancelAfterRow.replace("{d}", freeDate), yen(b.total)],
          ]), uiA.cancelNote) : ""}

          ${b.status === "PAYMENT_PENDING"
            ? panel(uiA.payTitle, rows([
                [uiA.payTotal, yen(b.total)],
                [uiA.payUnpaidRow, yen(0)],
              ]), uiA.payUnpaidNote) +
              `<p class="ac-resume"><a class="ac-btn" href="${esc(uiA.resumePath)}?prop=${esc(b.prop)}&checkin=${esc(b.checkin)}&checkout=${esc(b.checkout)}&guests=${esc(String(b.guests))}">${uiA.payResume}</a></p>`
            : panel(uiA.payTitle, rows([
                [uiA.payTotal, yen(b.total)],
                [uiA.payPaid, yen(b.total)],
                [uiA.payOnSite, yen(0)],
              ]), uiA.payNote)}

          <section class="ac-panel">
            <p class="ac-panel-title">${uiA.arrival}</p>
            <div class="ac-arrival">
              <select data-arrival="${esc(b.id)}">${opts}</select>
              <button type="button" class="ac-btn-sub" data-savearrival="${esc(b.id)}">${uiA.arrivalSave}</button>
              <span class="ac-saved" data-saved="${esc(b.id)}"></span>
            </div>
            <p class="ac-panel-note">${uiA.arrivalNote}</p>
          </section>

          <div class="ac-block">
            <p class="ac-block-title">${uiA.checkinInfo}</p>
            <p class="ac-note">${uiA.checkinSoon}</p>
          </div>

          ${place.map ? `
          <div class="ac-block">
            <p class="ac-block-title">${uiA.placeTitle}</p>
            <p class="ac-note">${place.address ? `<strong>${esc(place.address)}</strong>` : uiA.placeNote}</p>
            <a class="ac-outline" href="${esc(place.map)}" target="_blank" rel="noopener noreferrer">${uiA.placeBtn}</a>
          </div>` : ""}

          ${b.status !== "CANCELLED" ? `
          <div class="ac-block">
            <p class="ac-block-title">${uiA.msgCardTitle}</p>
            <p class="ac-note">${uiA.msgCardNote}</p>
            <button type="button" class="ac-outline ac-tomsg" data-tomsg="${esc(b.id)}">${uiA.msgCardBtn}</button>
          </div>` : ""}

          ${b.status === "CONFIRMED" ? `
          <div class="ac-block">
            <p class="ac-block-title">${uiA.urgentTitle}</p>
            <p class="ac-note">${uiA.urgentNote}</p>
            <a class="ac-tel" href="tel:+815017214419">050-1721-4419</a>
          </div>` : ""}

          ${cancelBlock(b)}
        </div>
      </article>`;
  }

  async function api(method, body) {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(ACCOUNT_ENDPOINT, {
      method,
      headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json();
  }

  async function load() {
    $("ac-list").innerHTML = `<p class="ac-status">${uiA.loading}</p>`;
    try {
      const j = await api("GET");
      if (!j.ok) throw new Error("load");
      const items = j.items || [];
      cache = items;
      if (!items.length) {
        $("ac-list").innerHTML = `<p class="ac-status">${uiA.empty}</p><a class="ac-btn" href="${BOOK_PATH}">${esc(uiA.emptyCta ?? "")}</a>`;
        return;
      }
      const upcoming = items.filter((b) => b.checkout >= todayKey);
      const past = items.filter((b) => b.checkout < todayKey);
      $("ac-list").innerHTML =
        (upcoming.length ? `<h2 class="ac-h2">${uiA.upcoming}</h2>${upcoming.map(card).join("")}` : "") +
        (past.length ? `<h2 class="ac-h2">${uiA.past}</h2>${past.map(card).join("")}` : "");

      // 予約カードからメッセージタブへ。該当予約のスレッドを開いた状態にする
      document.querySelectorAll("[data-tomsg]").forEach((btn) =>
        btn.addEventListener("click", () => {
          showTab("messages");
          history.replaceState(null, "", "#messages");
          openThread(btn.dataset.tomsg);
          document.getElementById("ac-mx")?.scrollIntoView({ behavior: "smooth", block: "start" });
        })
      );

      document.querySelectorAll("[data-cancel]").forEach((btn) =>
        btn.addEventListener("click", () => {
          const b = (cache || []).find((x) => x.id === btn.dataset.cancel);
          if (!b) return;
          window.gtag?.("event", "cancel_started", { prop: b.prop, within_free: !!withinFree(b), lang });
          openCancelDialog(b);
        })
      );

      document.querySelectorAll("[data-savearrival]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          const id = btn.dataset.savearrival;
          const val = document.querySelector(`[data-arrival="${id}"]`).value;
          btn.disabled = true;
          const r = await api("POST", { action: "arrival", bookingId: id, arrival: val });
          document.querySelector(`[data-saved="${id}"]`).textContent = r.ok ? uiA.arrivalSaved : "";
          btn.disabled = false;
        })
      );
    } catch {
      $("ac-list").innerHTML = `<p class="ac-status">${uiA.error}</p>`;
    }
  }

  // ── メッセージ（Firestore を直接購読してリアルタイム表示。書き込みはAPI経由）──
  let fs = null, fsm = null, msgUnsub = null, threadUnsub = null, activeBooking = "";
  const threadMeta = {};   // bookingId → { unreadForGuest }

  function fmtTime(ts) {
    const d = ts?.toDate ? ts.toDate() : null;
    return d ? d.toLocaleString(lang === "en" ? "en-US" : "ja-JP", { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit" }) : "";
  }


  // srcdoc に流し込むためのエスケープ（属性値なので " と & を潰す）
  function escAttr(v) {
    return String(v).replace(/&/g, "&amp;").replace(/"/g, "&quot;");
  }
  // 中身の高さに合わせて iframe を伸ばす（スクロールバーを出さない）
  function fitFrames(root, onFit) {
    root.querySelectorAll("iframe[srcdoc]").forEach((f) => {
      if (f.dataset.fitted) return;
      f.dataset.fitted = "1";
      const fit = () => {
        try {
          const d = f.contentDocument;
          if (!d?.body) return;
          const h = Math.max(d.body.scrollHeight, d.documentElement.scrollHeight);
          if (h) { f.style.height = `${h + 8}px`; onFit?.(); }
        } catch { f.style.height = "1600px"; }   // 読めないときは長めに取る（切れるよりマシ）
      };
      // 画像が入る本文なので、読み込み完了の時点ではまだ高さが確定していない。
      // load → 画像1枚ごと → 本文の変化、の3段で追いかける。
      f.addEventListener("load", () => {
        fit();
        try {
          const d = f.contentDocument;
          d.querySelectorAll("img").forEach((im) => {
            if (!im.complete) { im.addEventListener("load", fit); im.addEventListener("error", fit); }
          });
          if (window.ResizeObserver) new ResizeObserver(fit).observe(d.body);
        } catch { /* 読めないときは load 時の値のままにする */ }
        [200, 800, 2000].forEach((ms) => setTimeout(fit, ms));   // 最後の保険
      });
      fit();
    });
  }

  function renderPicker() {
    const list = cache.filter((b) => b.status !== "CANCELLED")
      .sort((a, b) => {
        const ta = threadMeta[a.id]?.lastMessageAt?.toMillis?.() || 0;
        const tb = threadMeta[b.id]?.lastMessageAt?.toMillis?.() || 0;
        return tb - ta;
      });
    $("ac-msg-picker").innerHTML = list.length ? list.map((b) => {
      const t = threadMeta[b.id] || {};
      const un = t.unreadForGuest || 0;
      return `<button type="button" class="ac-row${b.id === activeBooking ? " is-active" : ""}" data-pick="${esc(b.id)}">
        <span class="ac-row-top">
          <span class="ac-row-name">${un ? '<span class="ac-row-dot"></span>' : ""}${esc(uiA.houses[b.prop] || b.prop)}</span>
          <span class="ac-row-time">${fmtTime(t.lastMessageAt)}</span>
        </span>
        <span class="ac-row-date">${esc(b.checkin)} — ${esc(b.checkout)}</span>
        <span class="ac-row-no">${esc(b.id.slice(0, 8).toUpperCase())}</span>
        <span class="ac-row-snip">${t.lastBody ? `${esc(t.lastSystem ? uiA.msgAuto : t.lastFrom === "guest" ? uiA.msgYou : uiA.msgHost)}: ${esc(t.lastBody)}` : ""}</span>
      </button>`;
    }).join("") : `<p class="ac-status">${uiA.msgNone}</p>`;
    document.querySelectorAll("[data-pick]").forEach((el) =>
      el.addEventListener("click", () => openThread(el.dataset.pick)));
    const total = Object.values(threadMeta).reduce((n, t) => n + (t.unreadForGuest || 0), 0);
    const badge = $("ac-badge");
    badge.hidden = !total; badge.textContent = String(total);
  }

  async function watchThreads(uid) {
    if (!fs) {
      fsm = await import("https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js");
      fs = fsm.getFirestore();
    }
    if (threadUnsub) threadUnsub();
    const q = fsm.query(fsm.collection(fs, "threads"), fsm.where("uid", "==", uid));
    threadUnsub = fsm.onSnapshot(q, (snap) => {
      snap.forEach((d) => { threadMeta[d.id] = d.data(); });
      renderPicker();
    }, () => { /* 権限エラー等は黙って無視（メッセージ無しとして扱う） */ });
  }

  /* Airbnb の「予約を表示」と同じ。会話の右に、いま話している予約の要点を出す。
     操作（キャンセル等）はここに複製せず、予約タブへ1リンクで送る（正本を2枚にしない）。 */
  let bookingPanelOpen = false;
  function toggleBookingPanel() {
    bookingPanelOpen = !bookingPanelOpen;
    const el = $("ac-mx-booking");
    el.hidden = !bookingPanelOpen;
    $("ac-mx").classList.toggle("has-booking", bookingPanelOpen);
    const btn = document.getElementById("ac-conv-booking");
    if (btn) btn.textContent = bookingPanelOpen ? uiA.msgHideBooking : uiA.msgShowBooking;
  }
  function renderBookingPanel(bookingId) {
    const b = cache.find((x) => x.id === bookingId);
    const el = $("ac-mx-booking");
    if (!b) { el.innerHTML = ""; return; }
    const t = uiA.times[b.prop] ?? {};
    const st = b.status === "CANCELLED" ? uiA.statusCancelled
      : b.status === "CONFIRMED" ? uiA.statusConfirmed
      : b.status === "PAYMENT_PENDING" ? uiA.statusUnpaid : uiA.statusProcessing;
    el.innerHTML = `
      ${uiA.images[b.prop] ? `<img class="ac-bp-img" src="${esc(uiA.images[b.prop])}" alt="" loading="lazy" />` : ""}
      <p class="ac-bp-name">${esc(uiA.houses[b.prop] || b.prop)}</p>
      <p class="ac-bp-status">${esc(st)}</p>
      <table class="ac-bp-table">
        <tr><th>${esc(uiA.checkin)}</th><td>${esc(b.checkin)}${t.ci ? `　${esc(t.ci)}〜` : ""}</td></tr>
        <tr><th>${esc(uiA.checkout)}</th><td>${esc(b.checkout)}${t.co ? `　〜${esc(t.co)}` : ""}</td></tr>
        <tr><th>${esc(uiA.guests)}</th><td>${esc(String(b.guests ?? ""))}</td></tr>
        <tr><th>${esc(uiA.payTotal)}</th><td>${yen(b.total)}</td></tr>
      </table>
      <button type="button" class="ac-outline ac-bp-open">${esc(uiA.msgBookingDetail)}</button>`;
    el.querySelector(".ac-bp-open").addEventListener("click", () => {
      showTab("bookings");
      history.replaceState(null, "", "#bookings");
    });
  }

  function goList() {
    $("ac-mx").classList.remove("is-open");
  }

  async function openThread(bookingId) {
    activeBooking = bookingId;
    renderPicker();
    $("ac-conv-head").hidden = false;
    $("ac-conv-head").innerHTML = `<button type="button" class="ac-conv-back" id="ac-conv-back">${esc(uiA.msgBack)}</button>
      <button type="button" class="ac-link ac-conv-booking" id="ac-conv-booking">${esc(uiA.msgShowBooking)}</button>`;
    $("ac-conv-back").addEventListener("click", goList);
    $("ac-conv-booking").addEventListener("click", toggleBookingPanel);
    renderBookingPanel(bookingId);
    $("ac-msg-pick").hidden = true;
    $("ac-mx").classList.add("is-open");
    $("ac-compose").hidden = false;
    if (msgUnsub) msgUnsub();
    const q = fsm.query(fsm.collection(fs, "threads", bookingId, "messages"), fsm.orderBy("at", "asc"));
    msgUnsub = fsm.onSnapshot(q, (snap) => {
      if (snap.empty) { $("ac-thread").innerHTML = `<p class="ac-status">${uiA.msgEmpty}</p>`; return; }
      $("ac-thread").innerHTML = snap.docs.map((d) => {
        const m = d.data();
        const mine = m.from === "guest";
        // 自動送信ぶんは控えとして残しているものなので、会話の吹き出しとは分けて見せる
        if (m.system) {
          const h = typeof m.html === "string" && m.html ? m.html : "";
          // メール本文はサーバが生成した HTML。iframe に閉じて、実際に届くものと
          // 同じ見た目で出す（表・ボタン・画像・余白がそのまま出る）。
          // sandbox に allow-scripts を与えないのでスクリプトは動かない。
          // allow-same-origin は高さの実測にだけ使う。リンクは別タブで開く。
          const frame = h
            ? `<iframe class="ac-sys-frame" scrolling="no" sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox" loading="lazy" srcdoc="${escAttr(`<base target="_blank"><style>html,body{margin:0;overflow:hidden}img{max-width:100%;height:auto}</style><div style="margin:0">${h}</div>`)}"></iframe>`
            : `<pre class="ac-sys-text">${esc(m.body)}</pre>`;
          return `<div class="ac-bub ac-bub-sys">
            <p class="ac-bub-meta">${esc(uiA.msgAuto)} ${fmtTime(m.at)}</p>
            <div class="ac-sys-body">
              ${m.title ? `<p class="ac-sys-title">${esc(m.title)}</p>` : ""}
              ${frame}
            </div>
          </div>`;
        }
        return `<div class="ac-bub ${mine ? "ac-bub-guest" : "ac-bub-host"}">
          <p class="ac-bub-meta">${mine ? esc(uiA.msgYou) : esc(uiA.msgHost)} ${fmtTime(m.at)}</p>
          <div class="ac-bub-body">${esc(m.body)}${m.translated ? `<div class="ac-bub-tr">${esc(m.translated)}</div>` : ""}</div>
        </div>`;
      }).join("");
      const tEl = $("ac-thread");
      const nearBottom = () => tEl.scrollHeight - tEl.scrollTop - tEl.clientHeight < 120;
      const pin = () => { tEl.scrollTop = tEl.scrollHeight; };
      pin();
      fitFrames(tEl, () => { if (nearBottom()) pin(); });
      pin();
    }, () => { $("ac-thread").innerHTML = `<p class="ac-status">${uiA.error}</p>`; });
    // 既読にする
    try {
      const token = await auth.currentUser.getIdToken();
      await fetch(MESSAGES_ENDPOINT, { method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ action: "read", bookingId, as: "guest" }) });
    } catch { /* 既読の失敗は表示に影響しない */ }
  }

  async function sendMessage() {
    const el = $("ac-msg-input"); const body = el.value.trim();
    if (!body || !activeBooking) return;
    const btn = $("ac-msg-send"); btn.disabled = true;
    $("ac-msg-status").textContent = uiA.msgSending;
    try {
      const token = await auth.currentUser.getIdToken();
      const r = await fetch(MESSAGES_ENDPOINT, { method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ action: "send", bookingId: activeBooking, body, as: "guest" }) });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error || "fail");
      el.value = ""; $("ac-msg-status").textContent = "";
    } catch { $("ac-msg-status").textContent = uiA.msgFail; }
    btn.disabled = false;
  }


  // ── プロフィール写真（丸く切り抜く）──
  // Storage は全 deny のまま触らない。256px の JPEG に縮めて Firestore に持たせる
  // （20KB前後。公開URLが生まれないので、本人と運営しか読めない既存のルールがそのまま効く）。
  let photoData = "";           // 保存済み or 決定済みの dataURL
  const cropState = { img: null, scale: 1, x: 0, y: 0, drag: null };

  function paintAvatar() {
    const el = $("pf-avatar");
    el.style.backgroundImage = photoData ? `url(${photoData})` : "";
    el.classList.toggle("is-empty", !photoData);
    $("pf-photo-del").hidden = !photoData;
  }

  function drawCrop() {
    const cv = $("pf-canvas"), ctx = cv.getContext("2d");
    const im = cropState.img;
    ctx.clearRect(0, 0, 256, 256);
    if (!im) return;
    // 短辺が 256 を満たす倍率を基準に、スライダーぶんだけ拡大する
    const base = 256 / Math.min(im.width, im.height);
    const sc = base * cropState.scale;
    const w = im.width * sc, h = im.height * sc;
    // はみ出し量の範囲に収める（余白が出ないように）
    cropState.x = Math.min(0, Math.max(256 - w, cropState.x));
    cropState.y = Math.min(0, Math.max(256 - h, cropState.y));
    ctx.drawImage(im, cropState.x, cropState.y, w, h);
  }

  function openCrop(file) {
    const fr = new FileReader();
    fr.onload = () => {
      const im = new Image();
      im.onload = () => {
        cropState.img = im; cropState.scale = 1;
        cropState.x = (256 - im.width * (256 / Math.min(im.width, im.height))) / 2;
        cropState.y = (256 - im.height * (256 / Math.min(im.width, im.height))) / 2;
        $("pf-zoom").value = "100";
        $("pf-crop").hidden = false;
        drawCrop();
      };
      im.onerror = () => { $("pf-status").textContent = uiA.photoTooBig; };
      im.src = fr.result;
    };
    fr.onerror = () => { $("pf-status").textContent = uiA.photoTooBig; };
    fr.readAsDataURL(file);
  }

  function bindPhoto() {
    $("pf-file").addEventListener("change", (e) => {
      const f = e.target.files?.[0];
      if (f) openCrop(f);
      e.target.value = "";   // 同じ写真をもう一度選べるように
    });
    $("pf-zoom").addEventListener("input", (e) => {
      const prev = cropState.scale;
      cropState.scale = Number(e.target.value) / 100;
      // 中心を保ったまま拡大する
      const k = cropState.scale / prev;
      cropState.x = 128 - (128 - cropState.x) * k;
      cropState.y = 128 - (128 - cropState.y) * k;
      drawCrop();
    });
    const stage = $("pf-stage");
    const start = (px, py) => { cropState.drag = { px, py }; };
    const move = (px, py) => {
      if (!cropState.drag) return;
      cropState.x += px - cropState.drag.px;
      cropState.y += py - cropState.drag.py;
      cropState.drag = { px, py };
      drawCrop();
    };
    const end = () => { cropState.drag = null; };
    stage.addEventListener("pointerdown", (e) => { stage.setPointerCapture(e.pointerId); start(e.clientX, e.clientY); });
    stage.addEventListener("pointermove", (e) => move(e.clientX, e.clientY));
    stage.addEventListener("pointerup", end);
    stage.addEventListener("pointercancel", end);

    $("pf-crop-cancel").addEventListener("click", () => { $("pf-crop").hidden = true; cropState.img = null; });
    $("pf-crop-ok").addEventListener("click", () => {
      photoData = $("pf-canvas").toDataURL("image/jpeg", 0.85);
      $("pf-crop").hidden = true; cropState.img = null;
      paintAvatar();
    });
    $("pf-photo-del").addEventListener("click", () => { photoData = ""; paintAvatar(); });
  }

  async function loadProfile(user) {
    $("pf-email").value = user.email || "";
    try {
      if (!fs) { fsm = await import("https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js"); fs = fsm.getFirestore(); }
      const d = await fsm.getDoc(fsm.doc(fs, "guest_profiles", user.uid));
      const v = d.exists() ? d.data() : {};
      $("pf-phoneCc").value = v.phoneCc || { ja: "+81", zh: "+886", ko: "+82", th: "+66" }[lang] || "+81";
      for (const k of ["nameJa", "nameRoman", "phone", "country", "birthday"]) {
        if (v[k]) $(`pf-${k}`).value = v[k];
      }
      $("pf-lang").value = v.lang || lang;
      photoData = typeof v.photo === "string" ? v.photo : "";
      paintAvatar();
    } catch { $("pf-lang").value = lang; paintAvatar(); }
  }

  async function saveProfile() {
    const btn = $("pf-save"); btn.disabled = true;
    $("pf-status").textContent = "";
    try {
      const token = await auth.currentUser.getIdToken();
      const profile = {
        nameJa: $("pf-nameJa").value, nameRoman: $("pf-nameRoman").value,
        phone: $("pf-phone").value, phoneCc: $("pf-phoneCc").value, country: $("pf-country").value,
        birthday: $("pf-birthday").value, lang: $("pf-lang").value,
        photo: photoData,
      };
      const r = await fetch(ACCOUNT_ENDPOINT, { method: "POST",
        headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ action: "profile", profile }) });
      const j = await r.json();
      $("pf-status").textContent = j.ok ? uiA.profSaved : uiA.error;
    } catch { $("pf-status").textContent = uiA.error; }
    btn.disabled = false;
  }

  function showTab(name) {
    document.querySelectorAll("[data-panel]").forEach((el) => { el.hidden = el.dataset.panel !== name; });
    document.querySelectorAll("[data-tab]").forEach((el) => el.classList.toggle("is-active", el.dataset.tab === name));
    if (name === "messages" && !activeBooking) {
      const first = cache.find((b) => b.status !== "CANCELLED");
      if (first) openThread(first.id);
      else $("ac-thread").innerHTML = `<p class="ac-status">${uiA.msgPick}</p>`;
    }
    if (location.hash.slice(1) !== name) history.replaceState(null, "", `#${name}`);
  }

  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged,
            sendSignInLinkToEmail, isSignInWithEmailLink, signInWithEmailLink } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    auth = getAuth(initializeApp(FB_CONFIG));

    document.querySelectorAll("[data-tab]").forEach((el) =>
      el.addEventListener("click", () => showTab(el.dataset.tab)));
    $("ac-msg-send").addEventListener("click", sendMessage);
    $("ac-msg-input").addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === "Enter") sendMessage();
    });
    $("pf-save").addEventListener("click", saveProfile);
    bindPhoto();

    $("ac-google").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("ac-signin-status").textContent = "…"; }
    });
    $("ac-signout").addEventListener("click", () => signOut(auth));

    $("ac-email-send").addEventListener("click", async () => {
      const addr = $("ac-email").value.trim();
      if (!/^\S+@\S+\.\S+$/.test(addr)) { $("ac-signin-status").textContent = uiA.emailFail; return; }
      $("ac-email-send").disabled = true;
      try {
        await sendSignInLinkToEmail(auth, addr, { url: location.href, handleCodeInApp: true });
        localStorage.setItem("yah_email_for_signin", addr);
        $("ac-signin-status").textContent = uiA.emailSent;
      } catch { $("ac-signin-status").textContent = uiA.emailFail; }
      $("ac-email-send").disabled = false;
    });

    if (isSignInWithEmailLink(auth, location.href)) {
      let saved = localStorage.getItem("yah_email_for_signin");
      if (!saved) saved = window.prompt("ご予約に使用されたメールアドレスをご入力ください") || "";
      if (saved) {
        try {
          await signInWithEmailLink(auth, saved, location.href);
          localStorage.removeItem("yah_email_for_signin");
          history.replaceState(null, "", location.pathname);
        } catch { $("ac-signin-status").textContent = uiA.emailFail; }
      }
    }

    onAuthStateChanged(auth, (user) => {
      $("ac-signin").hidden = !!user;
      $("ac-app").hidden = !user;
      if (user) {
        $("ac-user").textContent = user.email || "";
        load().then(() => {
          watchThreads(user.uid);
          const h = location.hash.slice(1);
          if (["bookings", "messages", "profile"].includes(h)) showTab(h);
        });
        loadProfile(user);
      } else {
        if (msgUnsub) msgUnsub();
        if (threadUnsub) threadUnsub();
      }
    });
  });
</script>

<style>
  .ac { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .ac-container { max-width: 1080px; margin: 0 auto; }

  /* タブ */
  .ac-tabs { display: flex; gap: 0.25rem; border-bottom: 1px solid #e8e8e8; margin-bottom: 1.75rem; }
  .ac-tab {
    font-family: inherit; font-size: 0.85rem; color: #666666; background: none; border: none;
    border-bottom: 2px solid transparent; padding: 0.7rem 1rem; cursor: pointer; margin-bottom: -1px;
    display: inline-flex; align-items: center; gap: 0.4rem;
  }
  .ac-tab:hover { color: #111111; }
  .ac-tab.is-active { color: #111111; font-weight: 500; border-bottom-color: #111111; }
  .ac-badge {
    min-width: 1.15rem; height: 1.15rem; padding: 0 0.3rem; border-radius: 999px;
    background: #111111; color: #ffffff; font-size: 0.66rem; display: inline-flex;
    align-items: center; justify-content: center; font-weight: 500;
  }

  /* メッセージ */
  .ac-mx {
    display: grid; grid-template-columns: 260px 1fr; gap: 1.5rem;
    border-top: 1px solid #ececec; padding-top: 1.25rem;
  }
  .ac-mx-list { display: flex; flex-direction: column; gap: 0.2rem; }
  .ac-mx-conv { min-width: 0; }
  :global(.ac-row) {
    display: block; width: 100%; text-align: left; font-family: inherit; cursor: pointer;
    background: none; border: none; border-radius: 6px; padding: 0.7rem 0.75rem;
  }
  :global(.ac-row:hover) { background: #fafafa; }
  :global(.ac-row.is-active) { background: #f4f4f4; }
  :global(.ac-row-top) { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5rem; }
  :global(.ac-row-name) {
    font-size: 0.84rem; font-weight: 500; color: #111111;
    display: inline-flex; align-items: center; gap: 0.35rem;
  }
  :global(.ac-row-dot) { width: 6px; height: 6px; border-radius: 50%; background: #b42318; flex: none; }
  :global(.ac-row-time) { font-size: 0.68rem; color: #666666; flex: none; }
  :global(.ac-row-date) { display: block; font-size: 0.72rem; color: #666666; margin-top: 0.2rem; }
  :global(.ac-row-snip) {
    display: block; font-size: 0.76rem; color: #666666; margin-top: 0.25rem;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .ac-conv-head { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; margin-bottom: 0.5rem; }
  :global(.ac-conv-booking) { font-size: 0.78rem; }
  .ac-mx.has-booking { grid-template-columns: 260px 1fr 260px; }
  .ac-mx-booking { border-left: 1px solid #ececec; padding-left: 1.5rem; }
  :global(.ac-bp-img) { width: 100%; border-radius: 6px; margin-bottom: 0.8rem; }
  :global(.ac-bp-name) { font-size: 0.9rem; font-weight: 500; color: #111111; margin-bottom: 0.2rem; }
  :global(.ac-bp-status) { font-size: 0.72rem; color: #666666; margin-bottom: 0.9rem; }
  :global(.ac-bp-table) { width: 100%; border-collapse: collapse; margin-bottom: 1rem; }
  :global(.ac-bp-table th), :global(.ac-bp-table td) {
    font-size: 0.76rem; text-align: left; padding: 0.45rem 0; border-bottom: 1px solid #f4f4f4;
    color: #111111; font-weight: 400; vertical-align: top;
  }
  :global(.ac-bp-table th) { color: #666666; width: 42%; }
  .ac-conv-head:empty { display: none; }
  :global(.ac-row-no) { display: block; font-size: 0.68rem; color: #666666; margin-top: 0.15rem; word-break: break-all; }
  :global(.ac-conv-back) { display: none; }
  .ac-thread { min-height: 140px; margin-bottom: 1rem; }
  :global(.ac-bub) { max-width: 82%; margin-bottom: 0.9rem; }
  :global(.ac-bub-guest) { margin-left: auto; }
  :global(.ac-bub-meta) { font-size: 0.68rem; color: #666666; margin-bottom: 0.25rem; }
  :global(.ac-bub-guest .ac-bub-meta) { text-align: right; }
  :global(.ac-bub-body) {
    font-size: 0.86rem; line-height: 1.85; color: #111111; white-space: pre-wrap;
    border: 1px solid #e8e8e8; border-radius: 8px; padding: 0.7rem 0.9rem;
  }
  :global(.ac-bub-host .ac-bub-body) { background: #111111; color: #ffffff; border-color: #111111; }
  :global(.ac-bub-sys) { max-width: 100%; }
  :global(.ac-sys-frame) {
    display: block; width: 100%; border: 0; background: #ffffff;
    min-height: 120px; overflow: hidden;
  }
  :global(.ac-sys-body) { border: 1px solid #ececec; border-radius: 8px; background: #fafafa; padding: 0.9rem 1rem; }
  :global(.ac-sys-title) { font-size: 0.82rem; font-weight: 500; color: #111111; margin-bottom: 0.5rem; }
  :global(.ac-sys-text) {
    font-family: inherit; font-size: 0.8rem; line-height: 1.9; color: #555555;
    white-space: pre-wrap; word-break: break-word; margin: 0;
  }
  :global(.ac-bub-tr) { font-size: 0.76rem; color: #666666; margin-top: 0.4rem; line-height: 1.7; }
  :global(.ac-bub-host .ac-bub-tr) { color: rgba(255,255,255,0.65); }
  .ac-compose { display: flex; gap: 0.5rem; align-items: flex-end; }
  .ac-compose textarea {
    flex: 1; padding: 0.6rem 0.8rem; font-family: inherit; font-size: 0.86rem; line-height: 1.7;
    border: 1px solid #d7d7d7; border-radius: 6px; resize: none; box-sizing: border-box;
  }
  /* iOS はフォント16px未満の入力欄でフォーカス時に自動ズームする。
     スマホでは16pxにしてズームを起こさない（送信ボタンが押しづらい問題対策） */
  @media (max-width: 720px) {
    .ac-compose textarea, .ac-phone input, .ac-emailrow input { font-size: 16px; }
  }


  @media (max-width: 720px) {
    .ac-mx { grid-template-columns: 1fr; gap: 0; }
    .ac-mx.has-booking { grid-template-columns: 1fr; }
    .ac-mx-booking { border-left: 0; padding-left: 0; border-bottom: 1px solid #ececec; padding-bottom: 1rem; margin-bottom: 1rem; }
    .ac-mx .ac-mx-conv { display: none; }
    .ac-mx.is-open .ac-mx-list { display: none; }
    .ac-mx.is-open .ac-mx-conv { display: block; }
    :global(.ac-conv-back) {
      display: inline-block; grid-column: 1 / -1; font-family: inherit; font-size: 0.76rem;
      color: #666666; background: none; border: none; padding: 0 0 0.5rem; cursor: pointer;
    }
  }

  /* プロフィール */
  #ac-list :global(.ac-tel) { display: inline-block; margin-top: 0.5rem; font-size: 1rem; font-weight: 600; color: #111111; text-decoration: none; border-bottom: 1px solid #111111; }

  .ac-form { display: grid; gap: 1rem; margin: 1.5rem 0; max-width: 720px; }
  .ac-form label { display: block; font-size: 0.78rem; color: #555555; }
  .ac-form input, .ac-form select {
    display: block; width: 100%; margin-top: 0.35rem; padding: 0.6rem 0.8rem;
    font-family: inherit; font-size: 0.88rem; color: #111111; background: #ffffff;
    border: 1px solid #d7d7d7; border-radius: 4px; box-sizing: border-box;
  }
  /* プロフィール写真 */
  .ac-photo { display: flex; align-items: center; gap: 1.25rem; margin: 1.75rem 0 0.5rem; max-width: 720px; }
  .ac-avatar {
    width: 84px; height: 84px; border-radius: 50%; flex: none;
    background: #f2f2f2 center/cover no-repeat; border: 1px solid #e8e8e8;
  }
  .ac-photo-title { font-size: 0.78rem; color: #555555; margin-bottom: 0.5rem; }
  .ac-photo-acts { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; }
  .ac-photo-pick { cursor: pointer; }
  .ac-photo-del { font-size: 0.74rem; }
  .ac-crop {
    position: fixed; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center;
    background: rgba(17, 17, 17, 0.55); padding: 1.5rem;
