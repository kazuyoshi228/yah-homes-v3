---
/* /account — My Page（design_booking_p1_v4.md §6・MS3.5）
   Googleログイン → 自分の予約一覧・詳細・到着予定時刻の追記・入室案内の再表示。
   キャンセル実行は Beds24 書込が有効になってから（現在はメール相談へ誘導）。
   公開ガード: BOOK_PREVIEW=1 のときのみ生成・noindex。 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import { LOCALES, localeParam, localizedPath, type Locale } from "../../i18n/config";

export const BOOK_PREVIEW = process.env.BOOK_PREVIEW === "1";

export function getStaticPaths() {
  if (!BOOK_PREVIEW) return [];
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { lang: locale as Locale },
  }));
}

const { lang } = Astro.props as { lang: Locale };

const ACCOUNT_ENDPOINT = "https://asia-northeast1-yah-homes.cloudfunctions.net/accountApi";
const BOOK_PATH = localizedPath(lang, "/book");
const CONTACT_HREF = `${localizedPath(lang, "/")}#contact`;
const FB_CONFIG = {
  apiKey: "AIzaSyBgHbTL5caL-itDIFTlSZNMPeHNsSnwEDs",
  authDomain: "yah-homes.firebaseapp.com",
  projectId: "yah-homes",
  appId: "1:18500698213:web:8b4cf08b97d916c216068c",
};

const A = {
  en: {
    title: "My Page", lead: "View and manage your bookings.",
    signIn: "Sign in with Google", signInEmail: "Send sign-in link", signInLead: "Sign in with the account you used to book.",
