    cancelBusy: "กำลังดำเนินการ…",
    payTitle: "การชำระเงิน", payTotal: "ราคารวม", payPaid: "ชำระแล้ว", payOnSite: "ชำระที่ที่พัก",
    payNote: "รวมค่าห้อง ภาษีที่พัก และค่าทำความสะอาดแล้ว ไม่มีค่าใช้จ่ายเพิ่มเติม",
    placeTitle: "สถานที่", placeBtn: "เปิดแผนที่", placeNote: "ที่อยู่โดยละเอียดจะส่งพร้อมกับคำแนะนำการเช็คอิน",
    statusProcessing: "กำลังดำเนินการ", statusUnpaid: "ยังไม่ได้ชำระเงิน",
    error: "ไม่สามารถโหลดการจองได้ กรุณาลองใหม่อีกครั้ง",
  },
}[lang];

const HOUSE_NAMES = {
  kiyokawa: "yah.homes kiyokawa",
  takasago: "yah.homes takasago",
  test: "yah.homes test1（検証用）",
};
// 住所は発注者確認済みのもののみ記載（未確認の棟は地図リンクのみ）— メールと同一の扱い
const HOUSE_PLACE = {
  kiyokawa: { address: "〒810-0005 福岡県福岡市中央区清川3-3-1", map: "https://www.google.com/maps/search/?api=1&query=33.57879181728365,130.4126724730762" },
  takasago: { address: "", map: "https://www.google.com/maps/search/?api=1&query=33.579953440232984,130.40629424218778" },
  test: { address: "〒810-0005 福岡県福岡市中央区清川3-3-1", map: "https://www.google.com/maps/search/?api=1&query=33.57879181728365,130.4126724730762" },
};
const { facts } = await getPropertyFacts();
const HOUSE_TIMES = {
  kiyokawa: { ci: facts.kiyokawa.checkinTime, co: facts.kiyokawa.checkoutTime },
  takasago: { ci: facts.takasago.checkinTime, co: facts.takasago.checkoutTime },
  test: { ci: facts.kiyokawa.checkinTime, co: facts.kiyokawa.checkoutTime },
};
const HOUSE_IMAGES = {
  kiyokawa: PROPERTIES.kiyokawa.exterior,
  takasago: PROPERTIES.takasago.exterior,
  test: PROPERTIES.kiyokawa.exterior,
};
const uiA = {
  loading: A.loading, empty: A.empty, error: A.error,
  upcoming: A.upcoming, past: A.past,
  checkin: A.checkin, checkout: A.checkout, guests: A.guests, total: A.total, bookingNo: A.bookingNo,
  freeUntil: A.freeUntil("{d}"),
  arrival: A.arrival, arrivalSave: A.arrivalSave, arrivalSaved: A.arrivalSaved, arrivalNote: A.arrivalNote,
  arrivalAny: A.arrivalAny, arrivalLate: A.arrivalLate,
  emptyCta: A.emptyCta,
  checkinInfo: A.checkinInfo, checkinSoon: A.checkinSoon,
  cancel: A.cancel, cancelSoon: A.cancelSoon, contact: A.contact,
  emailSent: A.emailSent, emailFail: A.emailFail,
  statusPending: A.statusPending, statusConfirmed: A.statusConfirmed, statusCancelled: A.statusCancelled,
  statusProcessing: A.statusProcessing, statusUnpaid: A.statusUnpaid,
  stay: A.stay, guestsRow: A.guestsRow, house: A.house,
  checkinWindow: A.checkinWindow, checkoutWindow: A.checkoutWindow,
  nightsUnit: A.nightsUnit, guestsUnit: A.guestsUnit,
  detailTitle: A.detailTitle, cancelFeeTitle: A.cancelFeeTitle,
  cancelFreeRow: A.cancelFreeRow, cancelAfterRow: A.cancelAfterRow, cancelNote: A.cancelNote, changeNote: A.changeNote,
  cancelBtn: A.cancelBtn, cancelBtnAfter: A.cancelBtnAfter,
  cancelFreeUntil: A.cancelFreeUntil, cancelFeeNow: A.cancelFeeNow,
  confirmTitle: A.confirmTitle, confirmPaid: A.confirmPaid, confirmFee: A.confirmFee, confirmRefund: A.confirmRefund,
  confirmRefundNote: A.confirmRefundNote, confirmNoRefundNote: A.confirmNoRefundNote,
  reasonLabel: A.reasonLabel, confirmYes: A.confirmYes, confirmNo: A.confirmNo,
  cancelDone: A.cancelDone, cancelFail: A.cancelFail, cancelBusy: A.cancelBusy,
  payTitle: A.payTitle, payTotal: A.payTotal, payPaid: A.payPaid, payOnSite: A.payOnSite, payNote: A.payNote,
  placeTitle: A.placeTitle, placeBtn: A.placeBtn, placeNote: A.placeNote,
  houses: HOUSE_NAMES, images: HOUSE_IMAGES, places: HOUSE_PLACE, times: HOUSE_TIMES, contactHref: CONTACT_HREF,
  details: { en: "Arrival, check-in and cancellation", ja: "ご到着・入室・キャンセルについて", ko: "도착・입실・취소 안내", zh: "抵達・入住・取消說明", th: "การมาถึง เช็คอิน และการยกเลิก" }[lang],
};
---

<SiteLayout
  lang={lang}
  path="/account"
  title={`${A.title} | yah.homes`}
  description={A.lead}
  noindex={true}
  solidNav
>
  <section class="ac">
    <div class="ac-container">
      <h1 class="ac-title">{A.title}</h1>
      <p class="ac-lead">{A.lead}</p>

      <!-- 未ログイン: 予約が無い状態として見せ、ログインを促す（C案） -->
      <div class="ac-signin" id="ac-signin" hidden>
        <p class="ac-empty">{A.empty}</p>
        <p class="ac-signin-lead">{A.signInLead}</p>
        <button type="button" class="ac-btn" id="ac-google">{A.signIn}</button>
        <div class="ac-sep"><span>or</span></div>
        <div class="ac-emailrow">
          <input id="ac-email" type="email" placeholder="your@email.com" maxlength="320" />
          <button type="button" class="ac-btn-sub" id="ac-email-send">{A.signInEmail}</button>
        </div>
        <p class="ac-status" id="ac-signin-status"></p>
      </div>

      <!-- ログイン後 -->
      <div id="ac-app" hidden>
        <div class="ac-bar">
          <span class="ac-user" id="ac-user"></span>
          <button type="button" class="ac-link" id="ac-signout">{A.signOut}</button>
        </div>
        <div id="ac-list"></div>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ ACCOUNT_ENDPOINT, BOOK_PATH, FB_CONFIG, uiA, lang }}>
  const $ = (id) => document.getElementById(id);
  const esc = (x) => String(x ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const yen = (n) => `¥${Number(n).toLocaleString("en-US")}`;
  const todayKey = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" });

  let auth = null;
  let cache = [];

  const statusLabel = (s) =>
    s === "CONFIRMED" ? uiA.statusConfirmed
    : s === "CANCELLED" ? uiA.statusCancelled
    : s === "PAYMENT_PENDING" ? uiA.statusUnpaid
    : uiA.statusProcessing;

  const ARRIVALS = ["15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"];
  const LOC = { en: "en-US", ja: "ja-JP", ko: "ko-KR", zh: "zh-TW", th: "th-TH" }[lang];
  const shortDate = (d) => new Date(`${d}T00:00:00`).toLocaleDateString(LOC, { month: "short", day: "numeric" });
  const nightsOf = (a, b) => Math.round((Date.parse(b) - Date.parse(a)) / 86400000);

  // 予約確認メールと同じ項目立て・同じ順序で組む（ご予約内容／キャンセル料／お支払い）
  const rows = (list) => `<table class="ac-rows">${list.filter(Boolean).map(([k, v, sub]) =>
    `<tr><th>${k}</th><td>${v}${sub ? `<span>${sub}</span>` : ""}</td></tr>`).join("")}</table>`;
  const panel = (title, inner, note) =>
    `<section class="ac-panel"><p class="ac-panel-title">${title}</p>${inner}${note ? `<p class="ac-panel-note">${note}</p>` : ""}</section>`;

  // キャンセル可否の判定（表示用。最終判定はサーバー時刻で行う）
  const canSelfCancel = (b) =>
    b.status === "CONFIRMED" && Date.parse(`${b.checkin}T00:00:00+09:00`) > Date.now();
  const withinFree = (b) => b.freeCancelUntilAt && Date.parse(b.freeCancelUntilAt) > Date.now();

  function cancelBlock(b) {
    if (b.status === "CANCELLED") return "";
    if (!canSelfCancel(b)) {
      // チェックイン当日・滞在中・手続き中は問い合わせのみ（決定事項④）
      return `
        <div class="ac-block">
          <p class="ac-block-title">${uiA.cancel}</p>
          <p class="ac-note">${uiA.cancelSoon}</p>
          <p class="ac-note ac-changenote">${uiA.changeNote}</p>
          <a class="ac-outline" href="${uiA.contactHref}">${uiA.contact}</a>
        </div>`;
    }
    const free = withinFree(b);
    const info = free
      ? uiA.cancelFreeUntil.replace("{d}", String(b.freeCancelUntilAt).slice(0, 10))
      : uiA.cancelFeeNow.replace("{a}", yen(b.total));
    return `
      <div class="ac-block">
        <p class="ac-block-title">${uiA.cancel}</p>
        <p class="ac-note">${info}</p>
        <p class="ac-note ac-changenote">${uiA.changeNote}</p>
        <button type="button" class="ac-outline ac-cancel-open" data-cancel="${esc(b.id)}">
          ${free ? uiA.cancelBtn : uiA.cancelBtnAfter}
        </button>
        <span class="ac-cancel-msg" data-cancelmsg="${esc(b.id)}"></span>
      </div>`;
  }

  // 確認ダイアログ（返金額を明示してから実行・二重の確認）
  function openCancelDialog(b) {
    const free = withinFree(b);
    const refund = free ? b.total : 0;
    const dlg = document.createElement("div");
    dlg.className = "ac-modal";
    dlg.innerHTML = `
      <div class="ac-modal-box" role="dialog" aria-modal="true">
        <p class="ac-modal-title">${uiA.confirmTitle}</p>
        <p class="ac-modal-sub">${esc(uiA.houses[b.prop] ?? b.prop)}<br>${esc(b.checkin)} 〜 ${esc(b.checkout)}</p>
        <table class="ac-modal-rows">
          <tr><th>${uiA.confirmPaid}</th><td>${yen(b.total)}</td></tr>
          <tr><th>${uiA.confirmFee}</th><td>${yen(b.total - refund)}</td></tr>
          <tr class="ac-modal-total"><th>${uiA.confirmRefund}</th><td>${yen(refund)}</td></tr>
        </table>
        <p class="ac-modal-note">${free ? uiA.confirmRefundNote : uiA.confirmNoRefundNote}</p>
        <label class="ac-modal-reason">
          <span>${uiA.reasonLabel}</span>
          <textarea id="ac-reason" rows="2" maxlength="500"></textarea>
        </label>
        <div class="ac-modal-actions">
          <button type="button" class="ac-modal-no" id="ac-cancel-no">${uiA.confirmNo}</button>
          <button type="button" class="ac-modal-yes" id="ac-cancel-yes">${free ? uiA.confirmYes : uiA.cancelBtnAfter}</button>
        </div>
        <p class="ac-modal-status" id="ac-modal-status"></p>
      </div>`;
    document.body.appendChild(dlg);
    const close = () => dlg.remove();
    dlg.addEventListener("click", (e) => { if (e.target === dlg) close(); });
    dlg.querySelector("#ac-cancel-no").addEventListener("click", close);
    dlg.querySelector("#ac-cancel-yes").addEventListener("click", async () => {
      const yes = dlg.querySelector("#ac-cancel-yes");
      yes.disabled = true;
      dlg.querySelector("#ac-modal-status").textContent = uiA.cancelBusy;
      window.gtag?.("event", "cancel_confirmed", { prop: b.prop, within_free: free, lang });
      const r = await api("POST", { action: "cancel", bookingId: b.id, reason: dlg.querySelector("#ac-reason").value });
      if (r.ok) {
        close();
        load();
      } else {
        window.gtag?.("event", "cancel_failed", { prop: b.prop, error_type: String(r.error ?? "unknown"), lang });
        dlg.querySelector("#ac-modal-status").textContent = uiA.cancelFail;
        yes.disabled = false;
      }
    });
  }

  function card(b) {
    const house = uiA.houses[b.prop] ?? b.prop;
    const image = uiA.images[b.prop] ?? "";
    const place = uiA.places[b.prop] ?? { address: "", map: "" };
    const tm = uiA.times[b.prop] ?? { ci: "", co: "" };
    const nights = nightsOf(b.checkin, b.checkout);
    const no = esc(b.id).slice(0, 8).toUpperCase();
    const freeDate = b.freeCancelUntilAt ? String(b.freeCancelUntilAt).slice(0, 10) : "";
    const opts = [`<option value="">${uiA.arrivalAny}</option>`]
      .concat(ARRIVALS.map((h) => `<option value="${h}"${b.arrival === h ? " selected" : ""}>${h}〜</option>`))
      .concat([`<option value="24:00+"${b.arrival === "24:00+" ? " selected" : ""}>${uiA.arrivalLate}</option>`])
      .join("");

    return `
      <article class="ac-card" data-s="${esc(b.status)}">
        <header class="ac-bar">
          <span class="ac-bar-house">${esc(house)}</span>
          <span class="ac-bar-right">
            <span class="ac-bar-no">${uiA.bookingNo}<strong>${no}</strong></span>
            <span class="ac-badge" data-s="${esc(b.status)}">${statusLabel(b.status)}</span>
          </span>
        </header>

        <div class="ac-body">
          ${image ? `<img class="ac-hero" src="${esc(image)}" alt="${esc(house)}" loading="lazy" />` : ""}
          ${panel(uiA.detailTitle, rows([
            [uiA.house, esc(house)],
            [uiA.checkin, esc(b.checkin), uiA.checkinWindow.replace("{ci}", tm.ci)],
            [uiA.checkout, esc(b.checkout), uiA.checkoutWindow.replace("{co}", tm.co)],
            [uiA.stay, uiA.nightsUnit.replace("{n}", nights)],
            [uiA.guestsRow, uiA.guestsUnit.replace("{g}", esc(b.guests))],
          ]))}

          ${freeDate ? panel(uiA.cancelFeeTitle, rows([
            [uiA.cancelFreeRow.replace("{d}", freeDate), yen(0)],
            [uiA.cancelAfterRow.replace("{d}", freeDate), yen(b.total)],
          ]), uiA.cancelNote) : ""}

          ${panel(uiA.payTitle, rows([
            [uiA.payTotal, yen(b.total)],
            [uiA.payPaid, yen(b.total)],
            [uiA.payOnSite, yen(0)],
          ]), uiA.payNote)}

          <section class="ac-panel">
            <p class="ac-panel-title">${uiA.arrival}</p>
            <div class="ac-arrival">
              <select data-arrival="${esc(b.id)}">${opts}</select>
              <button type="button" class="ac-btn-sub" data-savearrival="${esc(b.id)}">${uiA.arrivalSave}</button>
              <span class="ac-saved" data-saved="${esc(b.id)}"></span>
            </div>
            <p class="ac-panel-note">${uiA.arrivalNote}</p>
          </section>

          <div class="ac-block">
            <p class="ac-block-title">${uiA.checkinInfo}</p>
            <p class="ac-note">${uiA.checkinSoon}</p>
          </div>

          ${place.map ? `
          <div class="ac-block">
            <p class="ac-block-title">${uiA.placeTitle}</p>
            <p class="ac-note">${place.address ? `<strong>${esc(place.address)}</strong>` : uiA.placeNote}</p>
            <a class="ac-outline" href="${esc(place.map)}" target="_blank" rel="noopener noreferrer">${uiA.placeBtn}</a>
          </div>` : ""}

          ${cancelBlock(b)}
        </div>
      </article>`;
  }

  async function api(method, body) {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(ACCOUNT_ENDPOINT, {
      method,
      headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json();
  }

  async function load() {
    $("ac-list").innerHTML = `<p class="ac-status">${uiA.loading}</p>`;
    try {
      const j = await api("GET");
      if (!j.ok) throw new Error("load");
      const items = j.items || [];
      cache = items;
      if (!items.length) {
        $("ac-list").innerHTML = `<p class="ac-status">${uiA.empty}</p><a class="ac-btn" href="${BOOK_PATH}">${esc(uiA.emptyCta ?? "")}</a>`;
        return;
      }
      const upcoming = items.filter((b) => b.checkout >= todayKey);
      const past = items.filter((b) => b.checkout < todayKey);
      $("ac-list").innerHTML =
        (upcoming.length ? `<h2 class="ac-h2">${uiA.upcoming}</h2>${upcoming.map(card).join("")}` : "") +
        (past.length ? `<h2 class="ac-h2">${uiA.past}</h2>${past.map(card).join("")}` : "");

      document.querySelectorAll("[data-cancel]").forEach((btn) =>
        btn.addEventListener("click", () => {
          const b = (cache || []).find((x) => x.id === btn.dataset.cancel);
          if (!b) return;
          window.gtag?.("event", "cancel_started", { prop: b.prop, within_free: !!withinFree(b), lang });
          openCancelDialog(b);
        })
      );

      document.querySelectorAll("[data-savearrival]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          const id = btn.dataset.savearrival;
          const val = document.querySelector(`[data-arrival="${id}"]`).value;
          btn.disabled = true;
          const r = await api("POST", { action: "arrival", bookingId: id, arrival: val });
          document.querySelector(`[data-saved="${id}"]`).textContent = r.ok ? uiA.arrivalSaved : "";
          btn.disabled = false;
        })
      );
    } catch {
      $("ac-list").innerHTML = `<p class="ac-status">${uiA.error}</p>`;
    }
  }

  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged,
            sendSignInLinkToEmail, isSignInWithEmailLink, signInWithEmailLink } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    auth = getAuth(initializeApp(FB_CONFIG));

    $("ac-google").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("ac-signin-status").textContent = "…"; }
    });
    $("ac-signout").addEventListener("click", () => signOut(auth));

    $("ac-email-send").addEventListener("click", async () => {
      const addr = $("ac-email").value.trim();
      if (!/^\S+@\S+\.\S+$/.test(addr)) { $("ac-signin-status").textContent = uiA.emailFail; return; }
      $("ac-email-send").disabled = true;
      try {
        await sendSignInLinkToEmail(auth, addr, { url: location.href, handleCodeInApp: true });
        localStorage.setItem("yah_email_for_signin", addr);
        $("ac-signin-status").textContent = uiA.emailSent;
      } catch { $("ac-signin-status").textContent = uiA.emailFail; }
      $("ac-email-send").disabled = false;
    });

    if (isSignInWithEmailLink(auth, location.href)) {
      let saved = localStorage.getItem("yah_email_for_signin");
      if (!saved) saved = window.prompt("ご予約に使用されたメールアドレスをご入力ください") || "";
      if (saved) {
        try {
          await signInWithEmailLink(auth, saved, location.href);
          localStorage.removeItem("yah_email_for_signin");
          history.replaceState(null, "", location.pathname);
        } catch { $("ac-signin-status").textContent = uiA.emailFail; }
      }
    }

    onAuthStateChanged(auth, (user) => {
      $("ac-signin").hidden = !!user;
      $("ac-app").hidden = !user;
      if (user) {
        $("ac-user").textContent = user.email || "";
        load();
      }
    });
  });
</script>

<style>
  .ac { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .ac-container { max-width: 720px; margin: 0 auto; }
  .ac-title { font-size: clamp(1.5rem, 3.5vw, 2.2rem); font-weight: 500; color: #111111; margin-bottom: 0.6rem; }
  .ac-lead { font-size: 0.9rem; color: #555555; line-height: 1.8; margin-bottom: 2.5rem; }
  .ac-signin { border: 1px solid #e8e8e8; border-radius: 4px; padding: 2rem; }
  .ac-empty { font-size: 1rem; font-weight: 500; color: #111111; margin-bottom: 0.6rem; }
  .ac-signin-lead { font-size: 0.85rem; color: #555555; line-height: 1.8; margin-bottom: 1.25rem; }
  .ac-btn {
    display: inline-block; padding: 0.75rem 1.6rem; background: #111111; color: #ffffff;
    font-family: inherit; font-size: 0.9rem; font-weight: 500; border: none; border-radius: 4px;
    cursor: pointer; text-decoration: none;
  }
  .ac-btn-sub {
    padding: 0.5rem 1rem; background: #ffffff; color: #111111; font-family: inherit; font-size: 0.8rem;
    border: 1px solid #d7d7d7; border-radius: 4px; cursor: pointer;
  }
  .ac-link { background: none; border: none; padding: 0; font-family: inherit; font-size: 0.82rem; color: #111111; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .ac-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .ac-user { font-size: 0.8rem; color: #888888; }
  .ac-status { font-size: 0.85rem; color: #888888; line-height: 1.7; margin-top: 0.6rem; }
  .ac-sep { display: flex; align-items: center; gap: 0.75rem; margin: 1.25rem 0; color: #aaaaaa; font-size: 0.75rem; }
  .ac-sep::before, .ac-sep::after { content: ""; flex: 1; height: 1px; background: #e8e8e8; }
  .ac-emailrow { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .ac-emailrow input {
    flex: 1; min-width: 200px; padding: 0.6rem 0.75rem; font-family: inherit; font-size: 0.9rem;
    color: #111111; background: #ffffff; border: 1px solid #d7d7d7; border-radius: 4px;
  }
  #ac-list :global(.ac-h2) { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: #888888; margin: 2rem 0 0.75rem; }
  /* 予約確認メールと同じ構成: 黒ヘッダー → 写真 → 情報パネル（メールのカードと同義） */
  #ac-list :global(.ac-card) { border: 1px solid #e8e8e8; border-radius: 8px; overflow: hidden; margin-bottom: 1.75rem; background: #ffffff; }
  #ac-list :global(.ac-card[data-s="CANCELLED"]) { opacity: 0.75; }
