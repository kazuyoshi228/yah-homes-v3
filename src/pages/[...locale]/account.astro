    emailSent: "로그인 링크를 보내드렸습니다. 이 기기에서 열어 주세요.", emailFail: "링크를 보내지 못했습니다.",
    signOut: "로그아웃", loading: "불러오는 중…",
    empty: "예약이 아직 없습니다.", emptyCta: "예약 가능일 보기",
    upcoming: "다가오는 예약", past: "지난 예약",
    checkin: "체크인", checkout: "체크아웃", guests: "인원", total: "합계", bookingNo: "예약 번호",
    freeUntil: (d: string) => `${d}까지 무료 취소`,
    arrival: "도착 예정 시각", arrivalSave: "저장", arrivalSaved: "저장했습니다",
    arrivalNote: "보안 키박스를 통한 셀프 체크인이므로 도착 시각에 제한이 없습니다.",
    arrivalAny: "미정", arrivalLate: "24:00 이후",
    checkinInfo: "입실 안내", checkinSoon: "숙박 3일 전을 기준으로 입실 방법을 보내드립니다.",
    cancel: "이 예약 취소하기", cancelSoon: "취소를 원하시면 문의를 통해 연락 주세요. 담당자가 처리해 드립니다.",
    contact: "문의하기", statusPending: "처리 중", statusConfirmed: "확정", statusCancelled: "취소됨",
    error: "예약을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.",
  },
  zh: {
    title: "My Page", lead: "可查詢與變更您的訂單。",
    signIn: "使用 Google 登入", signInEmail: "寄送登入連結", signInLead: "請使用預訂時所用的帳號或電子郵件登入。",
    emailSent: "已寄送登入連結，請在此裝置上開啟。", emailFail: "無法寄送連結。",
    signOut: "登出", loading: "載入中…",
    empty: "目前尚無訂單。", emptyCta: "查詢空房",
    upcoming: "即將到來的訂單", past: "過往訂單",
    checkin: "入住", checkout: "退房", guests: "人數", total: "總金額", bookingNo: "訂單編號",
    freeUntil: (d: string) => `${d} 前可免費取消`,
    arrival: "預計抵達時間", arrivalSave: "儲存", arrivalSaved: "已儲存",
    arrivalNote: "採用密碼鑰匙盒自助入住，抵達時間沒有限制。",
    arrivalAny: "未定", arrivalLate: "24:00 之後",
    checkinInfo: "入住說明", checkinSoon: "我們將於入住前約3天寄送入住方式。",
    cancel: "取消此訂單", cancelSoon: "如需取消，請透過諮詢與我們聯繫，將由專人為您處理。",
    contact: "聯絡我們", statusPending: "處理中", statusConfirmed: "已確認", statusCancelled: "已取消",
    error: "無法載入訂單，請稍後再試。",
  },
  th: {
    title: "My Page", lead: "ตรวจสอบและจัดการการจองของคุณ",
    signIn: "เข้าสู่ระบบด้วย Google", signInEmail: "ส่งลิงก์เข้าสู่ระบบ", signInLead: "กรุณาเข้าสู่ระบบด้วยบัญชีหรืออีเมลที่ใช้ตอนจอง",
    emailSent: "ส่งลิงก์เข้าสู่ระบบแล้ว กรุณาเปิดบนอุปกรณ์นี้", emailFail: "ส่งลิงก์ไม่สำเร็จ",
    signOut: "ออกจากระบบ", loading: "กำลังโหลด…",
    empty: "ยังไม่มีการจอง", emptyCta: "ดูห้องว่าง",
    upcoming: "การจองที่กำลังจะถึง", past: "การจองที่ผ่านมา",
    checkin: "เช็คอิน", checkout: "เช็คเอาท์", guests: "ผู้เข้าพัก", total: "ราคารวม", bookingNo: "หมายเลขการจอง",
    freeUntil: (d: string) => `ยกเลิกฟรีถึง ${d}`,
    arrival: "เวลาที่คาดว่าจะถึง", arrivalSave: "บันทึก", arrivalSaved: "บันทึกแล้ว",
    arrivalNote: "เช็คอินด้วยตนเองผ่านตู้เก็บกุญแจนิรภัย จึงไม่มีข้อจำกัดเรื่องเวลาที่มาถึง",
    arrivalAny: "ยังไม่ระบุ", arrivalLate: "หลังเที่ยงคืน",
    checkinInfo: "รายละเอียดการเช็คอิน", checkinSoon: "เราจะส่งวิธีเข้าที่พักประมาณ 3 วันก่อนเข้าพัก",
    cancel: "ยกเลิกการจองนี้", cancelSoon: "หากต้องการยกเลิก กรุณาติดต่อเรา แล้วเจ้าหน้าที่จะดำเนินการให้",
    contact: "ติดต่อเรา", statusPending: "กำลังดำเนินการ", statusConfirmed: "ยืนยันแล้ว", statusCancelled: "ยกเลิกแล้ว",
    error: "ไม่สามารถโหลดการจองได้ กรุณาลองใหม่อีกครั้ง",
  },
}[lang];

const HOUSE_NAMES = { kiyokawa: "yah.homes kiyokawa", takasago: "yah.homes takasago" };
const uiA = {
  loading: A.loading, empty: A.empty, error: A.error,
  upcoming: A.upcoming, past: A.past,
  checkin: A.checkin, checkout: A.checkout, guests: A.guests, total: A.total, bookingNo: A.bookingNo,
  freeUntil: A.freeUntil("{d}"),
  arrival: A.arrival, arrivalSave: A.arrivalSave, arrivalSaved: A.arrivalSaved, arrivalNote: A.arrivalNote,
  arrivalAny: A.arrivalAny, arrivalLate: A.arrivalLate,
  emptyCta: A.emptyCta,
  checkinInfo: A.checkinInfo, checkinSoon: A.checkinSoon,
  cancel: A.cancel, cancelSoon: A.cancelSoon, contact: A.contact,
  emailSent: A.emailSent, emailFail: A.emailFail,
  statusPending: A.statusPending, statusConfirmed: A.statusConfirmed, statusCancelled: A.statusCancelled,
  houses: HOUSE_NAMES, contactHref: CONTACT_HREF,
};
---

<SiteLayout
  lang={lang}
  path="/account"
  title={`${A.title} | yah.homes`}
  description={A.lead}
  noindex={true}
  solidNav
>
  <section class="ac">
    <div class="ac-container">
      <h1 class="ac-title">{A.title}</h1>
      <p class="ac-lead">{A.lead}</p>

      <!-- 未ログイン: 予約が無い状態として見せ、ログインを促す（C案） -->
      <div class="ac-signin" id="ac-signin" hidden>
        <p class="ac-empty">{A.empty}</p>
        <p class="ac-signin-lead">{A.signInLead}</p>
        <button type="button" class="ac-btn" id="ac-google">{A.signIn}</button>
        <div class="ac-sep"><span>or</span></div>
        <div class="ac-emailrow">
          <input id="ac-email" type="email" placeholder="your@email.com" maxlength="320" />
          <button type="button" class="ac-btn-sub" id="ac-email-send">{A.signInEmail}</button>
        </div>
        <p class="ac-status" id="ac-signin-status"></p>
      </div>

      <!-- ログイン後 -->
      <div id="ac-app" hidden>
        <div class="ac-bar">
          <span class="ac-user" id="ac-user"></span>
          <button type="button" class="ac-link" id="ac-signout">{A.signOut}</button>
        </div>
        <div id="ac-list"></div>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ ACCOUNT_ENDPOINT, BOOK_PATH, FB_CONFIG, uiA }}>
  const $ = (id) => document.getElementById(id);
  const esc = (x) => String(x ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const yen = (n) => `¥${Number(n).toLocaleString("en-US")}`;
  const todayKey = new Date().toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" });

  let auth = null;

  const statusLabel = (s) =>
    s === "CONFIRMED" ? uiA.statusConfirmed : s === "CANCELLED" ? uiA.statusCancelled : uiA.statusPending;

  const ARRIVALS = ["15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"];

  function card(b) {
    const house = uiA.houses[b.prop] ?? b.prop;
    const canCancel = b.freeCancelUntilAt && new Date(b.freeCancelUntilAt) > new Date() && b.status !== "CANCELLED";
    const freeUntil = b.freeCancelUntilAt
      ? uiA.freeUntil.replace("{d}", String(b.freeCancelUntilAt).slice(0, 10))
      : "";
    const opts = [`<option value="">${uiA.arrivalAny}</option>`]
      .concat(ARRIVALS.map((h) => `<option value="${h}"${b.arrival === h ? " selected" : ""}>${h}〜</option>`))
      .concat([`<option value="24:00+"${b.arrival === "24:00+" ? " selected" : ""}>${uiA.arrivalLate}</option>`])
      .join("");
    return `
      <article class="ac-card">
        <div class="ac-card-head">
          <h3 class="ac-house">${esc(house)}</h3>
          <span class="ac-badge" data-s="${esc(b.status)}">${statusLabel(b.status)}</span>
        </div>
        <dl class="ac-dl">
          <div><dt>${uiA.checkin}</dt><dd>${esc(b.checkin)}<span>15:00〜</span></dd></div>
          <div><dt>${uiA.checkout}</dt><dd>${esc(b.checkout)}<span>〜10:00</span></dd></div>
          <div><dt>${uiA.guests}</dt><dd>${esc(b.guests)}</dd></div>
          <div><dt>${uiA.total}</dt><dd>${yen(b.total)}</dd></div>
          <div><dt>${uiA.bookingNo}</dt><dd class="ac-no">${esc(b.id).slice(0, 8).toUpperCase()}</dd></div>
        </dl>
        ${freeUntil ? `<p class="ac-cancelinfo">${freeUntil}</p>` : ""}

        <div class="ac-block">
          <p class="ac-block-title">${uiA.arrival}</p>
          <div class="ac-arrival">
            <select data-arrival="${esc(b.id)}">${opts}</select>
            <button type="button" class="ac-btn-sub" data-savearrival="${esc(b.id)}">${uiA.arrivalSave}</button>
            <span class="ac-saved" data-saved="${esc(b.id)}"></span>
          </div>
          <p class="ac-note">${uiA.arrivalNote}</p>
        </div>

        <div class="ac-block">
          <p class="ac-block-title">${uiA.checkinInfo}</p>
          <p class="ac-note">${uiA.checkinSoon}</p>
        </div>

        ${b.status !== "CANCELLED" ? `
        <div class="ac-block">
          <p class="ac-block-title">${uiA.cancel}</p>
          <p class="ac-note">${uiA.cancelSoon}</p>
          <a class="ac-link" href="${uiA.contactHref}">${uiA.contact}</a>
        </div>` : ""}
      </article>`;
  }

  async function api(method, body) {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(ACCOUNT_ENDPOINT, {
      method,
      headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    return res.json();
  }

  async function load() {
    $("ac-list").innerHTML = `<p class="ac-status">${uiA.loading}</p>`;
    try {
      const j = await api("GET");
      if (!j.ok) throw new Error("load");
      const items = j.items || [];
      if (!items.length) {
        $("ac-list").innerHTML = `<p class="ac-status">${uiA.empty}</p><a class="ac-btn" href="${BOOK_PATH}">${esc(uiA.emptyCta ?? "")}</a>`;
        return;
      }
      const upcoming = items.filter((b) => b.checkout >= todayKey);
      const past = items.filter((b) => b.checkout < todayKey);
      $("ac-list").innerHTML =
        (upcoming.length ? `<h2 class="ac-h2">${uiA.upcoming}</h2>${upcoming.map(card).join("")}` : "") +
        (past.length ? `<h2 class="ac-h2">${uiA.past}</h2>${past.map(card).join("")}` : "");

      document.querySelectorAll("[data-savearrival]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          const id = btn.dataset.savearrival;
          const val = document.querySelector(`[data-arrival="${id}"]`).value;
          btn.disabled = true;
          const r = await api("POST", { action: "arrival", bookingId: id, arrival: val });
          document.querySelector(`[data-saved="${id}"]`).textContent = r.ok ? uiA.arrivalSaved : "";
          btn.disabled = false;
        })
      );
    } catch {
      $("ac-list").innerHTML = `<p class="ac-status">${uiA.error}</p>`;
    }
  }

  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, signOut, onAuthStateChanged,
            sendSignInLinkToEmail, isSignInWithEmailLink, signInWithEmailLink } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    auth = getAuth(initializeApp(FB_CONFIG));

    $("ac-google").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("ac-signin-status").textContent = "…"; }
    });
    $("ac-signout").addEventListener("click", () => signOut(auth));

    $("ac-email-send").addEventListener("click", async () => {
      const addr = $("ac-email").value.trim();
      if (!/^\S+@\S+\.\S+$/.test(addr)) { $("ac-signin-status").textContent = uiA.emailFail; return; }
      $("ac-email-send").disabled = true;
      try {
        await sendSignInLinkToEmail(auth, addr, { url: location.href, handleCodeInApp: true });
        localStorage.setItem("yah_email_for_signin", addr);
        $("ac-signin-status").textContent = uiA.emailSent;
      } catch { $("ac-signin-status").textContent = uiA.emailFail; }
      $("ac-email-send").disabled = false;
    });

    if (isSignInWithEmailLink(auth, location.href)) {
      let saved = localStorage.getItem("yah_email_for_signin");
      if (!saved) saved = window.prompt("ご予約に使用されたメールアドレスをご入力ください") || "";
      if (saved) {
        try {
          await signInWithEmailLink(auth, saved, location.href);
          localStorage.removeItem("yah_email_for_signin");
          history.replaceState(null, "", location.pathname);
        } catch { $("ac-signin-status").textContent = uiA.emailFail; }
      }
    }

    onAuthStateChanged(auth, (user) => {
      $("ac-signin").hidden = !!user;
      $("ac-app").hidden = !user;
      if (user) {
        $("ac-user").textContent = user.email || "";
        load();
      }
    });
  });
</script>

<style>
  .ac { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .ac-container { max-width: 720px; margin: 0 auto; }
  .ac-title { font-size: clamp(1.5rem, 3.5vw, 2.2rem); font-weight: 500; color: #111111; margin-bottom: 0.6rem; }
  .ac-lead { font-size: 0.9rem; color: #555555; line-height: 1.8; margin-bottom: 2.5rem; }
  .ac-signin { border: 1px solid #e8e8e8; border-radius: 4px; padding: 2rem; }
  .ac-empty { font-size: 1rem; font-weight: 500; color: #111111; margin-bottom: 0.6rem; }
  .ac-signin-lead { font-size: 0.85rem; color: #555555; line-height: 1.8; margin-bottom: 1.25rem; }
  .ac-btn {
    display: inline-block; padding: 0.75rem 1.6rem; background: #111111; color: #ffffff;
    font-family: inherit; font-size: 0.9rem; font-weight: 500; border: none; border-radius: 4px;
    cursor: pointer; text-decoration: none;
  }
  .ac-btn-sub {
    padding: 0.5rem 1rem; background: #ffffff; color: #111111; font-family: inherit; font-size: 0.8rem;
    border: 1px solid #d7d7d7; border-radius: 4px; cursor: pointer;
  }
  .ac-link { background: none; border: none; padding: 0; font-family: inherit; font-size: 0.82rem; color: #111111; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  .ac-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
  .ac-user { font-size: 0.8rem; color: #888888; }
  .ac-status { font-size: 0.85rem; color: #888888; line-height: 1.7; margin-top: 0.6rem; }
  .ac-sep { display: flex; align-items: center; gap: 0.75rem; margin: 1.25rem 0; color: #aaaaaa; font-size: 0.75rem; }
  .ac-sep::before, .ac-sep::after { content: ""; flex: 1; height: 1px; background: #e8e8e8; }
  .ac-emailrow { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .ac-emailrow input {
    flex: 1; min-width: 200px; padding: 0.6rem 0.75rem; font-family: inherit; font-size: 0.9rem;
    color: #111111; background: #ffffff; border: 1px solid #d7d7d7; border-radius: 4px;
  }
