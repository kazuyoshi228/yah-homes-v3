---
import { ENDPOINTS } from "../../lib/adminConfig";
/* /inquiry/?t=<トークン> — 予約前のお客様がログインなしで問い合わせの続きを読む・返す画面。
   仕様: docs/spec_inquiry_threads.md §5。読み書きとも messagesApi（トークン検証）経由で、
   Firestore を匿名に開けない。リアルタイムではなく30秒ポーリング。noindex。 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import { LOCALES, localeParam, type Locale } from "../../i18n/config";
import { inquiryStrings } from "../../i18n/pageStrings";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({
    params: { locale: localeParam(locale) },
    props: { lang: locale as Locale },
  }));
}
const { lang } = Astro.props as { lang: Locale };

const MESSAGES_ENDPOINT = ENDPOINTS.messagesApi;

const T = inquiryStrings[lang];
const CONTACT_HREF = lang === "en" ? "/#contact" : `/${lang}/#contact`;
---

<SiteLayout
  lang={lang}
  path="/inquiry"
  title={`${T.title} | yah.homes`}
  description={T.title}
  noindex={true}
  solidNav
>
  <section class="iq">
    <div class="iq-container">
      <h1 class="iq-title">{T.title}</h1>
      <p class="iq-lead">{T.lead}</p>

      <div id="iq-gone" class="iq-gone" hidden>
        <p>{T.gone}</p>
        <a class="iq-btn" href={CONTACT_HREF}>{T.goneCta}</a>
      </div>

      <div id="iq-app" hidden>
        <div class="iq-thread" id="iq-thread"></div>
        <div class="iq-compose">
          <textarea id="iq-input" rows="2" maxlength="2000" placeholder={T.placeholder}></textarea>
          <button type="button" class="iq-btn" id="iq-send">{T.send}</button>
        </div>
        <p class="iq-status" id="iq-status"></p>
      </div>
      <p class="iq-status" id="iq-loading">{T.loading}</p>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ MESSAGES_ENDPOINT, T }}>
  const $ = (id) => document.getElementById(id);
  const esc = (v) => String(v ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const token = new URLSearchParams(location.search).get("t") || "";

  function fmt(ms) {
    if (!ms) return "";
    return new Date(ms).toLocaleString(undefined, { month: "numeric", day: "numeric", hour: "2-digit", minute: "2-digit" });
  }

  function render(messages) {
    $("iq-thread").innerHTML = messages.map((m) => {
      const mine = m.from === "guest";
      return `<div class="iq-bub ${mine ? "iq-bub-guest" : "iq-bub-host"}">
        <p class="iq-bub-meta">${mine ? esc(T.you) : esc(T.host)} ${fmt(m.at)}</p>
        <div class="iq-bub-body">${esc(m.body)}${m.translated ? `<div class="iq-bub-tr">${esc(m.translated)}</div>` : ""}</div>
      </div>`;
    }).join("");
    $("iq-thread").scrollTop = $("iq-thread").scrollHeight;
  }

  async function load() {
    const r = await fetch(MESSAGES_ENDPOINT, { method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action: "read", inquiryToken: token }) });
    if (r.status === 410) { $("iq-loading").hidden = true; $("iq-gone").hidden = false; return false; }
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || "load");
    $("iq-loading").hidden = true;
    $("iq-app").hidden = false;
    render(j.messages || []);
    return true;
  }

  async function send() {
    const el = $("iq-input"); const body = el.value.trim();
    if (!body) return;
    const btn = $("iq-send"); btn.disabled = true;
    $("iq-status").textContent = T.sending;
    try {
      const r = await fetch(MESSAGES_ENDPOINT, { method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "send", inquiryToken: token, body }) });
      const j = await r.json();
      if (!j.ok) throw new Error(j.error || "send");
      el.value = ""; $("iq-status").textContent = "";
      await load();
    } catch { $("iq-status").textContent = T.fail; }
    btn.disabled = false;
  }

  $("iq-send").addEventListener("click", send);
  $("iq-input").addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === "Enter") send();
  });

  (async () => {
    if (!token) { $("iq-loading").hidden = true; $("iq-gone").hidden = false; return; }
    try {
      const alive = await load();
      // リアルタイムにはしない（Firestoreを匿名に開けないため）。30秒ポーリングで十分
      if (alive) setInterval(() => load().catch(() => undefined), 30000);
    } catch {
      $("iq-loading").textContent = T.fail;
    }
  })();
</script>

<style>
  .iq { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .iq-container { max-width: 680px; margin: 0 auto; }
  .iq-title { font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 500; color: #111111; margin-bottom: 0.6rem; }
  .iq-lead { font-size: 0.85rem; color: #555555; line-height: 1.8; margin-bottom: 2rem; }
  .iq-gone { border: 1px solid #ececec; border-radius: 6px; padding: 1.5rem; }
  .iq-gone p { font-size: 0.85rem; color: #333333; line-height: 1.9; margin-bottom: 1rem; }
  .iq-thread { min-height: 160px; margin-bottom: 1rem; }
  :global(.iq-bub) { max-width: 82%; margin-bottom: 0.9rem; }
  :global(.iq-bub-guest) { margin-left: auto; }
  :global(.iq-bub-meta) { font-size: 0.68rem; color: #666666; margin-bottom: 0.25rem; }
  :global(.iq-bub-guest .iq-bub-meta) { text-align: right; }
  :global(.iq-bub-body) {
    font-size: 0.86rem; line-height: 1.85; color: #111111; white-space: pre-wrap;
    border: 1px solid #e8e8e8; border-radius: 8px; padding: 0.7rem 0.9rem;
  }
  :global(.iq-bub-host .iq-bub-body) { background: #111111; color: #ffffff; border-color: #111111; }
  :global(.iq-bub-tr) { font-size: 0.76rem; color: #666666; margin-top: 0.4rem; line-height: 1.7; }
  :global(.iq-bub-host .iq-bub-tr) { color: rgba(255,255,255,0.65); }
  .iq-compose { display: flex; gap: 0.5rem; align-items: flex-end; }
  .iq-compose textarea {
    flex: 1; padding: 0.6rem 0.8rem; font-family: inherit; font-size: 0.86rem; line-height: 1.7;
    border: 1px solid #d7d7d7; border-radius: 6px; resize: none; box-sizing: border-box;
  }
  /* iOS はフォント16px未満の入力欄でフォーカス時に自動ズームする。
     スマホでは16pxにしてズームを起こさない（送信ボタンが押しづらい問題対策） */
  @media (max-width: 720px) {
    .iq-compose textarea { font-size: 16px; }
  }

  .iq-btn {
    display: inline-block; padding: 0.75rem 1.6rem; background: #111111; color: #ffffff;
    font-family: inherit; font-size: 0.9rem; font-weight: 500; border: none; border-radius: 4px;
    cursor: pointer; text-decoration: none;
  }
  .iq-status { font-size: 0.78rem; color: #666666; margin-top: 0.75rem; }
</style>
