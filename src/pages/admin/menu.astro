---
/* /admin/menu — 管理メニュー（実在する機能へのハブ）
   稼働中の画面と、枠だけの画面を明示的に分ける。noindex・sitemap除外。 */
import SiteLayout from "../../layouts/SiteLayout.astro";

/* SSoT＝唯一の正（ここを直すと全系統に反映される） ／ 運営管理＝日々の運用画面 ／
   バッジ: Admin＝オーナーのみ・Operator＝管理者台帳のメンバー（運営会社を含む） */
const SSOT = [
  { href: "/admin/properties/", title: "物件ファクト管理", role: "admin" },
  { href: "/admin/secrets/", title: "セキュリティ鍵番号管理", role: "admin" },
  { href: "/admin/templates/", title: "定型メール管理", role: "admin" },
];
const OPERATOR = [
  { href: "/admin/bookings/", title: "直販予約 管理" },
  { href: "/admin/partners/", title: "パートナー申請 管理" },
  { href: "/admin/inbox/", title: "お問い合わせ受信箱" },
  { href: "/admin/mail-preview/", title: "メールテンプレート" },
  { href: "/admin/mail-log/", title: "メール送信ログ" },
  { href: "/operators/menu/", title: "運営メニュー" },
];
const SYSTEM = [
  { href: "/admin/health/", title: "システムヘルス" },
  { href: "/admin/audit/", title: "変更履歴" },
  { href: "/admin/users/", title: "管理者台帳" },
  { href: "/admin/specs/", title: "システム仕様書" },
];

---

<SiteLayout
  lang="ja"
  path="/admin/menu"
  title="管理メニュー | yah.homes"
  description="yah.homes 管理メニュー"
  noindex={true}
  solidNav
>
  <section class="am">
    <div class="am-container">
      <p class="am-eyebrow">Admin</p>
      <h1 class="am-title">管理メニュー</h1>
      <h2 class="am-h2">SSoT</h2>
      <div class="am-grid">
        {SSOT.map((it) => (
          <a class="am-card" href={it.href}>
            <h3 class="am-card-title">
              {it.title}
              <span class:list={["am-badge", it.role === "admin" ? "am-badge-admin" : "am-badge-operator"]}>
                {it.role === "admin" ? "Admin" : "Operator"}
              </span>
            </h3>
          </a>
        ))}
      </div>

      <h2 class="am-h2">運営管理</h2>
      <div class="am-grid">
        {OPERATOR.map((it) => (
          <a class="am-card" href={it.href}>
            <h3 class="am-card-title">{it.title}<span class="am-badge am-badge-operator">Operator</span></h3>
          </a>
        ))}
      </div>

      <h2 class="am-h2">システム管理</h2>
      <div class="am-grid">
        {SYSTEM.map((it) => (
          <a class="am-card" href={it.href}>
            <h3 class="am-card-title">{it.title}<span class="am-badge am-badge-admin">Admin</span></h3>
          </a>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .am { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .am-container { max-width: 880px; margin: 0 auto; }
  .am-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #aaaaaa; margin-bottom: 1rem; }
  .am-title { font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 500; color: #111111; margin-bottom: 0.75rem; }
  .am-h2 {
    font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: #888888;
    margin: 2rem 0 0.9rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eeeeee;
  }
  .am-h2:first-of-type { margin-top: 0; }
  .am-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1rem; }
  .am-card {
    display: block; border: 1px solid #e8e8e8; border-radius: 4px; padding: 1.1rem 1.3rem;
    text-decoration: none; transition: border-color 0.2s;
  }
  .am-card:hover { border-color: #111111; }
  .am-card-title {
    font-size: 0.95rem; font-weight: 500; color: #111111; margin: 0;
    display: flex; align-items: center; justify-content: space-between; gap: 0.6rem;
  }
  .am-badge {
    font-size: 0.62rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.18rem 0.55rem; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
  }
  .am-badge-admin { color: #ffffff; background: #111111; }
  .am-badge-operator { color: #666666; background: #ffffff; border: 1px solid #d7d7d7; }
</style>
