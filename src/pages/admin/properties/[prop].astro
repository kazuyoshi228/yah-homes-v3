---
/* /admin/properties — 物件ファクトの単一ソース（SSoT・design_booking_p1_v4.md §8-4）
   ここで保存した値が、トップ・予約ページ・物件ページの表示に使われる。
   ※ 静的サイトのため、保存後に「サイトに反映（再ビルド）」が必要。 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { CHAT_INFO, CHAT_PROPS } from "../../../data/adminChatInfo";
import { ENDPOINTS } from "../../../lib/adminConfig";
import { FB_CONFIG } from "../../../lib/adminConfig";

const PROPS_ENDPOINT = ENDPOINTS.adminProperties;

// 比較表の行定義（セクション見出し + 行）。数値＝そのまま入力／有無＝1か0
interface FactRow { key: string; label: string; type: "num" | "text" | "bool" | "time"; unit?: string; placeholder?: string; indent?: boolean }
const SECTIONS: { label: string; rows: FactRow[] }[] = [
  {
    label: "定員",
    rows: [
      { key: "capacity", label: "最大宿泊人数", unit: "名", type: "num" },
      { key: "rating", label: "Airbnb評価", type: "text", placeholder: "4.77" },
      { key: "reviewCount", label: "レビュー件数", unit: "件", type: "num" },
    ],
  },
  {
    label: "客室",
    rows: [
      { key: "bedrooms", label: "寝室", type: "num" },
      { key: "bedDouble", label: "・ダブルベッド", type: "num", indent: true },
      { key: "bedSingle", label: "・シングルベッド", type: "num", indent: true },
    ],
  },
  {
    label: "水回り",
    rows: [
      { key: "bath", label: "バスルーム", type: "num" },
      { key: "shower", label: "シャワーブース", type: "num" },
      { key: "sink", label: "洗面台", type: "num" },
      { key: "toilet", label: "トイレ", type: "num" },
    ],
  },
  {
    label: "設備",
    rows: [
      { key: "washer", label: "洗濯機", type: "bool" },
      { key: "dryer", label: "乾燥機能付きドラム式洗濯機", type: "bool" },
      { key: "audio", label: "TV用スピーカー", type: "bool" },
      { key: "tvInch", label: "大型テレビ", type: "num", unit: "インチ" },
      { key: "studyDesk", label: "スタディデスク", type: "bool" },
      { key: "parking", label: "専用駐車場", type: "bool" },
      { key: "theater", label: "シアタールーム", type: "bool" },
    ],
  },
  {
    label: "アクセス",
    rows: [
      { key: "fromAirportCarMin", label: "空港から（車・分）", type: "num", unit: "分" },
      { key: "fromStationWalkMin", label: "駅から（徒歩・分）", type: "num", unit: "分" },
      { key: "nearestStation", label: "最寄り駅", type: "text", placeholder: "渡辺通" },
      { key: "toTenjinWalkMin", label: "天神まで（徒歩・分）", type: "num", unit: "分" },
      { key: "toHakataWalkMin", label: "博多駅まで（徒歩・分）", type: "num", unit: "分" },
    ],
  },
  {
    label: "人気スポットまでの距離",
    rows: [
      { key: "spotMarketMin", label: "柳橋連合市場（徒歩・分）", type: "num", unit: "分" },
      { key: "spotMarketM", label: "　同・距離", type: "num", unit: "m", indent: true },
      { key: "spotSumiyoshiMin", label: "住吉神社（徒歩・分）", type: "num", unit: "分" },
      { key: "spotSumiyoshiM", label: "　同・距離", type: "num", unit: "m", indent: true },
      { key: "spotCanalMin", label: "キャナルシティ博多（徒歩・分）", type: "num", unit: "分" },
      { key: "spotCanalM", label: "　同・距離", type: "num", unit: "m", indent: true },
      { key: "spotNakasuWalkMin", label: "中洲・屋台街（徒歩・分）", type: "num", unit: "分" },
      { key: "spotNakasuTaxiMin", label: "　同・タクシー", type: "num", unit: "分", indent: true },
      { key: "spotOhoriCarMin", label: "大濠公園（車・分）", type: "num", unit: "分" },
      { key: "spotOhoriM", label: "　同・距離", type: "num", unit: "m", indent: true },
    ],
  },
  {
    label: "チェックイン・アウト",
    rows: [
      { key: "checkinTime", label: "チェックイン時刻", type: "time" },
      { key: "checkinEndTime", label: "チェックイン受付終了", type: "time" },
      { key: "checkoutTime", label: "チェックアウト時刻", type: "time" },
    ],
  },
  {
    // 直販サイト（yah.homes）の予約フローにだけ効く。OTA経由は Beds24 側の設定が効く。
    // 二重に持つことになるので、Beds24 の現在値を下に並べて食い違いに気づけるようにしている。
    label: "直販の予約ルール",
    rows: [
      { key: "freeCancelDays", label: "無料キャンセル期限", type: "num", unit: "日前まで" },
      { key: "bookingCutoffDays", label: "予約の締切　チェックインの", unit: "日前", type: "num" },
      { key: "bookingCutoffTime", label: "　同・その日の何時まで", type: "time", indent: true },
      { key: "bookingMaxMonths", label: "受付の上限", unit: "ヶ月先まで", type: "num" },
    ],
  },
];
const FIELD_KEYS = SECTIONS.flatMap((sec) => sec.rows.map((r) => r.key));

// 施設別ページ（/admin/properties/{prop}/・2026-08-18 発注者指示のURL構成）。
// ファクト編集があるのは清川・高砂のみ。新施設3つはチャット用情報だけを持つ。
export function getStaticPaths() {
  return CHAT_PROPS.map((p) => ({ params: { prop: p.key } }));
}
const propKey = Astro.params.prop as (typeof CHAT_PROPS)[number]["key"];
const propLabel = CHAT_PROPS.find((p) => p.key === propKey)!.label;
const HAS_FACTS = propKey === "kiyokawa" || propKey === "takasago";
const HOUSES = HAS_FACTS ? [{ key: propKey, name: propLabel }] : [];
---

<SiteLayout adminNav
  lang="ja"
  path="/admin/properties"
  title="物件ファクト管理 | yah.homes"
  description="物件スペック・評価の単一ソース"
  noindex={true}
  solidNav
>
  <section class="ap">
    <div class="ap-container">
      <a class="ap-eyebrow" href="/admin/properties/">Admin ／ 物件情報</a>
      <h1 class="ap-title">{propLabel}</h1>
      <nav class="ap-chat-props" aria-label="施設の切替">
        {CHAT_PROPS.map((p) => (
          <a class:list={["ap-chat-prop", p.key === propKey && "is-active"]} href={`/admin/properties/${p.key}/`}>{p.label}</a>
        ))}
      </nav>

      <div id="ap-login" class="ap-login" hidden>
        <button id="ap-login-btn" class="ap-btn">Googleでログイン</button>
        <p class="ap-status" id="ap-login-status"></p>
      </div>

      <div id="ap-app" hidden>
        <div class="ap-layout">
          <nav class="ap-side" aria-label="ページ内メニュー">
            {HAS_FACTS && <button type="button" class="ap-side-link is-active" data-view="overview">概要</button>}
            <button type="button" class:list={["ap-side-link", !HAS_FACTS && "is-active"]} data-view="chat">チャット用情報</button>
          </nav>
          <div class="ap-main">

        <div id="ap-view-overview" hidden={!HAS_FACTS}>
        <p class="ap-warn" id={`ap-warn-${propKey}`} hidden></p>
        <div class="ap-tablewrap">
          <table class="ap-table">
            <thead>
              <tr>
                <th class="ap-th-label"></th>
                {HOUSES.map((h) => <th class="ap-th-house">{h.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {SECTIONS.map((sec) => (
                <>
                  <tr class="ap-section"><th colspan={HOUSES.length + 1}>{sec.label}</th></tr>
                  {sec.rows.map((r) => (
                    <tr>
                      <th class={r.indent ? "ap-row-label ap-indent" : "ap-row-label"}>{r.label}</th>
                      {HOUSES.map((h) => (
                        <td>
                          {r.type === "bool" ? (
                            <select data-prop={h.key} data-field={r.key}>
                              <option value="1">あり</option>
                              <option value="0">—</option>
                            </select>
                          ) : r.type === "time" ? (
                            <input type="time" data-prop={h.key} data-field={r.key} />
                          ) : r.type === "text" ? (
                            <input type="text" inputmode="decimal" placeholder={r.placeholder} data-prop={h.key} data-field={r.key} />
                          ) : (
                            <input type="number" min="0" max="99999" step="1" data-prop={h.key} data-field={r.key} />
                          )}
                          {r.unit && <span class="ap-unit">{r.unit}</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                  {sec.label === "定員" && (
                    <tr>
                      <th class="ap-row-label">評価の取得日</th>
                      <td>
                        <input type="date" id="ap-asof" />
                        <span class="ap-unit">サイトに「評価は◯◯時点」と出る日付</span>
                      </td>
                    </tr>
                  )}
                </>
              ))}
            </tbody>
          </table>
        </div>

        <div class="ap-actions ap-save-bar">
          <button class="ap-btn ap-save-all" id="ap-save-all">すべて保存する</button>
          <span class="ap-saved" id="ap-saved-all"></span>
        </div>

<p class="ap-status" id="ap-status" role="status"></p>
        </div>

        <!-- チャット用情報（2026-08-17 発注者提供）。ゲスト対応チャットの正引き表。
             静的HTMLに焼き込まれるため、キーボックス暗証番号等は絶対に載せない。 -->
        <div id="ap-view-chat" hidden={HAS_FACTS}>
          {CHAT_INFO[propKey].length === 0 ? (
            <p class="ap-note ap-chat-empty">
              {propLabel} の情報はまだ登録されていません。内容が揃い次第、src/data/adminChatInfo.ts に追記します
              （清川の内容は住所・近隣情報が施設固有のため流用しないでください）。
            </p>
          ) : (
            <table class="ap-chat-table">
              <thead>
                <tr><th colspan={2} class="ap-chat-house">{propLabel}</th></tr>
                <tr><th>設問</th><th>回答</th></tr>
              </thead>
              <tbody>
                {CHAT_INFO[propKey].map((r) => (
                  <tr><th>{r.q}</th><td>{r.a}</td></tr>
                ))}
              </tbody>
            </table>
          )}
        </div>

          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // サイドバーのビュー切替。#chat ハッシュに対応し、リロードしても維持する
  const HAS = document.getElementById("ap-view-overview") !== null &&
              !document.getElementById("ap-view-overview")!.hasAttribute("hidden") ||
              document.querySelector('[data-view="overview"]') !== null;
  const switchView = (view: string) => {
    const ov = document.getElementById("ap-view-overview");
    const ch = document.getElementById("ap-view-chat");
    if (ov) ov.hidden = view !== "overview";
    if (ch) ch.hidden = view !== "chat";
    document.querySelectorAll<HTMLElement>(".ap-side-link").forEach((b) =>
      b.classList.toggle("is-active", b.dataset.view === view));
    history.replaceState(null, "", view === "chat" ? "#chat" : location.pathname);
  };
  document.querySelectorAll<HTMLElement>(".ap-side-link").forEach((b) =>
    b.addEventListener("click", () => switchView(b.dataset.view ?? "chat")));
  if (location.hash === "#chat" || !document.querySelector('[data-view="overview"]')) switchView("chat");
</script>

<script define:vars={{ PROPS_ENDPOINT, FB_CONFIG, FIELD_KEYS, PROP: propKey, HAS_FACTS }}>
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    const auth = getAuth(initializeApp(FB_CONFIG));
    const $ = (id) => document.getElementById(id);


    async function api(method, body) {
      const token = await auth.currentUser.getIdToken();
      const res = await fetch(PROPS_ENDPOINT, {
        method,
        headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 401) throw new Error("unauthorized");
      return res.json();
    }

    // 予約の受付判定に必須の項目。1つでも欠けると予約・空室照会が止まる
    // （既定値に倒さない設計＝間違った条件で成立させない・2026-08-17 発注者判断）
    const REQUIRED = ["capacity", "bookingCutoffDays", "bookingCutoffTime", "bookingMaxMonths", "freeCancelDays"];

    function fill(prop, data) {
      FIELD_KEYS.forEach((f) => {
        const el = document.querySelector(`[data-prop="${prop}"][data-field="${f}"]`);
        // Firestore の値をそのまま出す。既定値で埋めない（埋めると「設定済み」に
        // 見えてしまい、未設定に気づけないため・SSoTは Firestore のみ）
        if (el) el.value = data[f] ?? "";
        if (el && REQUIRED.includes(f)) el.classList.toggle("ap-missing", !data[f] && data[f] !== 0);
      });
      const missing = REQUIRED.filter((f) => !data[f] && data[f] !== 0);
      const warn = document.getElementById(`ap-warn-${prop}`);
      if (warn) {
        warn.textContent = missing.length
          ? `⚠ 未設定の必須項目があります（${missing.join("・")}）。この棟は予約を受け付けられません。`
          : "";
        warn.hidden = missing.length === 0;
      }
    }

    async function load() {
      $("ap-status").textContent = "読み込み中...";
      try {
        const j = await api("GET");
        if (!j.ok) throw new Error("load");
        fill(PROP, j.items[PROP] ?? {});
        $("ap-asof").value = j.items.meta?.ratingAsOf ?? "";
        $("ap-status").textContent = "";
      } catch (e) {
        $("ap-status").textContent = e.message === "unauthorized" ? "このアカウントには権限がありません。" : "読み込みに失敗しました。";
      }
    }

    $("ap-save-all").addEventListener("click", async () => {
      const btn = $("ap-save-all");
      btn.disabled = true;
      $("ap-saved-all").textContent = "保存しています…";
      const results = [];
      for (const prop of [PROP]) {
        const values = {};
        FIELD_KEYS.forEach((f) => {
          const el = document.querySelector(`[data-prop="${prop}"][data-field="${f}"]`);
          if (el) values[f] = el.value;
        });
        const r = await api("POST", { prop, values });
        results.push(r.ok ? null : `${prop}: ${r.error ?? "失敗"}`);
      }
      // 評価の取得日も一緒に保存（以前は別カード・別ボタンだった）
      const ar = await api("POST", { ratingAsOf: $("ap-asof").value });
      results.push(ar.ok ? null : "取得日: 失敗");
      const errs = results.filter(Boolean);
      $("ap-saved-all").textContent = errs.length
        ? `保存に失敗しました（${errs.join(" / ")}）`
        : "保存しました（サイトの表示に反映するには再ビルドが必要です）";
      btn.disabled = false;
    });


    $("ap-login-btn").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("ap-login-status").textContent = "ログインに失敗しました。"; }
    });

    onAuthStateChanged(auth, (user) => {
      if (!user) { location.replace(`/admin/?next=${encodeURIComponent(location.pathname)}`); return; }
      $("ap-login").hidden = !!user;
      if (!HAS_FACTS) { $("ap-app").hidden = !user; return; }   // 新施設はチャット表のみ（静的表示）
      $("ap-app").hidden = !user;
      if (user) load();
    });
  });
</script>

<style>
  .ap { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .ap-container { max-width: 1080px; margin: 0 auto; }
  .ap-layout { display: flex; gap: 2rem; align-items: flex-start; }
  .ap-side {
    flex: 0 0 168px; position: sticky; top: 76px;
    display: flex; flex-direction: column; gap: 0.25rem;
  }
  .ap-side-link {
    text-align: left; font-family: inherit; font-size: 0.85rem; color: #555555;
    background: none; border: 0; border-radius: 5px; padding: 0.55rem 0.8rem; cursor: pointer;
  }
  .ap-side-link:hover { background: #f5f5f5; color: #111111; }
  .ap-side-link.is-active { background: #111111; color: #ffffff; }
  .ap-main { flex: 1; min-width: 0; }
  .ap-chat-props { display: flex; gap: 0.4rem; margin: 0 0 1rem; flex-wrap: wrap; }
  .ap-chat-prop {
    font-family: inherit; font-size: 0.82rem; color: #555555; background: #ffffff;
    border: 1px solid #d7d7d7; border-radius: 999px; padding: 0.4rem 1rem; cursor: pointer;
  }
  .ap-chat-prop:hover { border-color: #111111; color: #111111; }
  .ap-chat-prop.is-active { background: #111111; border-color: #111111; color: #ffffff; }
  .ap-chat-empty { padding: 2rem 0; }
  .ap-chat-table { width: 100%; border-collapse: collapse; }
  .ap-chat-table :global(.ap-chat-house) {
    text-align: center; font-size: 0.85rem; font-weight: 500; color: #111111;
    padding: 0.6rem 0.75rem; border-bottom: 2px solid #111111;   /* 概要の表と同じバー */
  }
  .ap-chat-table th, .ap-chat-table td {
    text-align: left; vertical-align: top; padding: 0.6rem 0.75rem;
    border-bottom: 1px solid #f0f0f0; font-size: 0.84rem; line-height: 1.8;
  }
  .ap-chat-table thead th { font-size: 0.75rem; color: #666666; border-bottom: 1px solid #d7d7d7; }
  .ap-chat-table tbody th { width: 34%; font-weight: 500; color: #111111; }
  .ap-chat-table tbody td { color: #333333; white-space: pre-line; }
  @media (max-width: 760px) {
    .ap-layout { flex-direction: column; }
    .ap-side { position: static; flex-direction: row; width: 100%; }
  }
  .ap-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #666666; margin-bottom: 1rem; }
  .ap-title { font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 500; color: #111111; margin-bottom: 0.75rem; }
  .ap-lead { font-size: 0.85rem; color: #555555; line-height: 1.9; margin-bottom: 2.5rem; }
  .ap-login { border: 1px solid #eeeeee; border-radius: 4px; padding: 2rem; max-width: 420px; }
  .ap-card { border: 1px solid #e8e8e8; border-radius: 4px; padding: 1.75rem; margin-bottom: 1.5rem; }
  .ap-deploy { background: #f7f7f7; border-color: #d7d7d7; }
  .ap-house { font-size: 1rem; font-weight: 500; color: #111111; margin-bottom: 1rem; }
  .ap-warn { font-size: 0.82rem; color: #b3261e; line-height: 1.8; margin-bottom: 0.5rem; }
  :global(.ap-missing) { border-color: #b3261e !important; background: #fdf3f2; }
  .ap-note { font-size: 0.8rem; color: #666666; line-height: 1.8; margin-bottom: 1rem; }
  .ap-tablewrap { overflow-x: auto; margin-bottom: 1.5rem; }
  .ap-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .ap-table thead th { padding: 0.6rem 0.75rem; border-bottom: 2px solid #111111; font-weight: 500; color: #111111; }
  .ap-th-label { width: 42%; text-align: left; }
  .ap-th-house { text-align: left; min-width: 150px; }
  .ap-table :global(.ap-section) th {
    padding: 1.4rem 0 0.5rem; font-size: 0.7rem; letter-spacing: 0.08em; color: #666666;
    font-weight: 400; text-align: left; border-bottom: none;
  }
  .ap-table :global(.ap-row-label) {
    padding: 0.5rem 0.75rem 0.5rem 0; border-bottom: 1px solid #f0f0f0;
    font-weight: 400; color: #333333; text-align: left; white-space: nowrap;
  }
  .ap-table :global(.ap-indent) { padding-left: 1rem; color: #777777; font-size: 0.8rem; }
  .ap-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #f0f0f0; text-align: left; white-space: nowrap; }
  .ap-table td input, .ap-table td select {
    width: 100%; max-width: 110px; padding: 0.4rem 0.5rem; font-family: inherit; font-size: 0.85rem;
    color: #111111; background: #ffffff; border: 1px solid #d7d7d7; border-radius: 4px; text-align: left;
  }
  .ap-table td select { text-align: left; }
  .ap-unit { font-size: 0.72rem; color: #666666; margin-left: 0.3rem; }
  .ap-save-bar { position: sticky; bottom: 0; background: #ffffff; padding: 1rem 0; border-top: 1px solid #eeeeee; }
  .ap-btn {
    padding: 0.65rem 1.5rem; background: #111111; color: #ffffff; font-family: inherit;
    font-size: 0.85rem; font-weight: 500; border: none; border-radius: 4px; cursor: pointer;
  }
  .ap-btn:disabled { opacity: 0.5; }
  .ap-saved { font-size: 0.78rem; color: #555555; }
  .ap-status { font-size: 0.82rem; color: #333333; min-height: 1.4em; }
  a.ap-eyebrow { display: block; text-decoration: none; }
</style>
