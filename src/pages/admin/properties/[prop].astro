---
import { chatUrlFor, qrPaths } from "../../../lib/chatLinks";
import { propDisplayName } from "../../../lib/propNames";
import { BASE_URL, OPERATOR_PHONE } from "../../../lib/seo";
/* /admin/properties — 物件ファクトの単一ソース（SSoT・design_booking_p1_v5.md §8-4）
   ここで保存した値が、トップ・予約ページ・物件ページの表示に使われる。
   ※ 静的サイトのため、サイト表示への反映は次回のビルド＆デプロイ時（メール・チャットは即時反映）。 */
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { CHAT_PROPS } from "../../../data/adminChatInfo";
import { FB_SDK, ENDPOINTS } from "../../../lib/adminConfig";
import { FB_CONFIG } from "../../../lib/adminConfig";
import { existsSync } from "node:fs";
import { getPropertyFacts } from "../../../lib/propertyFacts";
import { resolve } from "node:path";

const PROPS_ENDPOINT = ENDPOINTS.adminProperties;


// 施設概要の行定義（セクション見出し + 行）。数値＝そのまま入力／有無＝1か0
interface FactRow { key: string; label: string; type: "num" | "text" | "bool" | "time"; unit?: string; placeholder?: string; indent?: boolean; note?: string }
const SECTIONS: { label: string; rows: FactRow[] }[] = [
  {
    label: "定員",
    rows: [
      { key: "capacity", label: "最大宿泊人数", unit: "名", type: "num" },
      { key: "rating", label: "Airbnb評価", type: "text", placeholder: "4.77" },
      { key: "reviewCount", label: "レビュー件数", unit: "件", type: "num" },
    ],
  },
  {
    label: "料金（表示用）",
    rows: [
      { key: "baseGuests", label: "基本料金人数", type: "num", unit: "名まで", note: "実際の請求は Beds24 の料金設定が正。ここはサイト・FAQ・llms の案内文が使う数字" },
      { key: "extraGuestFee", label: "追加1名単価", type: "num", unit: "円/泊" },
    ],
  },
  {
    label: "客室",
    rows: [
      { key: "bedrooms", label: "寝室数", type: "num", note: "変えるとBRの行数が連動します" },
    ],
  },
  {
    label: "水回り",
    rows: [
      { key: "bath", label: "バスルーム", type: "num" },
      { key: "shower", label: "シャワーブース", type: "num" },
      { key: "sink", label: "洗面台", type: "num" },
      { key: "toilet", label: "トイレ", type: "num" },
    ],
  },
  {
    label: "建物",
    rows: [
      { key: "floorAreaM2", label: "延床面積", type: "num", unit: "㎡" },
      { key: "floors", label: "階数", type: "num", unit: "階建て" },
      { key: "layoutLabel", label: "間取り表記", type: "text", placeholder: "3LDK" },
      { key: "streetAddressEn", label: "番地（英語・schema用）", type: "text", placeholder: "Kiyokawa 3-3-1" },
    ],
  },
  {
    label: "チェックイン・アウト",
    rows: [
      { key: "checkinTime", label: "チェックイン時刻", type: "time" },
      { key: "checkinEndTime", label: "チェックイン受付終了", type: "time" },
      { key: "checkoutTime", label: "チェックアウト時刻", type: "time" },
    ],
  },
  {
    // 直販サイト（yah.homes）の予約フローにだけ効く。OTA経由は Beds24 側の設定が効く。
    // 二重に持つことになるので、Beds24 の現在値を下に並べて食い違いに気づけるようにしている。
    label: "直販の予約ルール",
    rows: [
      { key: "freeCancelDays", label: "無料キャンセル期限", type: "num", unit: "日前まで" },
      { key: "bookingCutoffDays", label: "予約の締切　チェックインの", unit: "日前", type: "num" },
      { key: "bookingCutoffTime", label: "　同・その日の何時まで", type: "time", indent: true },
      { key: "bookingMaxMonths", label: "受付の上限", unit: "ヶ月先まで", type: "num" },
    ],
  },
];
/* 「設備」はサイドバー独立ビュー（2026-08-18 発注者指示）。保存は施設概要と同じ一括保存 */
const FACILITY_SECTIONS: { label: string; rows: FactRow[] }[] = [
  {
    label: "設備",
    rows: [
      { key: "washer", label: "洗濯機", type: "bool" },
      { key: "dryer", label: "乾燥機能付きドラム式洗濯機", type: "bool" },
      { key: "audio", label: "TV用スピーカー", type: "bool" },
      { key: "tvInch", label: "大型テレビ", type: "num", unit: "インチ" },
      { key: "studyDesk", label: "スタディデスク", type: "bool" },
      { key: "parking", label: "専用駐車場", type: "bool" },
      { key: "parkingSpaces", label: "駐車台数", type: "num", unit: "台" },
      { key: "parkingSize", label: "駐車場のサイズ", type: "text", placeholder: "幅 2,000mm × 奥行 5,000mm ／ フリースペース" },
      { key: "theater", label: "シアタールーム", type: "bool" },
    ],
  },
  {
    label: "設備フラグ（構造化データ＝Google/AIが読む設備一覧）",
    rows: [
      { key: "kitchen", label: "フルキッチン", type: "bool" },
      { key: "wifi", label: "高速Wi-Fi", type: "bool" },
      { key: "airCon", label: "全室エアコン", type: "bool" },
      { key: "bathtub", label: "浴槽", type: "bool" },
      { key: "selfCheckin", label: "セルフチェックイン", type: "bool" },
      { key: "longStay", label: "長期滞在（28泊以上）受入", type: "bool" },
      { key: "smokingAllowed", label: "喫煙可", type: "bool" },
      { key: "coAlarm", label: "CO（一酸化炭素）警報器", type: "bool" },
    ],
  },
];
/* 「移動・距離」はサイドバー独立ビュー（2026-08-18 発注者指示）。
   アクセス・人気スポット距離・タクシー相場をここに集約 */
const TRANSPORT_SECTIONS: { label: string; rows: FactRow[] }[] = [
  {
    label: "アクセス",
    rows: [
      { key: "fromAirportCarMin", label: "空港から（車・分）", type: "num", unit: "分" },
      { key: "fromStationWalkMin", label: "駅から（徒歩・分）", type: "num", unit: "分" },
      { key: "nearestStation", label: "最寄り駅", type: "text", placeholder: "渡辺通" },
      { key: "mapUrl", label: "Google マップのURL", type: "text", placeholder: "https://maps.app.goo.gl/…", note: "サイト・メール・チャットの「地図を開く」がすべてここを見ます" },
      { key: "registerUrl", label: "宿泊者名簿フォームのURL", type: "text", placeholder: "https://…", note: "予約確定メールが案内する先" },
      { key: "zip", label: "郵便番号", type: "text", placeholder: "810-0005" },
      { key: "addressJa", label: "住所（日本語）", type: "text", placeholder: "福岡県福岡市中央区…", note: "使い方ガイド・確定メール・My Page がここを見ます" },
      { key: "addressEn", label: "住所（英語）", type: "text", placeholder: "3-3-1 Kiyokawa, Chuo-ku, …" },
      { key: "toTenjinWalkMin", label: "天神まで（徒歩・分）", type: "num", unit: "分" },
      { key: "toTenjinCarMin", label: "天神まで（車・分）", type: "num", unit: "分" },
      { key: "toHakataWalkMin", label: "博多駅まで（徒歩・分）", type: "num", unit: "分" },
      { key: "toHakataCarMin", label: "博多駅まで（車・分）", type: "num", unit: "分" },
      { key: "toHakataSubwayMin", label: "博多駅まで（地下鉄・分）", type: "num", unit: "分" },
      { key: "spotYakuinWalkMin", label: "薬院駅まで（徒歩・分）", type: "num", unit: "分", note: "0=未設定（表示に使わない）" },
      { key: "spotCanalCarMin", label: "キャナルシティ（車・分）", type: "num", unit: "分", note: "0=未設定" },
      { key: "spotDazaifuCarMin", label: "太宰府（車・分）", type: "num", unit: "分", note: "0=未設定" },
    ],
  },
  {
    label: "タクシー",
    rows: [
      { key: "airportTaxiFare", label: "空港からのタクシー相場", type: "text", placeholder: "¥2,000〜¥2,500", note: "FAQ・llms の案内文が使う表示用の目安" },
    ],
  },
  {
    label: "人気スポットまでの距離",
    rows: [
      { key: "spotMarketMin", label: "柳橋連合市場（徒歩・分）", type: "num", unit: "分" },
      { key: "spotMarketM", label: "　同・距離", type: "num", unit: "m", indent: true },
      { key: "spotSumiyoshiMin", label: "住吉神社（徒歩・分）", type: "num", unit: "分" },
      { key: "spotSumiyoshiM", label: "　同・距離", type: "num", unit: "m", indent: true },
      { key: "spotCanalMin", label: "キャナルシティ博多（徒歩・分）", type: "num", unit: "分" },
      { key: "spotCanalM", label: "　同・距離", type: "num", unit: "m", indent: true },
      { key: "spotNakasuWalkMin", label: "中洲・屋台街（徒歩・分）", type: "num", unit: "分" },
      { key: "spotNakasuTaxiMin", label: "　同・タクシー", type: "num", unit: "分", indent: true },
      { key: "spotOhoriCarMin", label: "大濠公園（車・分）", type: "num", unit: "分" },
      { key: "spotOhoriM", label: "　同・距離", type: "num", unit: "m", indent: true },
    ],
  },
];

const ALL_SECTIONS = [...SECTIONS, ...FACILITY_SECTIONS, ...TRANSPORT_SECTIONS];
/* BR別内訳のUIから自動生成される値（画面上は隠しフィールド・保存/読込は従来どおり） */
const HIDDEN_KEYS = ["bedDouble", "bedSingle", "bedroomLayout"];
const FIELD_KEYS = [...ALL_SECTIONS.flatMap((sec) => sec.rows.map((r) => r.key)), ...HIDDEN_KEYS];

// 施設別ページ（/admin/properties/{prop}/・2026-08-18 発注者指示のURL構成）。
// ファクト編集があるのは清川・高砂のみ。新施設3つはチャット用情報だけを持つ。
export function getStaticPaths() {
  return CHAT_PROPS.map((p) => ({ params: { prop: p.key } }));
}
const propKey = Astro.params.prop as (typeof CHAT_PROPS)[number]["key"];
/* QRコードはこのページが唯一の入口（2026-08-18 発注者承認）。
   実体は public/qr/（scripts/gen-qr.mjs がチャット側の施設マスタから生成）。
   ここではファイルの有無だけを見る＝施設一覧を二重に持たない。 */
const QR_FILES = qrPaths(propKey);
// import.meta.url はビルド後の位置を指すため使わない。ビルドはプロジェクト直下で走る。
const HAS_QR = existsSync(resolve(process.cwd(), `public${QR_FILES.screen}`));
const CHAT_URL = chatUrlFor(propKey);

const propLabel = CHAT_PROPS.find((p) => p.key === propKey)!.label;
const HAS_FACTS = propKey === "kiyokawa" || propKey === "takasago";
/* 基本情報（旧・定型メール管理の「情報テーブル」をここへ集約・2026-08-18 発注者指示）。
   値は写しを置かない: SSoT（property_facts）から読むか、施設キーから組み立てる。 */
const FACTS_ALL = HAS_FACTS ? (await getPropertyFacts()).facts[propKey as "kiyokawa" | "takasago"] : null;
const BASICS: { k: string; v: string; link?: boolean; todo?: boolean }[] = FACTS_ALL ? [
  { k: "施設名", v: propDisplayName(propKey) },
  { k: "チェックイン時刻", v: FACTS_ALL.checkinTime },
  { k: "チェックアウト時刻", v: FACTS_ALL.checkoutTime },
  { k: "Google マップのURL", v: FACTS_ALL.mapUrl, link: true },
  { k: "宿泊者名簿フォームのURL", v: FACTS_ALL.registerUrl, link: true },
  { k: "入室マニュアルのURL", v: `${BASE_URL}/how-to/${propKey}/`, link: true },
  { k: "チャットのURL", v: CHAT_URL, link: true },
  { k: "チャットQRコード", v: `${BASE_URL}${QR_FILES.screen}`, link: true },
  { k: "問い合わせ電話番号", v: OPERATOR_PHONE },
  { k: "My Page（直販のみ）", v: `${BASE_URL}/account/`, link: true },
  { k: "キーボックスの暗証番号", v: "鍵の管理（/admin/secrets/）で管理・オーナー専用" },
  { k: "レビュー投稿先", v: "未決", todo: true },
] : [];
const HOUSES = HAS_FACTS ? [{ key: propKey, name: propLabel }] : [];
---

<SiteLayout adminNav
  lang="ja"
  path="/admin/properties"
  title="物件ファクト管理 | yah.homes"
  description="物件スペック・評価の単一ソース"
  noindex={true}
  solidNav
>
  <section class="ap">
    <div class="ap-container">
      <a class="ap-eyebrow" href="/admin/properties/">Admin ／ 物件情報</a>
      <h1 class="ap-title">{propLabel}</h1>
      <nav class="ap-chat-props" aria-label="施設の切替">
        {CHAT_PROPS.map((p) => (
          <a class:list={["ap-chat-prop", p.key === propKey && "is-active"]} href={`/admin/properties/${p.key}/`}>{p.label}</a>
        ))}
      </nav>

      <div id="ap-login" class="ap-login" hidden>
        <button id="ap-login-btn" class="ap-btn">Googleでログイン</button>
        <p class="ap-status" id="ap-login-status"></p>
      </div>

      <div id="ap-app" hidden>
        <div class="ap-layout">
          <nav class="ap-side" aria-label="ページ内メニュー">
            {HAS_FACTS && <button type="button" class="ap-side-link is-active" data-view="basics">基本情報</button>}
            {HAS_FACTS && <button type="button" class="ap-side-link" data-view="overview">施設概要</button>}
            {HAS_FACTS && <button type="button" class="ap-side-link" data-view="facilities">設備</button>}
            {HAS_FACTS && <button type="button" class="ap-side-link" data-view="transport">移動・距離</button>}
            <button type="button" class:list={["ap-side-link", !HAS_FACTS && "is-active"]} data-view="chat">Q&A</button>
            <button type="button" class="ap-side-link" data-view="qr">QRコード</button>
            {HAS_FACTS && <button type="button" class="ap-side-link" data-view="common">共通情報</button>}
          </nav>
          <div class="ap-main">

        <div id="ap-view-basics" hidden={!HAS_FACTS}>
          <p class="ap-note">
            メールやチャットが使う「この施設の基本の値」の一覧（閲覧用）です。
            編集はサイドバーの各ビュー（施設概要・設備・移動・距離・共通情報）から。
          </p>
          <div class="ap-tablewrap">
            <table class="ap-basics">
              <thead><tr><th>項目</th><th>値</th></tr></thead>
              <tbody>
                {BASICS.map((b) => (
                  <tr>
                    <th>{b.k}</th>
                    <td class:list={[b.todo && "ap-todo"]}>
                      {b.link ? <a href={b.v} target="_blank" rel="noopener">{b.v}</a> : b.v}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div id="ap-view-overview" hidden>
        <p class="ap-warn" id={`ap-warn-${propKey}`} hidden></p>
        <div class="ap-tablewrap">
          <table class="ap-table">
            <tbody>
              {SECTIONS.map((sec) => (
                <>
                  <tr class="ap-section"><th colspan={HOUSES.length + 1}>{sec.label}</th></tr>
                  {sec.rows.map((r) => (
                    <tr>
                      <th class={r.indent ? "ap-row-label ap-indent" : "ap-row-label"}>{r.label}</th>
                      {HOUSES.map((h) => (
                        <td>
                          {r.type === "bool" ? (
                            <select data-prop={h.key} data-field={r.key}>
                              <option value="1">あり</option>
                              <option value="0">—</option>
                            </select>
                          ) : r.type === "time" ? (
                            <input type="time" data-prop={h.key} data-field={r.key} />
                          ) : r.type === "text" ? (
                            <input type="text" class:list={["ap-input-wide"]} placeholder={r.placeholder} data-prop={h.key} data-field={r.key} />
                          ) : (
                            <input type="number" min="0" max="99999" step="1" data-prop={h.key} data-field={r.key} />
                          )}
                          {r.unit && <span class="ap-unit">{r.unit}</span>}
                          {r.note && <span class="ap-fnote">{r.note}</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                  {sec.label === "客室" && (
                    <>
                      <tr id="ap-bed-anchor" hidden><td></td></tr>
                      <tr>
                        <th class="ap-row-label">合計（自動集計）</th>
                        <td>
                          <span id="ap-bed-totals" class="ap-bed-totals"></span>
                          <input type="hidden" data-prop={propKey} data-field="bedDouble" id="ap-bedDouble" />
                          <input type="hidden" data-prop={propKey} data-field="bedSingle" id="ap-bedSingle" />
                          <input type="hidden" data-prop={propKey} data-field="bedroomLayout" id="ap-bedroomLayout" />
                        </td>
                      </tr>
                    </>
                  )}
                  {sec.label === "定員" && (
                    <tr>
                      <th class="ap-row-label">評価の取得日</th>
                      <td>
                        <input type="date" id="ap-asof" />
                        <span class="ap-unit">サイトに「評価は◯◯時点」と出る日付</span>
                      </td>
                    </tr>
                  )}
                </>
              ))}
            </tbody>
          </table>
        </div>

        <div class="ap-actions ap-save-bar">
          <button class="ap-btn ap-save-all" id="ap-save-all">すべて保存する</button>
          <span class="ap-saved" id="ap-saved-all"></span>
        </div>

<p class="ap-status" id="ap-status" role="status"></p>
        </div>

        <div id="ap-view-facilities" hidden>
        <div class="ap-tablewrap">
          <table class="ap-table">
            <tbody>
              {FACILITY_SECTIONS.map((sec) => (
                <>
                  <tr class="ap-section"><th colspan={HOUSES.length + 1}>{sec.label}</th></tr>
                  {sec.rows.map((r) => (
                    <tr>
                      <th class="ap-row-label">{r.label}</th>
                      {HOUSES.map((h) => (
                        <td>
                          {r.type === "bool" ? (
                            <select data-prop={h.key} data-field={r.key}>
                              <option value="1">あり</option>
                              <option value="0">—</option>
                            </select>
                          ) : r.type === "text" ? (
                            <input type="text" class:list={["ap-input-wide"]} placeholder={r.placeholder} data-prop={h.key} data-field={r.key} />
                          ) : (
                            <input type="number" min="0" max="99999" step="1" data-prop={h.key} data-field={r.key} />
                          )}
                          {r.unit && <span class="ap-unit">{r.unit}</span>}
                          {r.note && <span class="ap-fnote">{r.note}</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
        <div class="ap-actions ap-save-bar">
          <button class="ap-btn ap-save-all2" id="ap-save-all2">すべて保存する</button>
          <span class="ap-saved" id="ap-saved-all2"></span>
        </div>

        <div id="ap-view-transport" hidden>
        <div class="ap-tablewrap">
          <table class="ap-table">
            <tbody>
              {TRANSPORT_SECTIONS.map((sec) => (
                <>
                  <tr class="ap-section"><th colspan={HOUSES.length + 1}>{sec.label}</th></tr>
                  {sec.rows.map((r) => (
                    <tr>
                      <th class="ap-row-label">{r.label}</th>
                      {HOUSES.map((h) => (
                        <td>
                          {r.type === "text" ? (
                            <input type="text" class:list={["ap-input-wide"]} placeholder={r.placeholder} data-prop={h.key} data-field={r.key} />
                          ) : (
                            <input type="number" min="0" max="99999" step="1" data-prop={h.key} data-field={r.key} />
                          )}
                          {r.unit && <span class="ap-unit">{r.unit}</span>}
                          {r.note && <span class="ap-fnote">{r.note}</span>}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))}
            </tbody>
          </table>
        </div>
        <div class="ap-actions ap-save-bar">
          <button class="ap-btn" id="ap-save-all3">すべて保存する</button>
          <span class="ap-saved" id="ap-saved-all3"></span>
        </div>
        </div>
        </div>

        <!-- Q&A（チャット・メッセージAI共通・正本はこの1表 = property_facts/{prop}.chatInfo）。
             2026-08-19 発注者判断「結局メッセージもChatだから」で顧客メッセージ用情報を統合。
             チャットとメッセージAIの両方がこの表を注入する。暗証番号等の実値は絶対に載せない。 -->
        <div id="ap-view-chat" hidden={HAS_FACTS}>
          <!-- 内容は Firestore property_facts/{prop}.chatInfo（2026-08-18 発注者指示で移行）。
               保存先の prop は URL パスから導出する（フォーム状態から取ると、ページ遷移時に
               前の施設のIDが残って別施設へ保存される事故が起き得るため）。 -->
          <p class="ap-note ap-chat-empty" id="ap-chat-empty" hidden>
            この施設のチャット用情報はまだ登録されていません。
          </p>
          <div class="ap-tablewrap">
            <table class="ap-chat-table" id="ap-chat-table" hidden>
              <thead><tr><th>設問</th><th>回答</th><th class="ap-chat-rowop"></th></tr></thead>
              <tbody id="ap-chat-tbody"></tbody>
            </table>
          </div>
          <div class="ap-chat-actions ap-chat-export" id="ap-chat-exportbar" hidden>
            <button type="button" class="ap-btn-sub" id="ap-chat-copy">表をコピー（Excelに貼付）</button>
            <button type="button" class="ap-btn-sub" id="ap-chat-csv">CSVをダウンロード</button>
            <span class="ap-saved" id="ap-chat-copied"></span>
          </div>
          <div class="ap-chat-actions" id="ap-chat-savebar" hidden>
            <button type="button" class="ap-btn-sub" id="ap-chat-addrow">＋ 行を追加</button>
            <button type="button" class="ap-btn-sub" id="ap-chat-addcat">＋ 分類を追加</button>
            <button class="ap-btn" id="ap-chat-save">保存する</button>
            <span class="ap-saved" id="ap-chat-saved"></span>
          </div>
        </div>
        <div id="ap-view-qr" hidden>
          {HAS_QR ? (
            <div class="ap-qr">
              <img class="ap-qr-img" src={QR_FILES.screen} width="200" height="200" alt={`QR: ${CHAT_URL}`} />
              <div class="ap-qr-body">
                <p class="ap-qr-url">{CHAT_URL}</p>
                <div class="ap-qr-dl">
                  <a class="ap-btn-sub" href={QR_FILES.cardA4Pdf} download>A4横カード PDF（現地掲示・大きく見せる）</a>
                  <a class="ap-btn-sub" href={QR_FILES.card97Pdf} download>97mm角カード PDF（印刷推奨）</a>
                  <a class="ap-btn-sub" href={QR_FILES.card97Svg} download>97mm角カード SVG</a>
                  <a class="ap-btn-sub" href={QR_FILES.cardSvg} download>A6カード SVG</a>
                  <a class="ap-btn-sub" href={QR_FILES.cardPng} download>A6カード PNG</a>
                  <a class="ap-btn-sub" href={QR_FILES.print} download>QRのみ（印刷用2048px）</a>
                  <a class="ap-btn-sub" href={QR_FILES.screen} download>QRのみ（画面用360px）</a>
                </div>
              </div>
            </div>
          ) : (
            <p class="ap-note">この施設はまだチャットを公開していないため、QRコードはありません。チャット側で公開すると自動的に発行されます。</p>
          )}
        </div>

        <div id="ap-view-common" hidden>
          <p class="ap-note">
            棟をまたぐ共通の値（正本: property_facts/meta）。サイトの会社表記・構造化データ・
            チャットの電話、決済画面の宿泊税がここを見ます（メールの電話は現状コード定数・別途SSoT化予定）。
          </p>
          <div class="ap-tablewrap">
            <table class="ap-table">
              <tbody>
                <tr class="ap-section"><th colspan="2">運営・連絡先</th></tr>
                <tr><th class="ap-row-label">問い合わせ電話番号</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-operatorPhone" placeholder="050-xxxx-xxxx" /></td></tr>
                <tr class="ap-section"><th colspan="2">運営会社（登記住所）</th></tr>
                <tr><th class="ap-row-label">郵便番号</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-companyZip" placeholder="810-0011" /></td></tr>
                <tr><th class="ap-row-label">住所（日本語）</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-companyAddressJa" /></td></tr>
                <tr><th class="ap-row-label">住所（英語・全文）</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-companyAddressEn" /></td></tr>
                <tr><th class="ap-row-label">番地（英語・schema用）</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-companyStreetEn" /></td></tr>
                <tr><th class="ap-row-label">市区（英語）</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-companyLocalityEn" /></td></tr>
                <tr><th class="ap-row-label">県（英語）</th>
                  <td><input type="text" class="ap-input-wide" id="ap-meta-companyRegionEn" /></td></tr>
                <tr class="ap-section"><th colspan="2">宿泊税（福岡市の条例値）</th></tr>
                <tr><th class="ap-row-label">通常（1人1泊・円）</th>
                  <td><input type="number" min="0" max="99999" id="ap-meta-taxLow" /></td></tr>
                <tr><th class="ap-row-label">高額時（1人1泊・円）</th>
                  <td><input type="number" min="0" max="99999" id="ap-meta-taxHigh" /></td></tr>
                <tr><th class="ap-row-label">高額の閾値（税抜宿泊料/人泊・円）</th>
                  <td><input type="number" min="0" max="99999" id="ap-meta-taxHighThreshold" /></td></tr>
              </tbody>
            </table>
          </div>
          <div class="ap-actions ap-save-bar">
            <button class="ap-btn" id="ap-save-meta">共通情報を保存する</button>
            <span class="ap-saved" id="ap-saved-meta"></span>
          </div>
        </div>


          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // サイドバーのビュー切替。#chat ハッシュに対応し、リロードしても維持する
  const HAS = document.getElementById("ap-view-overview") !== null &&
              !document.getElementById("ap-view-overview")!.hasAttribute("hidden") ||
              document.querySelector('[data-view="overview"]') !== null;
  const switchView = (view: string) => {
    const ba = document.getElementById("ap-view-basics");
    const ov = document.getElementById("ap-view-overview");
    const fa = document.getElementById("ap-view-facilities");
    const tp = document.getElementById("ap-view-transport");
    const cm = document.getElementById("ap-view-common");
    const ch = document.getElementById("ap-view-chat");
    const qr = document.getElementById("ap-view-qr");
    if (ba) ba.hidden = view !== "basics";
    if (ov) ov.hidden = view !== "overview";
    if (fa) fa.hidden = view !== "facilities";
    if (tp) tp.hidden = view !== "transport";
    if (cm) cm.hidden = view !== "common";
    if (ch) ch.hidden = view !== "chat";
    if (qr) qr.hidden = view !== "qr";
    // 非表示のあいだは高さを測れない。表示に切り替わったここでやり直す
    if (view === "chat") requestAnimationFrame(() => (window as unknown as { __yahGrowChat?: () => void }).__yahGrowChat?.());
    document.querySelectorAll<HTMLElement>(".ap-side-link").forEach((b) =>
      b.classList.toggle("is-active", b.dataset.view === view));
    history.replaceState(null, "", view === "basics" ? location.pathname : `#${view}`);
  };
  document.querySelectorAll<HTMLElement>(".ap-side-link").forEach((b) =>
    b.addEventListener("click", () => switchView(b.dataset.view ?? "chat")));
  const hash = location.hash.replace("#", "");
  const VIEWS = ["chat", "qr", "overview", "facilities", "transport", "common"];
  if (VIEWS.includes(hash) && document.querySelector(`[data-view="${hash}"]`)) switchView(hash);
  else if (!document.querySelector('[data-view="basics"]')) switchView("chat");
</script>

<script define:vars={{ FB_SDK, PROPS_ENDPOINT, FB_CONFIG, FIELD_KEYS, PROP: propKey, HAS_FACTS }}>
  import(`${FB_SDK}/firebase-app.js`).then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } = await import(
      `${FB_SDK}/firebase-auth.js`
    );
    const auth = getAuth(initializeApp(FB_CONFIG));
    const $ = (id) => document.getElementById(id);


    async function api(method, body) {
      const token = await auth.currentUser.getIdToken();
      const res = await fetch(PROPS_ENDPOINT, {
        method,
        headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 401) throw new Error("unauthorized");
      return res.json();
    }

    // 予約の受付判定に必須の項目。1つでも欠けると予約・空室照会が止まる
    // （既定値に倒さない設計＝間違った条件で成立させない・2026-08-17 発注者判断）
    const REQUIRED = ["capacity", "bookingCutoffDays", "bookingCutoffTime", "bookingMaxMonths", "freeCancelDays"];

    function fill(prop, data) {
      FIELD_KEYS.forEach((f) => {
        const el = document.querySelector(`[data-prop="${prop}"][data-field="${f}"]`);
        // Firestore の値をそのまま出す。既定値で埋めない（埋めると「設定済み」に
        // 見えてしまい、未設定に気づけないため・SSoTは Firestore のみ）
        if (el) el.value = data[f] ?? "";
        if (el && REQUIRED.includes(f)) el.classList.toggle("ap-missing", !data[f] && data[f] !== 0);
      });
      const missing = REQUIRED.filter((f) => !data[f] && data[f] !== 0);
      const warn = document.getElementById(`ap-warn-${prop}`);
      if (warn) {
        warn.textContent = missing.length
          ? `⚠ 未設定の必須項目があります（${missing.join("・")}）。この棟は予約を受け付けられません。`
          : "";
        warn.hidden = missing.length === 0;
      }
    }

    /* チャット用情報。保存先の施設IDは必ず URL パスから導出する（2026-08-18 発注者指示）。
       フォームや変数の内部状態から取ると、前の施設のIDが残って別施設へ保存される
       事故が起き得る。URL＝施設が一致している限り、混在は構造的に起きない。 */
    function urlProp() {
      const m = location.pathname.match(/\/admin\/properties\/([A-Za-z0-9_-]+)\//);
      return m ? m[1] : PROP;
    }
    /* ── Q&A表エディタ（分類・行・Excelコピー/CSV・自動高さ）──
       正本は property_facts/{prop}.chatInfo の1表（チャット・メッセージAI共通）。
       かつて顧客メッセージ用情報（messageInfo）を別表で持ったが、内容がほぼ全て重複したため
       統合した（2026-08-19 発注者判断「結局メッセージもChatだから」）。 */
    function setupInfoEditor(cfg) {   // cfg: { p: ID接頭辞, field: 保存フィールド, csv: CSVファイル名 }
      const el = (s) => $(`${cfg.p}-${s}`);
      let editable = false;
      /* 入力欄の高さは中身に合わせて広げる。ただし表示されていない間は scrollHeight が 0 に
         なるため、そのまま確定させると「行はあるのに中身が見えない」状態になる
         （#chat で開いた直後に起きていた・2026-08-18 発注者報告）。測れないときは触らず、
         表示に切り替わったタイミングで growAll() をやり直す。 */
      const grow = (t) => {
        const prev = t.style.height;
        t.style.height = "auto";
        const h = t.scrollHeight;
        t.style.height = h > 0 ? `${h}px` : prev;
      };
      const growAll = () => el("tbody").querySelectorAll("textarea").forEach(grow);
      /* 分類の見出し行。編集時は名前を書き換え可・「＋」でその分類の末尾に行を足す。
         分類はデータ上は各行の cat フィールド（保存時に見出しから割り当て直す）。 */
      function catRow(name) {
        const tr = document.createElement("tr");
        tr.className = "ap-chat-cat";
        if (editable) {
          tr.innerHTML = `<th colspan="2"><input class="ap-chat-catname" placeholder="分類名"></th>
            <td class="ap-chat-rowop"><button type="button" class="ap-chat-catadd" title="この分類に行を追加" aria-label="この分類に行を追加">＋</button></td>`;
          tr.querySelector(".ap-chat-catname").value = name;
          tr.querySelector(".ap-chat-catadd").addEventListener("click", () => {
            let next = tr.nextElementSibling;
            while (next && !next.classList.contains("ap-chat-cat")) next = next.nextElementSibling;
            const row = qaRow("", "");
            if (next) next.before(row); else tr.parentElement.append(row);
            row.querySelector(".ap-chat-q")?.focus();
          });
        } else {
          const th = document.createElement("th");
          th.colSpan = 3;
          th.textContent = name || "未分類";
          tr.append(th);
        }
        return tr;
      }
      function qaRow(q, a) {
        const tr = document.createElement("tr");
        if (editable) {
          tr.innerHTML = `<th><textarea class="ap-chat-q" rows="1"></textarea></th>
            <td><textarea class="ap-chat-a" rows="1"></textarea></td>
            <td class="ap-chat-rowop"><button type="button" class="ap-chat-del" title="この行を削除" aria-label="この行を削除">×</button></td>`;
          // 内容に合わせて高さを自動調整（枠の高さを揃え、表として読めるように）
          tr.querySelectorAll("textarea").forEach((t) => {
            t.addEventListener("input", () => grow(t));
          });
          tr.querySelector(".ap-chat-q").value = q;
          tr.querySelector(".ap-chat-a").value = a;
          requestAnimationFrame(() => tr.querySelectorAll("textarea").forEach(grow));
          tr.querySelector(".ap-chat-del").addEventListener("click", () => tr.remove());
        } else {
          const th = document.createElement("th"); th.textContent = q;
          const td = document.createElement("td"); td.textContent = a;
          tr.append(th, td);
        }
        return tr;
      }
      function render(rows, canEdit) {
        editable = canEdit;
        const tbody = el("tbody");
        tbody.textContent = "";
        // cat を1つでも持つデータは分類見出しで区切る（値が変わるたびに新しい見出し）
        const hasCat = rows.some((r) => String(r.cat ?? "") !== "");
        let cur = null;
        rows.forEach((r) => {
          const cat = String(r.cat ?? "");
          if (hasCat && cat !== cur) { tbody.append(catRow(cat)); cur = cat; }
          tbody.append(qaRow(r.q ?? "", r.a ?? ""));
        });
        el("table").hidden = rows.length === 0 && !canEdit;
        el("empty").hidden = rows.length > 0 || canEdit;
        el("savebar").hidden = !canEdit;
        el("exportbar").hidden = rows.length === 0;
        requestAnimationFrame(growAll);
      }
      el("addrow")?.addEventListener("click", () => el("tbody").append(qaRow("", "")));
      /* 画面の表をそのまま書き出す（分類・設問・回答の3列）。編集中の未保存の内容も
         画面の値を読むのでそのまま出る。Excel は改行やタブを含むセルを "" で囲めば
         1セルとして受け取るため、TSV/CSV とも同じ引用規則で組み立てる。 */
      function tableRows() {
        const out = [];
        let cur = "";
        for (const tr of el("tbody").querySelectorAll("tr")) {
          if (tr.classList.contains("ap-chat-cat")) {
            cur = (tr.querySelector(".ap-chat-catname")?.value ?? tr.textContent ?? "").trim();
            continue;
          }
          const q = tr.querySelector(".ap-chat-q")?.value ?? tr.children[0]?.textContent ?? "";
          const a = tr.querySelector(".ap-chat-a")?.value ?? tr.children[1]?.textContent ?? "";
          out.push([cur, q.trim(), a.trim()]);
        }
        return out;
      }
      const quote = (v, sep) =>
        new RegExp(`[${sep === "\t" ? "\t" : ","}"\r\n]`).test(v) ? `"${v.replace(/"/g, '""')}"` : v;
      function toTable(sep) {
        const head = ["分類", "設問", "回答"];
        return [head, ...tableRows()]
          .map((r) => r.map((v) => quote(String(v), sep)).join(sep)).join("\r\n");
      }
      function flash(msg) {
        el("copied").textContent = msg;
        setTimeout(() => { el("copied").textContent = ""; }, 4000);
      }
      el("copy")?.addEventListener("click", async () => {
        const tsv = toTable("\t");
        try {
          await navigator.clipboard.writeText(tsv);
          flash(`コピーしました（${tableRows().length}行）。Excel に貼り付けてください`);
        } catch {
          // クリップボードが拒否された場合（権限・非HTTPS）は選択状態にして手動コピーへ
          const ta = document.createElement("textarea");
          ta.value = tsv; ta.style.position = "fixed"; ta.style.opacity = "0";
          document.body.append(ta); ta.select();
          const ok = document.execCommand("copy");
          ta.remove();
          flash(ok ? "コピーしました。Excel に貼り付けてください" : "コピーできませんでした（CSVをお使いください）");
        }
      });
      el("csv")?.addEventListener("click", () => {
        // Excel は BOM が無いと UTF-8 の日本語を文字化けさせる
        const blob = new Blob(["\uFEFF" + toTable(",")], { type: "text/csv;charset=utf-8" });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `${cfg.csv}-${urlProp()}.csv`;
        a.click();
        URL.revokeObjectURL(a.href);
        flash(`CSVを書き出しました（${tableRows().length}行）`);
      });
      el("addcat")?.addEventListener("click", () => {
        const tb = el("tbody");
        const head = catRow("");
        tb.append(head, qaRow("", ""));
        head.querySelector(".ap-chat-catname")?.focus();
      });
      el("save")?.addEventListener("click", async () => {
        const rows = [];
        let cur = "";
        for (const tr of el("tbody").querySelectorAll("tr")) {
          if (tr.classList.contains("ap-chat-cat")) {
            cur = (tr.querySelector(".ap-chat-catname")?.value ?? "").trim();
            continue;
          }
          const row = {
            q: tr.querySelector(".ap-chat-q")?.value ?? "",
            a: tr.querySelector(".ap-chat-a")?.value ?? "",
          };
          if (cur) row.cat = cur;
          rows.push(row);
        }
        el("saved").textContent = "保存しています…";
        const r = await api("POST", { prop: urlProp(), [cfg.field]: rows });
        el("saved").textContent = r.ok
          ? `保存しました（${r.saved}行）`
          : `保存に失敗しました（${r.error ?? "error"}）`;
      });
      return { render, growAll };
    }
    const chatEd = setupInfoEditor({ p: "ap-chat", field: "chatInfo", csv: "chatinfo" });
    // ビュー切替スクリプト（別ブロック）から呼べるようにする
    window.__yahGrowChat = () => chatEd.growAll();
    /* 客室: 寝室数に連動した BR-1..n の内訳（シングル/ダブルの2列・数値）。
       合計と bedroomLayout 文字列はここから自動生成し、隠しフィールド経由で保存する。 */
    function bedRows() { return [...document.querySelectorAll(".ap-bed-row")]; }
    function rowCounts(tr) {
      return {
        s: Number(tr.querySelector('[data-kind="s"]')?.value) || 0,
        d: Number(tr.querySelector('[data-kind="d"]')?.value) || 0,
      };
    }
    function recomputeBeds() {
      let sgl = 0, dbl = 0;
      const parts = [];
      bedRows().forEach((tr, i) => {
        const { s, d } = rowCounts(tr);
        sgl += s; dbl += d;
        const p = [];
        if (d > 0) p.push(`ダブル${d}`);
        if (s > 0) p.push(`シングル${s}`);
        if (p.length) parts.push(`BR${i + 1}: ${p.join("+")}`);
      });
      $("ap-bedroomLayout").value = parts.join(" / ");
      $("ap-bedDouble").value = String(dbl);
      $("ap-bedSingle").value = String(sgl);
      $("ap-bed-totals").textContent = `・ダブルベッド ${dbl}台\n・シングルベッド ${sgl}台`;
    }
    function parseRoom(text) {
      const g = (re) => { let n = 0; for (const m of text.matchAll(re)) n += m[1] ? Number(m[1]) : 1; return n; };
      return { s: g(/シングル\s*(\d*)/g), d: g(/ダブル\s*(\d*)/g) };
    }
    function renderBedRooms() {
      const anchor = $("ap-bed-anchor");
      if (!anchor) return;
      const rooms = Math.min(12, Math.max(1, Number(document.querySelector(`[data-prop="${PROP}"][data-field="bedrooms"]`)?.value) || 1));
      const existing = bedRows().map(rowCounts);
      const fromLayout = ($("ap-bedroomLayout").value || "").split("/").map((x) => parseRoom(x));
      document.querySelectorAll(".ap-bed-row, .ap-bed-head").forEach((tr) => tr.remove());
      const rows = [];
      for (let i = 1; i <= rooms; i++) {
        const v = existing[i - 1] ?? fromLayout[i - 1] ?? { s: 0, d: 0 };
        const tr = document.createElement("tr");
        tr.className = "ap-bed-row";
        tr.innerHTML = `<th class="ap-row-label ap-indent">BR-${i}</th>
          <td class="ap-bed-cells">
            <input type="number" min="0" max="9" step="1" data-kind="s" value="${v.s}">
            <input type="number" min="0" max="9" step="1" data-kind="d" value="${v.d}">
          </td>`;
        rows.push(tr);
      }
      const head = document.createElement("tr");
      head.className = "ap-bed-head";
      head.innerHTML = `<th class="ap-row-label"></th>
        <td class="ap-bed-cells"><span class="ap-bed-collabel">シングル</span><span class="ap-bed-collabel">ダブル</span></td>`;
      anchor.after(head, ...rows);
      bedRows().forEach((tr) => tr.querySelectorAll("input").forEach((el) => el.addEventListener("input", recomputeBeds)));
      recomputeBeds();
    }
    document.addEventListener("input", (e) => {
      const t = e.target;
      if (t?.dataset?.field === "bedrooms") renderBedRooms();
    });

    async function load() {
      $("ap-status").textContent = "読み込み中...";
      try {
        const j = await api("GET");
        if (!j.ok) throw new Error("load");
        if (HAS_FACTS) fill(PROP, j.items[PROP] ?? {});
        if (HAS_FACTS) renderBedRooms();
        if (HAS_FACTS) {
          const m = j.items.meta ?? {};
          ["operatorPhone","companyZip","companyAddressJa","companyAddressEn","companyStreetEn","companyLocalityEn","companyRegionEn","taxLow","taxHigh","taxHighThreshold"]
            .forEach((k) => { const el = $("ap-meta-" + k); if (el && m[k] !== undefined) el.value = m[k]; });
        }
        chatEd.render(j.items[urlProp()]?.chatInfo ?? [], j.canEdit === true);
        // 閲覧は全メンバー・編集は Owner のみ（2026-08-18 発注者判断）。
        // Owner 以外は入力を無効化し、保存バーを隠して読み取り専用にする
        if (!j.canEdit) {
          document.querySelectorAll("[data-prop][data-field]").forEach((el) => { el.disabled = true; });
          const bar = document.querySelector(".ap-save-bar"); if (bar) bar.hidden = true;
          const asof = $("ap-asof"); if (asof) asof.disabled = true;
        }
        $("ap-asof").value = j.items.meta?.ratingAsOf ?? "";
        $("ap-status").textContent = "";
      } catch (e) {
        $("ap-status").textContent = e.message === "unauthorized" ? "このアカウントには権限がありません。" : "読み込みに失敗しました。";
      }
    }

    async function saveAll(btnId, savedId) {
      const btn = $(btnId);
      btn.disabled = true;
      $(savedId).textContent = "保存しています…";
      const results = [];
      for (const prop of [PROP]) {
        const values = {};
        FIELD_KEYS.forEach((f) => {
          const el = document.querySelector(`[data-prop="${prop}"][data-field="${f}"]`);
          if (el) values[f] = el.value;
        });
        const r = await api("POST", { prop, values });
        results.push(r.ok ? null : `${prop}: ${r.error ?? "失敗"}`);
      }
      // 評価の取得日も一緒に保存（以前は別カード・別ボタンだった）
      const ar = await api("POST", { ratingAsOf: $("ap-asof").value });
      results.push(ar.ok ? null : "取得日: 失敗");
      const errs = results.filter(Boolean);
      $(savedId).textContent = errs.length
        ? `保存に失敗しました（${errs.join(" / ")}）`
        : "保存しました（サイトの表示に反映するには再ビルドが必要です）";
      btn.disabled = false;
    }
    $("ap-save-all").addEventListener("click", () => saveAll("ap-save-all", "ap-saved-all"));
    $("ap-save-all2")?.addEventListener("click", () => saveAll("ap-save-all2", "ap-saved-all2"));
    $("ap-save-all3")?.addEventListener("click", () => saveAll("ap-save-all3", "ap-saved-all3"));
    $("ap-save-meta")?.addEventListener("click", async () => {
      const btn = $("ap-save-meta"); btn.disabled = true;
      $("ap-saved-meta").textContent = "保存しています…";
      const meta = {};
      ["operatorPhone","companyZip","companyAddressJa","companyAddressEn","companyStreetEn","companyLocalityEn","companyRegionEn","taxLow","taxHigh","taxHighThreshold"]
        .forEach((k) => { meta[k] = $("ap-meta-" + k)?.value ?? ""; });
      const r = await api("POST", { meta });
      $("ap-saved-meta").textContent = r.ok ? "保存しました（サイト反映には再ビルドが必要です）" : `保存に失敗しました（${r.error ?? "error"}）`;
      btn.disabled = false;
    });



    $("ap-login-btn").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("ap-login-status").textContent = "ログインに失敗しました。"; }
    });
    /* 認証の確定を待ってから判断する。待たずに弾くと、復元が間に合わない一瞬の
       未ログイン状態でログイン画面へ飛ばされ、「ハードリロードしないと出ない」
       ように見える（2026-08-18 発注者報告）。ハッシュも保って戻す。 */
    await auth.authStateReady();
    onAuthStateChanged(auth, (user) => {
      if (!user) { location.replace(`/admin/?next=${encodeURIComponent(location.pathname + location.hash)}`); return; }
      $("ap-login").hidden = !!user;
      $("ap-app").hidden = !user;
      if (user) load();   // チャット用情報も Firestore から読むため、新施設でも load する
    });
  });
</script>

