---
/* /admin/secrets — セキュリティ鍵番号管理
   キーボックスの暗証番号は物理キーそのもの。物件ファクト（property_facts）は
   公開読み取りを許可しているため、ここだけは専用コレクション property_secrets に隔離し、
   adminSecrets（要ログイン）経由でのみ読み書きする。閲覧・変更はオーナーのみ（運営会社は不可）。
   既定は伏せ字。表示・変更は audit_logs に残る。noindex・sitemap除外。 */
import SiteLayout from "../../layouts/SiteLayout.astro";

const SECRETS_ENDPOINT = "https://asia-northeast1-yah-homes.cloudfunctions.net/adminSecrets";
const FB_CONFIG = {
  apiKey: "AIzaSyBgHbTL5caL-itDIFTlSZNMPeHNsSnwEDs",
  authDomain: "yah-homes.firebaseapp.com",
  projectId: "yah-homes",
  appId: "1:18500698213:web:8b4cf08b97d916c216068c",
};
const PROP_LABEL = { kiyokawa: "yah.homes kiyokawa", takasago: "yah.homes takasago" };
---

<SiteLayout
  lang="ja"
  path="/admin/secrets"
  title="セキュリティ鍵番号管理 | yah.homes"
  description="キーボックス暗証番号の管理"
  noindex={true}
  solidNav
>
  <section class="sc">
    <div class="sc-container">
      <p class="sc-eyebrow">Admin</p>
      <h1 class="sc-title">セキュリティ鍵番号管理</h1>
      <p class="sc-lead">
        各棟のキーボックス暗証番号です。<strong>この番号が、そのまま玄関の鍵です。</strong>
        定型メールの <code>{"{{keyboxCode}}"}</code> には、ここの値が入ります。
      </p>

      <div id="sc-login" class="sc-login">
        <p class="sc-note">オーナーのアカウントでログインしてください。この画面はオーナー専用です。</p>
        <button id="sc-login-btn" class="sc-btn">Googleでログイン</button>
        <p class="sc-status" id="sc-login-status"></p>
      </div>

      <div id="sc-app" hidden>
        <div class="sc-scroll">
          <table class="sc-table">
            <thead>
              <tr><th>棟</th><th>暗証番号</th><th>最終更新</th><th>メモ</th><th></th></tr>
            </thead>
            <tbody id="sc-rows"></tbody>
          </table>
        </div>
        <p class="sc-status" id="sc-status" role="status"></p>

        <div class="sc-warn">
          <p class="sc-warn-title">取り扱いについて</p>
          <ul>
            <li>この画面をスクリーンショットで共有しないでください。番号はテキストで送らず、口頭かこの画面で確認します。</li>
            <li>
              現在、<strong>両棟が同じ番号</strong>で、入室マニュアル（Google Sites）にも掲載されています。
              マニュアルのURLを知っていれば誰でも読める状態です。棟ごとに別の番号へ分け、定期的に変更することをおすすめします。
            </li>
            <li>変更すると、以後に送るチェックイン案内へ自動で反映されます。<strong>すでに滞在中・当日到着のお客様がいないか</strong>を必ず確認してから変更してください。</li>
            <li>この画面はオーナー専用です。運営会社は閲覧・変更できません。誰がいつ変更したかは記録に残ります（番号そのものは記録しません）。</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ SECRETS_ENDPOINT, FB_CONFIG, PROP_LABEL }}>
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    const auth = getAuth(initializeApp(FB_CONFIG));
    const $ = (id) => document.getElementById(id);
    const esc = (x) => String(x ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const fmt = (ms) => (ms ? new Date(ms).toLocaleString("ja-JP", { dateStyle: "medium", timeStyle: "short" }) : "—");

    async function api(method, body) {
      const token = await auth.currentUser.getIdToken();
      const res = await fetch(SECRETS_ENDPOINT, {
        method,
        headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 401 || res.status === 403) throw new Error("unauthorized");
      return res.json();
    }

    function render(items) {
      $("sc-rows").innerHTML = items.map((it) => `
        <tr>
          <td class="sc-prop">${esc(PROP_LABEL[it.prop] ?? it.prop)}</td>
          <td>
            <input type="password" class="sc-code" data-code="${esc(it.prop)}"
                   value="${esc(it.keyboxCode)}" inputmode="numeric" autocomplete="off"
                   pattern="\\d{4,8}" maxlength="8" />
            <button type="button" class="sc-eye" data-eye="${esc(it.prop)}">表示</button>
          </td>
          <td class="sc-dim">${fmt(it.updatedAt)}${it.updatedBy ? `<br /><span class="sc-by">${esc(it.updatedBy)}</span>` : ""}</td>
          <td class="sc-dim sc-memo">${esc(it.note)}</td>
          <td>
            <button type="button" class="sc-btn sc-save" data-save="${esc(it.prop)}">保存</button>
            <span class="sc-saved" data-saved="${esc(it.prop)}"></span>
          </td>
        </tr>`).join("");

      document.querySelectorAll("[data-eye]").forEach((btn) =>
        btn.addEventListener("click", () => {
          const el = document.querySelector(`[data-code="${btn.dataset.eye}"]`);
          const show = el.type === "password";
          el.type = show ? "text" : "password";
          btn.textContent = show ? "隠す" : "表示";
        })
      );

      document.querySelectorAll("[data-save]").forEach((btn) =>
        btn.addEventListener("click", async () => {
          const prop = btn.dataset.save;
          const keyboxCode = document.querySelector(`[data-code="${prop}"]`).value.trim();
          const out = document.querySelector(`[data-saved="${prop}"]`);
          if (!/^\d{4,8}$/.test(keyboxCode)) { out.textContent = "4〜8桁の数字で入力してください"; return; }
          if (!confirm(`${PROP_LABEL[prop]} の暗証番号を変更します。\n滞在中・本日到着のお客様がいないか確認しましたか？`)) return;
          btn.disabled = true;
          const r = await api("POST", { prop, keyboxCode });
          out.textContent = r.ok ? (r.changed ? "変更しました" : "変更はありません") : `保存に失敗しました（${r.error ?? ""}）`;
          btn.disabled = false;
          if (r.ok && r.changed) load();
        })
      );
    }

    async function load() {
      $("sc-status").textContent = "読み込み中...";
      try {
        const j = await api("GET");
        if (!j.ok) throw new Error("load");
        render(j.items || []);
        $("sc-status").textContent = "";
      } catch (e) {
        $("sc-status").textContent =
          e.message === "unauthorized" ? "この画面はオーナー専用です。このアカウントでは閲覧できません。" : "読み込みに失敗しました。";
      }
    }

    $("sc-login-btn").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("sc-login-status").textContent = "ログインに失敗しました。"; }
    });

    onAuthStateChanged(auth, (user) => {
      $("sc-login").hidden = !!user;
      $("sc-app").hidden = !user;
      if (user) load();
    });
  });
</script>

<style>
  .sc { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .sc-container { max-width: 880px; margin: 0 auto; }
  .sc-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #aaaaaa; margin-bottom: 1rem; }
  .sc-title { font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 500; color: #111111; margin-bottom: 0.75rem; }
  .sc-lead { font-size: 0.85rem; color: #555555; line-height: 1.9; margin-bottom: 2.5rem; }
  .sc-lead code { font-size: 0.8rem; color: #111111; }

  .sc-login { border: 1px solid #e8e8e8; border-radius: 6px; padding: 1.75rem; text-align: center; }
  .sc-note { font-size: 0.8rem; color: #666666; margin-bottom: 1rem; }
  .sc-btn {
    font-family: inherit; font-size: 0.8rem; color: #ffffff; background: #111111;
    border: none; border-radius: 4px; padding: 0.6rem 1.4rem; cursor: pointer;
  }
  .sc-btn:disabled { opacity: 0.5; cursor: default; }

  .sc-scroll { overflow-x: auto; border: 1px solid #e8e8e8; border-radius: 6px; }
  .sc-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; }
  .sc-table th, .sc-table td { text-align: left; padding: 0.9rem 1rem; border-bottom: 1px solid #ededed; vertical-align: top; }
  .sc-table thead th { font-weight: 500; color: #888888; font-size: 0.72rem; white-space: nowrap; }
  .sc-table tbody tr:last-child td { border-bottom: none; }
  .sc-table :global(.sc-prop) { font-weight: 500; color: #111111; white-space: nowrap; }
  .sc-table :global(.sc-dim) { color: #888888; font-size: 0.74rem; line-height: 1.7; }
  .sc-table :global(.sc-by) { color: #aaaaaa; }
  .sc-table :global(.sc-memo) { max-width: 22em; }
  .sc-table :global(.sc-code) {
    width: 7.5em; padding: 0.5rem 0.7rem; font-family: inherit; font-size: 0.95rem;
    letter-spacing: 0.22em; color: #111111; border: 1px solid #d7d7d7; border-radius: 4px;
  }
  .sc-table :global(.sc-eye) {
    margin-left: 0.5rem; font-family: inherit; font-size: 0.72rem; color: #666666;
    background: none; border: 1px solid #d7d7d7; border-radius: 4px; padding: 0.35rem 0.6rem; cursor: pointer;
  }
  .sc-table :global(.sc-saved) { display: block; margin-top: 0.4rem; font-size: 0.72rem; color: #666666; }

  .sc-status { margin-top: 1rem; font-size: 0.78rem; color: #888888; }
  .sc-warn { margin-top: 2rem; border-left: 2px solid #b42318; padding: 0.25rem 0 0.25rem 1.1rem; }
  .sc-warn-title { font-size: 0.78rem; font-weight: 500; color: #b42318; margin-bottom: 0.6rem; }
  .sc-warn ul { list-style: none; }
  .sc-warn li { font-size: 0.78rem; color: #555555; line-height: 1.9; margin-bottom: 0.55rem; padding-left: 0.9rem; position: relative; }
  .sc-warn li::before { content: "—"; position: absolute; left: 0; color: #cccccc; }
</style>
