---
/* 管理者台帳 — administrators / Airstarメンバーの登録・更新・通知宛先の管理
   認証: Firebase Auth（Google）。閲覧=台帳メンバー・編集=rootオーナーのみ（Function側で検証）。
   通知フラグ: パートナー申請 / 定点観測 / 直販予約（該当メールの宛先に追加される） */
import SiteLayout from "../../layouts/SiteLayout.astro";
import { ENDPOINTS } from "../../lib/adminConfig";
import { FB_CONFIG } from "../../lib/adminConfig";

const USERS_ENDPOINT = ENDPOINTS.adminUsers;
---

<SiteLayout adminNav
  lang="ja"
  path="/admin/users"
  title="管理者台帳 | yah.homes"
  description="管理者・通知宛先の管理"
  noindex={true}
  solidNav
>
  <section class="au">
    <div class="au-container">
      <a class="au-eyebrow" href="/admin/menu/">Admin</a>
      <h1 class="au-title">管理者台帳</h1>
      <p class="au-note">管理画面へアクセスできるメンバーと、各通知メールの宛先を管理します。Owner はすべてのメンバーを、Admin は Operator のみを追加・編集できます。</p>

      <div id="au-login" class="au-login" hidden>
        <button id="au-login-btn" class="au-btn">Googleでログイン</button>
        <p class="au-status" id="au-login-status"></p>
      </div>

      <div id="au-app" hidden>
        <div class="au-tablewrap">
          <table class="au-table">
            <thead>
              <tr><th>役割</th><th>名前</th><th>メール</th><th>パートナー申請</th><th>定点観測</th><th>予約・メッセージ</th><th></th></tr>
            </thead>
            <tbody id="au-tbody"></tbody>
          </table>
        </div>

        <div id="au-editor" hidden>
          <h2 class="au-h2">メンバーを追加・更新</h2>
          <form id="au-form" class="au-form">
            <div class="au-row">
              <select id="af-role">
                <option value="operator">Operator（閲覧・お客様対応）</option>
                <option value="admin">Admin（管理操作すべて・台帳を除く）</option>
                <option value="owner">Owner（台帳の管理まで）</option>
              </select>
              <input id="af-name" type="text" placeholder="名前（例: Airstar 原田様）" maxlength="100" />
              <input id="af-email" type="email" placeholder="メールアドレス（Googleアカウント）" required />
            </div>
            <div class="au-row au-checks">
              <label><input type="checkbox" id="af-partners" /> パートナー申請 の通知を受け取る</label>
              <label><input type="checkbox" id="af-teiten" /> 定点観測 の通知を受け取る</label>
              <label><input type="checkbox" id="af-bookings" /> 予約・メッセージ の通知を受け取る</label>
            </div>
            <button type="submit" class="au-btn" id="af-submit">保存</button>
          </form>
        </div>
        <p class="au-status" id="au-app-status" role="status"></p>
      </div>
    </div>
  </section>
</SiteLayout>

<script define:vars={{ USERS_ENDPOINT, FB_CONFIG }}>
  import("https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js").then(async ({ initializeApp }) => {
    const { getAuth, GoogleAuthProvider, signInWithPopup, onAuthStateChanged } = await import(
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js"
    );
    const auth = getAuth(initializeApp(FB_CONFIG));
    const $ = (id) => document.getElementById(id);
    const esc = (x) => String(x ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    async function api(method, body) {
      const token = await auth.currentUser.getIdToken();
      const res = await fetch(USERS_ENDPOINT, {
        method,
        headers: { Authorization: `Bearer ${token}`, ...(body ? { "Content-Type": "application/json" } : {}) },
        body: body ? JSON.stringify(body) : undefined,
      });
      if (res.status === 401) throw new Error("unauthorized");
      return res.json();
    }

    const check = (v) => (v ? "✓" : "—");

    async function load() {
      $("au-app-status").textContent = "読み込み中...";
      try {
        const j = await api("GET");
        if (!j.ok) throw new Error("load");
        // 表示順: Owner → Admin → Operator（同ロール内はメール順）
        const RANK = { owner: 0, admin: 1, operator: 2 };
        j.items.sort((a, b) => (RANK[a.role] - RANK[b.role]) || a.email.localeCompare(b.email));
        const actor = j.actorRole ?? (j.isRoot ? "owner" : "operator");
        const canEdit = (it) => actor === "owner" ? !it.isRootUser : (actor === "admin" && it.role === "operator");
        $("au-editor").hidden = !(actor === "owner" || actor === "admin");
        // Admin は Operator しか作れない（サーバでも強制。ここは見た目の整合）
        if (actor === "admin") {
          $("af-role").querySelectorAll("option").forEach((o) => { if (o.value !== "operator") o.remove(); });
        }
        const ROLE_LABEL = { owner: "Owner", admin: "Admin", operator: "Operator" };
        const rows = j.items.map(
          (it) => `<tr>
            <td><span class="au-role au-role-${esc(it.role)}">${ROLE_LABEL[it.role] ?? esc(it.role)}</span></td>
            <td>${esc(it.name || "-")}</td>
            <td>${esc(it.email)}</td>
            <td>${check(it.notifyPartners)}</td><td>${check(it.notifyTeiten)}</td><td>${check(it.notifyBookings)}</td>
            <td>${canEdit(it) ? `<button class="au-btn-sub au-edit" data-e="${esc(it.email)}">編集</button> <button class="au-btn-sub au-del" data-e="${esc(it.email)}">削除</button>` : ""}</td>
          </tr>`
        );
        $("au-tbody").innerHTML = rows.join("");
        $("au-app-status").textContent = "";

        document.querySelectorAll(".au-edit").forEach((b) =>
          b.addEventListener("click", () => {
            const it = j.items.find((x) => x.email === b.dataset.e);
            $("af-email").value = it.email;
            $("af-name").value = it.name || "";
            $("af-role").value = it.role;
            $("af-partners").checked = !!it.notifyPartners;
            $("af-teiten").checked = !!it.notifyTeiten;
            $("af-bookings").checked = !!it.notifyBookings;
            $("af-email").scrollIntoView({ behavior: "smooth", block: "center" });
          })
        );
        document.querySelectorAll(".au-del").forEach((b) =>
          b.addEventListener("click", async () => {
            if (!confirm(`${b.dataset.e} を台帳から削除します。管理画面へのアクセスと通知が止まります。`)) return;
            const r = await api("POST", { action: "delete", email: b.dataset.e });
            $("au-app-status").textContent = r.ok ? "削除しました" : "削除に失敗しました";
            load();
          })
        );
      } catch (e) {
        $("au-app-status").textContent = e.message === "unauthorized" ? "このアカウントには権限がありません。" : "読み込みに失敗しました。";
      }
    }

    $("au-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      $("af-submit").disabled = true;
      $("au-app-status").textContent = "保存中...";
      try {
        const r = await api("POST", {
          action: "upsert",
          email: $("af-email").value,
          name: $("af-name").value,
          role: $("af-role").value,
          notifyPartners: $("af-partners").checked,
          notifyTeiten: $("af-teiten").checked,
          notifyBookings: $("af-bookings").checked,
        });
        $("au-app-status").textContent = r.ok ? "保存しました" : `保存に失敗しました（${r.error || ""}）`;
        if (r.ok) { $("au-form").reset(); load(); }
      } catch {
        $("au-app-status").textContent = "保存に失敗しました";
      } finally {
        $("af-submit").disabled = false;
      }
    });

    $("au-login-btn").addEventListener("click", async () => {
      try { await signInWithPopup(auth, new GoogleAuthProvider()); }
      catch { $("au-login-status").textContent = "ログインに失敗しました。"; }
    });
    /* 認証の確定を待ってから判断する。待たずに弾くと、復元が間に合わない一瞬の
       未ログイン状態でログイン画面へ飛ばされ、「ハードリロードしないと出ない」
       ように見える（2026-08-18 発注者報告）。ハッシュも保って戻す。 */
    await auth.authStateReady();
    onAuthStateChanged(auth, (user) => {
      if (!user) { location.replace(`/admin/?next=${encodeURIComponent(location.pathname + location.hash)}`); return; }
      $("au-login").hidden = !!user;
      $("au-app").hidden = !user;
      if (user) load();
    });
  });
</script>

<style>
  .au { background: #ffffff; padding: 7rem 1.5rem 5rem; min-height: 70vh; }
  .au-container { max-width: 900px; margin: 0 auto; }
  .au-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #666666; margin-bottom: 1rem; }
  .au-title { font-size: clamp(1.4rem, 3.5vw, 2rem); font-weight: 500; color: #111111; margin-bottom: 0.75rem; }
  .au-h2 { font-size: 1.05rem; font-weight: 500; color: #111111; margin: 2.5rem 0 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid #eeeeee; }
  .au-note { font-size: 0.8rem; color: #666666; margin-bottom: 1.5rem; }
  .au-status { font-size: 0.8rem; color: #333333; min-height: 1.4em; margin-top: 0.75rem; }
  .au-login { border: 1px solid #eeeeee; border-radius: 4px; padding: 2rem; max-width: 420px; }
  .au-btn { padding: 0.7rem 1.6rem; background: #111111; color: #ffffff; font-size: 0.875rem; font-weight: 500; border: none; border-radius: 4px; cursor: pointer; }
  .au-btn:disabled { opacity: 0.5; }
  .au-btn-sub { padding: 0.35rem 0.7rem; background: #ffffff; color: #111111; font-size: 0.72rem; border: 1px solid #d7d7d7; border-radius: 4px; cursor: pointer; }
  .au-tablewrap { overflow-x: auto; }
  .au-table { width: 100%; border-collapse: collapse; font-size: 0.8rem; line-height: 1.6; }
  .au-table :global(th), .au-table :global(td) {
    border: 1px solid #e5e5e5; padding: 0.72rem 0.9rem; text-align: left;
    color: #222222; white-space: nowrap; line-height: 1.6;
  }
  :global(.au-role) { font-size: 0.7rem; border: 1px solid #d7d7d7; border-radius: 999px; padding: 0.15rem 0.6rem; color: #666666; }
  :global(.au-role-owner) { color: #ffffff; background: #111111; border-color: #111111; }
  :global(.au-role-admin) { color: #111111; background: #e8e8e8; border-color: #e8e8e8; }
  .au-table thead th { background: #fafafa; font-weight: 500; }
  .au-form { display: flex; flex-direction: column; gap: 0.75rem; }
  .au-row { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .au-row input[type="email"], .au-row input[type="text"], .au-row select {
    padding: 0.55rem 0.7rem; font-size: 0.85rem; border: 1px solid #d7d7d7; border-radius: 4px; font-family: inherit; flex: 1; min-width: 200px;
  }
  .au-checks { flex-direction: column; gap: 0.4rem; }
  .au-checks label { font-size: 0.82rem; color: #333333; display: flex; align-items: center; gap: 0.4rem; }
  .au-btn { align-self: flex-start; }
  a.au-eyebrow { display: block; text-decoration: none; }
</style>
