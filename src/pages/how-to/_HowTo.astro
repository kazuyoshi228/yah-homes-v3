---
/* 入室案内（共通部品）— Google Sites から移設
   noindex・robots除外・sitemap除外。到着前〜到着直後にスマホで開く前提。

   ・順番は「探す→着く→入る→停める」。住所と地図を最初に置くのは、
     このページを開く時点ではまだ現地にいないため。
   ・5言語（ja/en/ko/zh/th）。併記ではなく1言語だけを表示する。
     到着直後に読むので、視線が2言語に割れると番号を探すのが遅くなる。
   ・暗証番号は静的HTMLに含めず checkinInfo API から実行時に取得する
     （/admin/secrets で変えたら再デプロイなしで反映される）。 */
import SiteLayout from "../../layouts/SiteLayout.astro";
import { howtoUI } from "../../i18n/pageStrings";

type Lang = "ja" | "en" | "ko" | "zh" | "th";
type T = Record<Lang, string>;

interface Props {
  prop: "kiyokawa" | "takasago";
  name: string;
  zip: string;
  addressJa: string;
  /** 「地図を開く」の行き先。指定がなければ住所検索にする（施設のGoogleマップに揃えるため） */
  mapUrlOverride?: string;
  addressEn: string;
  photoEntrance: string;
  photoKeybox: string;
  photoParking?: string;
  /** 鍵の位置（5言語） */
  keyPlace: T;
  /** 駐車場の説明（5言語） */
  parking: T;
  /** 玄関を示す赤丸。x/y/r はいずれも写真の「幅」に対する%（y も幅基準なので真円になる）。
      aspect は写真の 高さ÷幅。写真に描き込まず重ねるのは、写真を差し替えても位置だけ直せるため。 */
  entranceMark?: { x: number; y: number; r: number; aspect: number };
  /** 車庫の寸法（W×D, mm）。分かっている棟のみ */
  garageSize?: { w: number; d: number };
  /** 大型車が停められる棟のみ true */
  parkingLargeCar?: boolean;
}
const {
  prop, name, zip, addressJa, addressEn, mapUrlOverride,
  photoEntrance, photoKeybox, photoParking,
  keyPlace, parking, entranceMark, garageSize, parkingLargeCar,
} = Astro.props;

const LANGS: { code: Lang; label: string }[] = [
  { code: "ja", label: "日本語" },
  { code: "en", label: "English" },
  { code: "ko", label: "한국어" },
  { code: "zh", label: "繁體中文" },
  { code: "th", label: "ไทย" },
];

/* 画面の固定文言。棟によらず共通。 */
const UI = howtoUI;

const mapUrl = mapUrlOverride ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressJa)}`;
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(addressJa)}&z=17&output=embed`;
const garage = garageSize
  ? { ja: `幅 ${garageSize.w.toLocaleString()}mm × 奥行 ${garageSize.d.toLocaleString()}mm`,
      en: `W ${garageSize.w.toLocaleString()}mm × D ${garageSize.d.toLocaleString()}mm` }
  : null;
---

<SiteLayout
  lang="en"
  path={`/how-to/${prop}`}
  title={`Check-in Guide — ${name} | yah.homes`}
  description="How to check in and get to the house"
  noindex={true}
  solidNav
>
  <section class="ht">
    <div class="ht-container">
      <nav class="ht-langs" aria-label="Language">
        {LANGS.map((l) => (
          <button type="button" class="ht-lang" data-lang={l.code}>{l.label}</button>
        ))}
      </nav>

      <p class="ht-eyebrow" data-t="eyebrow"></p>
      <h1 class="ht-title">{name}</h1>
      <p class="ht-sub" data-t="sub"></p>

      <!-- 01 住所と地図 — 開く時点ではまだ現地にいないため最初に置く -->
      <section class="ht-block">
        <p class="ht-step">01</p>
        <h2 class="ht-h2"><span data-t="s1"></span><span class="ht-h2sub" data-t="s1sub"></span></h2>
        <p class="ht-text">
          〒{zip} {addressJa}<br />
          <span class="ht-addr-en">{addressEn}</span>
        </p>
        <div class="ht-map">
          <iframe src={mapEmbed} title={`${name} map`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        <a class="ht-btn" href={mapUrl} target="_blank" rel="noopener" data-t="mapBtn"></a>
      </section>

      <!-- 02 玄関 -->
      <section class="ht-block">
        <p class="ht-step">02</p>
        <h2 class="ht-h2"><span data-t="s2"></span><span class="ht-h2sub" data-t="s2sub"></span></h2>
        <figure class="ht-fig">
          <div class="ht-marked">
            <img class="ht-photo" src={photoEntrance} alt="" loading="eager" />
            {entranceMark && (
              <svg class="ht-mark" viewBox={`0 0 100 ${100 * entranceMark.aspect}`} aria-hidden="true">
                <circle cx={entranceMark.x} cy={entranceMark.y} r={entranceMark.r} fill="none" stroke="#ff1a1a" stroke-width="1.5" />
              </svg>
            )}
          </div>
          <figcaption data-t="entranceCaption"></figcaption>
        </figure>
      </section>

      <!-- 03 鍵 -->
      <section class="ht-block">
        <p class="ht-step">03</p>
        <h2 class="ht-h2"><span data-t="s3"></span><span class="ht-h2sub" data-t="s3sub"></span></h2>
        <figure class="ht-fig">
          <img class="ht-photo" src={photoKeybox} alt="" loading="lazy" />
          <figcaption data-p="keyPlace"></figcaption>
        </figure>
        <div class="ht-code">
          <p class="ht-code-label" data-t="pin"></p>
          <p class="ht-code-note" data-t="pinNote"></p>
        </div>
        <p class="ht-text" data-t="keyAfter"></p>
      </section>

      <!-- 04 駐車場 -->
      <section class="ht-block">
        <p class="ht-step">04</p>
        <h2 class="ht-h2"><span data-t="s4"></span><span class="ht-h2sub" data-t="s4sub"></span></h2>
        {photoParking && <img class="ht-photo ht-photo-solo" src={photoParking} alt="" loading="lazy" />}
        <p class="ht-text" data-p="parking"></p>
        {parkingLargeCar && (
          <div class="ht-spec">
            <p class="ht-spec-title" data-t="largeTitle"></p>
            <p class="ht-spec-note" data-t="largeBody"></p>
          </div>
        )}
        {garage && (
          <div class="ht-spec">
            <p class="ht-spec-title" data-t="garageTitle"></p>
            <p class="ht-spec-val" id="ht-garage"></p>
            <p class="ht-spec-note" data-t="garageNote"></p>
          </div>
        )}
      </section>

      <section class="ht-block ht-help">
        <h2 class="ht-h2"><span data-t="helpTitle"></span></h2>
        <p class="ht-text" data-t="helpBody"></p>
        <p class="ht-call"><span data-t="helpCall"></span>：<a href="tel:+815017214419">050-1721-4419</a></p>
      </section>

      <!-- Support Chat（施設別・2026-08-18 発注者指示で独立セクション化）。
           QRは幹事の画面から同行者がスキャンする使い方を想定 -->
      <section class="ht-block">
        <h2 class="ht-h2">Support Chat</h2>
        <p class="ht-text" data-t="chatLead"></p>
        <div class="ht-chat">
          <img class="ht-chat-qr" src={`/qr/chat-${prop}.png`} alt="QR" width="120" height="120" loading="lazy" />
          <a class="ht-chat-btn" href={`https://chat.yah.homes/${prop}`} target="_blank" rel="noopener" data-t="helpChat"></a>
        </div>
      </section>

    </div>
  </section>
</SiteLayout>

<script define:vars={{ prop, UI, keyPlace, parking, garage }}>
  (() => {
    const PROPTEXT = { keyPlace, parking };
    const LANGS = Object.keys(UI);
    const pick = () => {
      // 既定は英語（2026-08-17 発注者指示）。お客様の多数派が訪日客のため。
      // 一度選んだ言語は端末に保存され、次回以降はそれを優先する。
      const saved = localStorage.getItem("yh-howto-lang");
      if (LANGS.includes(saved)) return saved;
      return "en";
    };

    function apply(lang) {
      const t = UI[lang];
      document.documentElement.lang = lang;
      document.querySelectorAll("[data-t]").forEach((el) => { el.textContent = t[el.dataset.t] ?? ""; });
      document.querySelectorAll("[data-p]").forEach((el) => { el.textContent = PROPTEXT[el.dataset.p]?.[lang] ?? ""; });
      document.querySelectorAll("[data-lang]").forEach((b) => {
        b.classList.toggle("is-active", b.dataset.lang === lang);
        b.setAttribute("aria-current", b.dataset.lang === lang ? "true" : "false");
      });
      // 車庫の寸法は日本語だけ「幅×奥行」、他言語は W×D で1行だけ出す
      const g = document.getElementById("ht-garage");
      if (g && garage) g.textContent = lang === "ja" ? garage.ja : garage.en;
      localStorage.setItem("yh-howto-lang", lang);
    }

    let lang = pick();
    apply(lang);
    document.querySelectorAll("[data-lang]").forEach((b) =>
      b.addEventListener("click", () => { lang = b.dataset.lang; apply(lang); })
    );


  })();
</script>

<style>
  .ht { background: #ffffff; padding: 7rem 1.5rem 5rem; }
  .ht-container { max-width: 620px; margin: 0 auto; }

  .ht-langs { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 2rem; }
  .ht-lang {
    font-family: inherit; font-size: 0.74rem; color: #777777; background: none;
    border: 1px solid #e2e2e2; border-radius: 999px; padding: 0.35rem 0.8rem; cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  .ht-lang:hover { color: #111111; border-color: #bbbbbb; }
  .ht-lang.is-active { color: #ffffff; background: #111111; border-color: #111111; }

  .ht-eyebrow { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: #666666; margin-bottom: 0.9rem; }
  .ht-title { font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 500; color: #111111; margin-bottom: 0.4rem; }
  .ht-sub { font-size: 0.82rem; color: #666666; margin-bottom: 3rem; }

  .ht-block { padding-top: 2.5rem; margin-top: 2.5rem; border-top: 1px solid #ededed; }
  .ht-block:first-of-type { padding-top: 0; margin-top: 0; border-top: none; }
  .ht-step { font-size: 0.68rem; font-weight: 500; letter-spacing: 0.08em; color: #bbbbbb; font-variant-numeric: tabular-nums; margin-bottom: 0.5rem; }
  .ht-h2 { font-size: 1.1rem; font-weight: 500; color: #111111; margin-bottom: 1rem; }
  .ht-h2sub { display: block; margin-top: 0.15rem; font-size: 0.72rem; font-weight: 400; color: #666666; }
  .ht-text { font-size: 0.88rem; color: #444444; line-height: 1.95; margin-bottom: 1.25rem; }
  /* ローマ字表記の住所だけは常に併記する。タクシーや配車アプリで使うため。 */
  .ht-addr-en { color: #666666; font-size: 0.82rem; }

  .ht-fig { margin-bottom: 1.5rem; }
  .ht-fig figcaption { margin-top: 0.7rem; font-size: 0.85rem; color: #444444; line-height: 1.9; }
  .ht-marked { position: relative; line-height: 0; }
  .ht-mark { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ht-photo { width: 100%; height: auto; border-radius: 6px; display: block; background: #f4f4f4; }
  .ht-photo-solo { margin-bottom: 1.25rem; }

  /* 暗証番号 — 到着直後にスマホで一目で読める大きさに */
  .ht-code { background: #111111; border-radius: 8px; padding: 1.5rem; text-align: center; margin-bottom: 1.5rem; }
  .ht-code-label { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255, 255, 255, 0.55); margin-bottom: 0.6rem; }
  .ht-code-val { font-size: 2.6rem; font-weight: 500; letter-spacing: 0.3em; color: #ffffff; font-variant-numeric: tabular-nums; text-indent: 0.3em; }
  .ht-code-note { margin-top: 0.6rem; font-size: 0.72rem; color: rgba(255, 255, 255, 0.6); line-height: 1.7; }
  .ht-code-note:empty { display: none; }

  .ht-map { position: relative; width: 100%; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; margin-bottom: 1.25rem; }
  .ht-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ht-btn {
    display: inline-block; font-size: 0.8rem; color: #111111; text-decoration: none;
    border: 1px solid #d7d7d7; border-radius: 4px; padding: 0.65rem 1.2rem;
  }
  .ht-btn:hover { border-color: #111111; }

  .ht-spec { border: 1px solid #e2e2e2; border-radius: 6px; padding: 1.1rem 1.25rem; margin-bottom: 1rem; }
  .ht-spec:last-child { margin-bottom: 0; }
  .ht-spec-title { font-size: 0.72rem; font-weight: 500; letter-spacing: 0.1em; color: #666666; margin-bottom: 0.6rem; }
  .ht-spec-val { font-size: 1.05rem; font-weight: 500; color: #111111; font-variant-numeric: tabular-nums; }
  .ht-spec-note { margin-top: 0.8rem; font-size: 0.8rem; color: #666666; line-height: 1.9; }
  .ht-spec-title + .ht-spec-note { margin-top: 0; }
  .ht-help .ht-text { margin-bottom: 0.6rem; }
  .ht-call { font-size: 1rem; color: #111111; margin: 0; }
  .ht-call a { font-weight: 600; color: #111111; text-decoration: none; border-bottom: 1px solid #111111; }

  @media (max-width: 640px) {
    .ht { padding: 5.5rem 1.25rem 4rem; }
    .ht-code-val { font-size: 2.2rem; }
  }
  .ht-chat { margin-top: 1.2rem; display: flex; flex-direction: column; align-items: flex-start; gap: 1.4rem; }
  .ht-chat-btn {
    display: inline-block; padding: 0.75rem 1.8rem; background: #1a56db; color: #ffffff;
    border: none; border-radius: 999px; font-weight: 600; font-size: 0.9rem; text-decoration: none;
  }
  .ht-chat-btn:hover { background: #1544b0; color: #ffffff; }
  .ht-chat-qr { border: 1px solid #e8e8e8; border-radius: 6px; }
</style>
